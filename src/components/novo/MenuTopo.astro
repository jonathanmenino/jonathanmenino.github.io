---
// Barra do topo: rótulo à esquerda e menu numerado à direita, com a bandeirinha de idioma no fim.
// itens: [texto, endereço, ativo?].
import TrocaIdioma from '../TrocaIdioma.astro';
import { idioma, tradutor } from '../../i18n';
const T = tradutor(idioma(Astro.url));
interface Props { itens: [string, string, boolean?][]; sub?: string }
const { itens, sub = T('Índice · Portfólio / 2026', 'Index · Portfolio / 2026') } = Astro.props;
---
<div class="topo">
  <div><p class="tt">{T('Design / Vídeo / Web / IA', 'Design / Video / Web / AI')}</p><p class="mono sub">{sub}</p></div>
  <nav aria-label={T('Páginas e seções', 'Pages and sections')}><ul class="menu">
    {itens.map(([nome, href, ativo], i) => <li><a href={href} class:list={{ ativo }} aria-current={ativo ? 'page' : undefined}><small>0{i + 1}</small>{nome}</a></li>)}
    <li class="menu-idioma"><TrocaIdioma /></li>
  </ul></nav>
</div>
