---
// Moldura de navegador (desktop) ou de celular em volta de um print.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Pendente from './Pendente.astro';

interface Props { imagem?: ImageMetadata; alt: string; tipo: 'desktop' | 'celular'; dominio?: string; eager?: boolean }
const { imagem, alt, tipo, dominio = '', eager = false } = Astro.props;
const larguras = tipo === 'celular' ? [260, 520] : [800, 1280];
---
{tipo === 'celular' ? (
  <div class="relative mx-auto w-full max-w-[260px] rounded-[2.2rem] border border-white/10 bg-[#0e0d10] p-2 shadow-[0_40px_80px_-30px_rgba(0,0,0,.8)]">
    <div class="absolute left-1/2 top-3.5 z-10 h-4 w-20 -translate-x-1/2 rounded-full bg-[#0e0d10]"></div>
    <div class="aspect-[9/19] overflow-hidden rounded-[1.75rem] bg-graphite">
      {imagem
        ? <Image src={imagem} alt={alt} widths={larguras} sizes="260px" loading={eager ? 'eager' : 'lazy'} class="block h-full w-full object-cover object-top" />
        : <div class="grid h-full w-full place-items-center p-6 text-center"><Pendente texto="Print mobile" /></div>}
    </div>
  </div>
) : (
  <div class="overflow-hidden rounded-2xl border border-white/10 bg-[#0e0d10] shadow-[0_50px_100px_-40px_rgba(0,0,0,.85)]">
    <div class="flex h-9 items-center gap-1.5 border-b border-white/[.06] px-4">
      <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span><span class="h-2.5 w-2.5 rounded-full bg-white/15"></span><span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
      <span class="ml-3 hidden truncate rounded-md bg-white/[.06] px-3 py-1 font-mono text-[10px] text-white/60 sm:block">{dominio}</span>
    </div>
    <div class="aspect-[16/10] overflow-hidden bg-graphite">
      {imagem
        ? <Image src={imagem} alt={alt} widths={larguras} sizes="(min-width: 1024px) 900px, 100vw" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} class="block h-full w-full object-cover object-top" />
        : <div class="grid h-full w-full place-items-center p-6 text-center"><Pendente texto="Print desktop" /></div>}
    </div>
  </div>
)}
