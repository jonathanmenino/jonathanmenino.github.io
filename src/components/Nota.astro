---
// Anel de nota do PageSpeed (0 a 100). O arco se desenha quando entra na tela.
interface Props { valor: number; rotulo: string; grande?: boolean }
const { valor, rotulo, grande = false } = Astro.props;
---
<div class="flex flex-col items-center text-center">
  <div class:list={['relative grid place-items-center', grande ? 'h-36 w-36 md:h-44 md:w-44' : 'h-[4.5rem] w-[4.5rem] md:h-20 md:w-20']}>
    <svg class="absolute inset-0 h-full w-full -rotate-90" viewBox="0 0 120 120" aria-hidden="true">
      <circle cx="60" cy="60" r="52" fill="none" class="stroke-line/[.08]" stroke-width={grande ? 8 : 10} />
      <circle cx="60" cy="60" r="52" fill="none" class="nota-arco stroke-hl" stroke-width={grande ? 8 : 10} stroke-linecap="round" pathLength="100" stroke-dasharray={`${valor} 100`} style={`--nota:${valor}`} />
    </svg>
    <span class:list={['font-mono font-semibold tracking-tight text-fg', grande ? 'text-5xl md:text-6xl' : 'text-lg md:text-xl']}>{valor}</span>
  </div>
  <span class:list={['mt-3 leading-tight', grande ? 'text-lg font-semibold' : 'text-xs text-muted']}>{rotulo}</span>
</div>
