---
/* Faixa "Do blog" com os artigos mais recentes, para levar visitantes de outras páginas ao blog.
   publico: mostra só artigos para esse público (e os "para todos"). tom: 'claro' ou 'escuro'.
   Só aparece em português (o blog não tem versão em inglês) e quando existe pelo menos um artigo. */
import { Image } from 'astro:assets';
import { url } from '../../data/site';
import { artigos, dataCurta, tempoLeitura, PUBLICOS } from '../../data/blog';
import { idioma } from '../../i18n';

interface Props { publico?: 'agencias' | 'empresas'; tom?: 'claro' | 'escuro'; titulo?: string; max?: number; class?: string }
const { publico, tom = 'claro', titulo = 'Do blog', max = 3, class: cls = '' } = Astro.props;
const L = idioma(Astro.url);
const posts = L === 'pt' ? (await artigos()).filter((p) => !publico || p.data.publico === publico || p.data.publico === 'todos').slice(0, max) : [];
---
{posts.length > 0 && (
  <section class:list={['cb', cls]} data-tom={tom} aria-labelledby="cb-titulo">
    <div class="cb-cab">
      <div>
        <p class="cb-rotulo">Blog</p>
        <h2 id="cb-titulo">{titulo}</h2>
      </div>
      <a class="cb-todos" href={url('blog/')}>Ver todos os artigos <span aria-hidden="true">→</span></a>
    </div>
    <ul class="cb-lista">
      {posts.map((p) => (
        <li>
          <article class="cb-card">
            {p.data.capa && <Image src={p.data.capa} alt="" widths={[400, 640]} sizes="(min-width: 900px) 360px, 90vw" loading="lazy" />}
            <div class="cb-corpo">
              <p class="cb-meta">{PUBLICOS[p.data.publico]} · {dataCurta(p.data.data)} · {tempoLeitura(p.body)} min</p>
              <h3><a href={url(`blog/${p.id}/`)}>{p.data.titulo}</a></h3>
              <span class="cb-ler" aria-hidden="true">Ler artigo →</span>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </section>
)}

<style is:global>
  .cb { --cb-fg: #0B0A0D; --cb-muted: #6B6870; --cb-card: #fff; --cb-line: rgb(0 0 0 / .08); --cb-hl: #5A30EE; color: var(--cb-fg); font-family: "Inter Variable", Inter, ui-sans-serif, system-ui, sans-serif; }
  .cb[data-tom="escuro"] { --cb-fg: #F3F1F7; --cb-muted: rgb(243 241 247 / .62); --cb-card: #141217; --cb-line: rgb(255 255 255 / .08); --cb-hl: #B79CFF; }
  .cb-cab { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 24px; }
  .cb-rotulo { margin: 0; font: 500 11px/1 "JetBrains Mono", ui-monospace, monospace; text-transform: uppercase; letter-spacing: .14em; color: var(--cb-hl); }
  .cb h2 { margin: 10px 0 0; font-size: clamp(26px, 3.4vw, 38px); line-height: 1.1; font-weight: 700; letter-spacing: -.02em; font-family: inherit; text-transform: none; }
  .cb-todos { color: var(--cb-hl); font-weight: 600; font-size: 15px; text-decoration: none; white-space: nowrap; }
  .cb-todos:hover { text-decoration: underline; text-underline-offset: 4px; }
  .cb-lista { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .cb-card { position: relative; height: 100%; display: flex; flex-direction: column; overflow: hidden; border-radius: 16px; background: var(--cb-card); border: 1px solid var(--cb-line); transition: transform .3s cubic-bezier(.16, 1, .3, 1), border-color .3s; }
  .cb-card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--cb-hl) 50%, transparent); }
  .cb-card img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .cb-corpo { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .cb-meta { margin: 0; font: 500 10.5px/1.4 "JetBrains Mono", ui-monospace, monospace; text-transform: uppercase; letter-spacing: .08em; color: var(--cb-muted); }
  .cb h3 { margin: 0; font-size: 18px; line-height: 1.3; font-weight: 600; letter-spacing: -.01em; font-family: inherit; text-transform: none; text-wrap: balance; }
  .cb h3 a { color: inherit; text-decoration: none; }
  .cb h3 a::after { content: ""; position: absolute; inset: 0; }
  .cb h3 a:focus-visible { outline: none; }
  .cb-card:has(a:focus-visible) { outline: 2px solid var(--cb-hl); outline-offset: 3px; }
  .cb-ler { margin-top: auto; padding-top: 4px; color: var(--cb-hl); font-size: 14px; font-weight: 600; }
  @media (prefers-reduced-motion: reduce) { .cb-card { transition: none; } .cb-card:hover { transform: none; } }
</style>
