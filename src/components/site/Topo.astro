---
/* Topo único do site: logo (volta ao Início), os links de src/data/navegacao.ts,
   bandeirinha de idioma e um botão de ação.
   tom: 'escuro' (páginas pretas) ou 'claro' (páginas de fundo claro).
   cta: botão da direita (curto = texto no celular). Sem cta, chama no WhatsApp. download: para o PDF do currículo.
   No celular, os links ficam num menu de tela cheia. */
import Fox from '../Fox.astro';
import TrocaIdioma from '../TrocaIdioma.astro';
import { linkWhatsApp } from '../../data/site';
import { linksNav, secaoAtual, soPortugues } from '../../data/navegacao';
import { idioma, tradutor, pagina } from '../../i18n';

interface Props {
  tom?: 'escuro' | 'claro';
  cta?: { texto: string; curto?: string; href: string; download?: boolean };
}
const L = idioma(Astro.url);
const T = tradutor(L);
const { tom = 'escuro', cta = { texto: T('Falar no WhatsApp', 'Message me'), curto: 'WhatsApp', href: linkWhatsApp(T('Olá, Jonathan! Vi seu site e quero conversar.', 'Hi, Jonathan! I saw your website and would like to talk.')) } } = Astro.props;
const atual = secaoAtual(Astro.url.pathname);
const links = linksNav(L);
const comIdioma = !soPortugues(Astro.url.pathname);
const externo = /^https?:/.test(cta.href);
const alvo = externo ? { target: '_blank', rel: 'noopener' } : {};
const inicio = pagina(L);
---
<header class="sit-topo" data-tom={tom}>
  <div class="sit-in">
    <a href={inicio} class="sit-marca" aria-label={T('Jonathan Menino, início', 'Jonathan Menino, home')} aria-current={atual === 'inicio' ? 'page' : undefined}>
      <Fox cor={tom === 'claro' ? '#6E44FF' : '#9B7BFF'} class="sit-fox" />
      <span><b>Jonathan Menino</b><small>{T('Design · Vídeo · Sites', 'Design · Video · Web')}</small></span>
    </a>
    <nav class="sit-nav" aria-label={T('Principal', 'Main')}>
      {links.map((l) => <a href={l.href} aria-current={l.id === atual ? 'page' : undefined}>{l.texto}</a>)}
    </nav>
    <div class="sit-ferr">
      {comIdioma && <TrocaIdioma class="sit-idioma" />}
      <a class="sit-cta" href={cta.href} download={cta.download ? '' : undefined} {...alvo}><span class="sit-longo">{cta.texto}</span><span class="sit-curto">{cta.curto ?? cta.texto}</span>{externo && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>}</a>
      <button type="button" class="sit-abre" aria-label={T('Abrir menu', 'Open menu')} aria-controls="sit-menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<div id="sit-menu" class="sit-menu" role="dialog" aria-modal="true" aria-label={T('Menu', 'Menu')} hidden>
  <div class="sit-menu-cab">
    <a href={inicio} class="sit-marca"><Fox cor="#9B7BFF" class="sit-fox" /><span><b>Jonathan Menino</b></span></a>
    <button type="button" class="sit-fecha" aria-label={T('Fechar menu', 'Close menu')}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
  <nav aria-label={T('Menu do celular', 'Mobile menu')}>
    <a href={inicio} aria-current={atual === 'inicio' ? 'page' : undefined}><span>{T('Início', 'Home')}</span><small>{T('quem sou', 'about me')}</small></a>
    {links.map((l) => <a href={l.href} aria-current={l.id === atual ? 'page' : undefined}><span>{l.texto}</span><small>{l.dica}</small></a>)}
  </nav>
  <div class="sit-menu-pe">
    <div class="sit-menu-ferr">{comIdioma && <TrocaIdioma />}</div>
    <a class="sit-cta sit-cta-menu" href={cta.href} download={cta.download ? '' : undefined} {...alvo}>{cta.texto}</a>
  </div>
</div>

<script>
  // Menu do celular: abre em tela cheia, fecha no X, no Esc ou ao tocar num link.
  const menu = document.getElementById('sit-menu');
  const abre = document.querySelector<HTMLButtonElement>('.sit-abre');
  const fecha = menu?.querySelector<HTMLButtonElement>('.sit-fecha');
  const mostrar = (on: boolean) => {
    if (!menu || !abre) return;
    menu.hidden = !on;
    abre.setAttribute('aria-expanded', String(on));
    document.documentElement.classList.toggle('sit-travado', on);
    (on ? fecha : abre)?.focus();
  };
  abre?.addEventListener('click', () => mostrar(true));
  fecha?.addEventListener('click', () => mostrar(false));
  menu?.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => mostrar(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu && !menu.hidden) mostrar(false); });
  matchMedia('(min-width: 1080px)').addEventListener('change', (m) => { if (m.matches) mostrar(false); });
</script>

<style is:global>
  .sit-topo {
    --t-bg: rgb(11 10 13 / .88); --t-fg: #F3F1F7; --t-muted: rgb(243 241 247 / .6); --t-line: rgb(255 255 255 / .08); --t-hl: #9B7BFF;
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50;
    background: var(--t-bg); color: var(--t-fg); border-bottom: 1px solid var(--t-line);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    font-family: "Inter Variable", Inter, ui-sans-serif, system-ui, sans-serif; line-height: 1.2;
  }
  .sit-topo[data-tom="claro"] { --t-bg: rgb(247 246 243 / .9); --t-fg: #0B0A0D; --t-muted: #6B6870; --t-line: rgb(0 0 0 / .07); --t-hl: #6E44FF; }
  .sit-in { max-width: 1280px; margin: 0 auto; height: 64px; display: flex; align-items: center; gap: 20px; padding: 0 max(20px, env(safe-area-inset-right, 0px)) 0 max(20px, env(safe-area-inset-left, 0px)); }
  .sit-marca { display: flex; align-items: center; gap: 10px; color: inherit; text-decoration: none; flex-shrink: 0; }
  .sit-fox { height: 30px; width: auto; display: block; }
  .sit-marca b { display: block; font-size: 15px; font-weight: 600; letter-spacing: -.01em; }
  .sit-marca small { display: block; margin-top: 3px; font: 500 9.5px/1 "JetBrains Mono", ui-monospace, monospace; text-transform: uppercase; letter-spacing: .14em; color: var(--t-muted); }
  .sit-nav { display: none; gap: 26px; margin-left: auto; font-size: 14px; font-weight: 500; }
  .sit-nav a { position: relative; padding: 8px 0; color: inherit; text-decoration: none; opacity: .82; transition: opacity .2s, color .2s; white-space: nowrap; }
  .sit-nav a:hover { opacity: 1; color: var(--t-hl); }
  .sit-nav a[aria-current="page"] { opacity: 1; }
  .sit-nav a[aria-current="page"]::after { content: ""; position: absolute; left: 0; right: 0; bottom: 2px; height: 2px; border-radius: 2px; background: var(--t-hl); }
  .sit-ferr { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .sit-nav + .sit-ferr { margin-left: 8px; }
  .sit-cta { display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; border-radius: 999px; background: #6E44FF; color: #fff; font-size: 14px; font-weight: 600; text-decoration: none; white-space: nowrap; transition: background-color .2s; }
  @media (hover: hover) and (pointer: fine) { .sit-cta:hover { background: #5A30EE; } }
  .sit-cta svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; }
  .sit-abre, .sit-fecha { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 999px; border: 1px solid color-mix(in srgb, currentColor 22%, transparent); background: none; color: inherit; cursor: pointer; flex-shrink: 0; }
  .sit-abre svg, .sit-fecha svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .sit-topo .sit-idioma { display: none; }
  .sit-topo a:focus-visible, .sit-topo button:focus-visible, .sit-menu a:focus-visible, .sit-menu button:focus-visible { outline: 2px solid #9B7BFF; outline-offset: 3px; border-radius: 6px; }
  .sit-topo .sit-cta { padding: 9px 14px; font-size: 13.5px; }
  .sit-longo { display: none; }
  .sit-in { gap: 12px; }
  @media (max-width: 479px) { .sit-topo .sit-marca small { display: none; } .sit-topo .sit-marca b { font-size: 14px; } }
  @media (min-width: 640px) { .sit-in { gap: 20px; } }
  @media (min-width: 640px) { .sit-topo .sit-cta { padding: 10px 18px; font-size: 14px; } .sit-longo { display: inline; } .sit-curto { display: none; } }
  @media (min-width: 1080px) {
    .sit-nav { display: flex; }
    .sit-topo .sit-idioma { display: inline-flex; }
    .sit-abre { display: none; }
  }

  /* Menu de tela cheia no celular */
  .sit-menu { position: fixed; inset: 0; z-index: 70; display: flex; flex-direction: column; overflow-y: auto; background: #0B0A0D; color: #F3F1F7; font-family: "Inter Variable", Inter, ui-sans-serif, system-ui, sans-serif; padding: calc(env(safe-area-inset-top, 0px) + 12px) max(20px, env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + 24px) max(20px, env(safe-area-inset-left, 0px)); }
  .sit-menu[hidden] { display: none; }
  .sit-menu-cab { display: flex; align-items: center; justify-content: space-between; height: 40px; }
  .sit-menu nav { display: flex; flex-direction: column; margin-top: 28px; }
  .sit-menu nav a { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 13px 0; border-bottom: 1px solid rgb(255 255 255 / .08); color: inherit; text-decoration: none; font-size: 26px; font-weight: 600; letter-spacing: -.02em; }
  .sit-menu nav a small { font: 400 11px/1 "JetBrains Mono", ui-monospace, monospace; color: #A6A0B3; letter-spacing: .04em; }
  .sit-menu nav a[aria-current="page"] { color: #B79CFF; }
  .sit-menu-pe { margin-top: auto; padding-top: 28px; display: grid; gap: 16px; }
  .sit-menu-ferr { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .sit-menu .sit-cta { display: flex; justify-content: center; padding: 16px; font-size: 15px; }
  .sit-travado, .sit-travado body { overflow: hidden; }
  /* Abertura do menu: o fundo aparece e os links sobem em sequência curta. Fecha na hora (sair é mais rápido que entrar). */
  @media (prefers-reduced-motion: no-preference) {
    .sit-menu:not([hidden]) { animation: sit-menu-abre .22s cubic-bezier(.23, 1, .32, 1); }
    .sit-menu:not([hidden]) nav a, .sit-menu:not([hidden]) .sit-menu-pe { animation: sit-menu-item .4s cubic-bezier(.23, 1, .32, 1) both; }
    .sit-menu nav a:nth-child(2) { animation-delay: .03s; } .sit-menu nav a:nth-child(3) { animation-delay: .06s; }
    .sit-menu nav a:nth-child(4) { animation-delay: .09s; } .sit-menu nav a:nth-child(5) { animation-delay: .12s; }
    .sit-menu nav a:nth-child(n+6), .sit-menu .sit-menu-pe { animation-delay: .15s; }
    @keyframes sit-menu-abre { from { opacity: 0; } }
    @keyframes sit-menu-item { from { opacity: 0; transform: translateY(14px); } }
  }
  @media (prefers-reduced-motion: reduce) { .sit-menu:not([hidden]) { animation: sit-menu-abre .15s ease; } @keyframes sit-menu-abre { from { opacity: 0; } } }
  .sit-cta { transition: background-color .2s, transform .16s cubic-bezier(.23, 1, .32, 1); }
  .sit-cta:active { transform: scale(.97); }
  @media print { .sit-topo, .sit-menu { display: none !important; } }
</style>
