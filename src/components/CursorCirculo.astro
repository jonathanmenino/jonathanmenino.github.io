---
// Círculo roxo que segue o mouse com atraso e inverte as cores do que passa por trás.
// No clique, solta uma onda de choque roxa. Só aparece com mouse (hover + ponteiro fino); some em telas de toque.
---
<div class="cursor-circulo" aria-hidden="true"></div>
<div class="cursor-anel" aria-hidden="true"></div>

<style is:global>
  .cursor-circulo, .cursor-anel { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .cursor-circulo, .cursor-anel {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      border-radius: 50%;
      pointer-events: none;
      opacity: 0;
      transition: opacity .25s ease;
      will-change: transform;
    }
    /* Núcleo: mix-blend-mode difference com branco = negativo do que está atrás.
       Mais leve que backdrop-filter e sem corte nas bordas ao se mover. */
    .cursor-circulo {
      z-index: 9999;
      width: 30px;
      height: 30px;
      margin: -15px 0 0 -15px;
      background: #fff;
      mix-blend-mode: difference;
    }
    /* Anel roxo por cima do núcleo: o preenchimento translúcido tinge o negativo de roxo e deixa mais claro. */
    .cursor-anel {
      z-index: 10000;
      width: 34px;
      height: 34px;
      margin: -17px 0 0 -17px;
      background: rgb(155 123 255 / .45);
      box-shadow: 0 0 14px rgb(110 68 255 / .35);
    }
    .cursor-circulo.ativo, .cursor-anel.ativo { opacity: 1; }
    .cursor-onda {
      position: fixed;
      z-index: 9998;
      width: 40px;
      height: 40px;
      margin: -20px 0 0 -20px;
      border-radius: 50%;
      pointer-events: none;
      border: 2px solid #9B7BFF;
      box-shadow: 0 0 18px rgb(110 68 255 / .5), inset 0 0 12px rgb(110 68 255 / .35);
    }
  }
</style>

<script is:inline>
  (function () {
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    var c = document.querySelector('.cursor-circulo'), a = document.querySelector('.cursor-anel');
    if (!c || !a) return;
    var els = [c, a];
    var reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // esc/escAlvo: o "aperto" do clique fica dentro do transform, depois do translate,
    // para a bolinha encolher no lugar (a propriedade CSS scale escalava o deslocamento junto).
    var mx = -100, my = -100, x = -100, y = -100, esc = 1, escAlvo = 1, rodando = false, antes = 0;
    function poe(px, py) {
      var tr = 'translate3d(' + px.toFixed(2) + 'px,' + py.toFixed(2) + 'px,0) scale(' + esc.toFixed(3) + ')';
      c.style.transform = tr; a.style.transform = tr;
    }
    function passo(agora) {
      // Suavização que não depende da taxa de quadros: o atraso é o mesmo em 60 Hz ou 144 Hz.
      // Quanto menor a VELOCIDADE, mais o círculo demora para alcançar o mouse.
      var dt = Math.min(agora - (antes || agora - 16.7), 50); antes = agora;
      var f = reduz ? 1 : 1 - Math.pow(1 - 0.2, dt / 16.7);
      x += (mx - x) * f;
      y += (my - y) * f;
      esc += (escAlvo - esc) * (1 - Math.pow(1 - 0.3, dt / 16.7));
      poe(x, y);
      if (Math.abs(mx - x) > 0.05 || Math.abs(my - y) > 0.05 || Math.abs(escAlvo - esc) > 0.002) requestAnimationFrame(passo);
      else { esc = escAlvo; poe(x, y); rodando = false; antes = 0; }
    }
    addEventListener('pointermove', function (e) {
      if (e.pointerType !== 'mouse') return;
      mx = e.clientX; my = e.clientY;
      if (!c.classList.contains('ativo')) { x = mx; y = my; poe(x, y); els.forEach(function (el) { el.classList.add('ativo'); }); }
      if (!rodando) { rodando = true; requestAnimationFrame(passo); }
    }, { passive: true });
    function anima() { if (!rodando) { rodando = true; requestAnimationFrame(passo); } }
    // Onda de choque: dois anéis que saem do ponto do clique e somem.
    addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse') return;
      escAlvo = .75; anima();
      setTimeout(function () { escAlvo = 1; anima(); }, 150);
      if (reduz) return;
      [0, 90].forEach(function (atraso, i) {
        var o = document.createElement('div');
        o.className = 'cursor-onda';
        o.style.left = e.clientX + 'px';
        o.style.top = e.clientY + 'px';
        document.body.appendChild(o);
        o.animate(
          [{ transform: 'scale(.3)', opacity: 1 }, { transform: 'scale(' + (i ? 3.2 : 4.5) + ')', opacity: 0 }],
          { duration: 650, delay: atraso, easing: 'cubic-bezier(.2,.7,.3,1)', fill: 'both' }
        ).onfinish = function () { o.remove(); };
      });
    });
    document.documentElement.addEventListener('mouseleave', function () { els.forEach(function (el) { el.classList.remove('ativo'); }); });
  })();
</script>
