---
// Círculo roxo que segue o mouse com atraso e inverte as cores do que passa por trás.
// Só aparece com mouse (hover + ponteiro fino); some em telas de toque.
---
<div class="cursor-circulo" aria-hidden="true"></div>

<style is:global>
  .cursor-circulo { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .cursor-circulo {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 9999;
      width: 56px;
      height: 56px;
      margin: -28px 0 0 -28px;
      border-radius: 50%;
      pointer-events: none;
      background: rgb(110 68 255 / .28);
      border: 1.5px solid #6E44FF;
      -webkit-backdrop-filter: invert(1);
      backdrop-filter: invert(1);
      opacity: 0;
      transition: opacity .25s ease;
      will-change: transform;
    }
    .cursor-circulo.ativo { opacity: 1; }
  }
</style>

<script is:inline>
  (function () {
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    var c = document.querySelector('.cursor-circulo');
    if (!c) return;
    var reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var mx = -100, my = -100, x = -100, y = -100, rodando = false;
    function passo() {
      // Quanto menor o fator, mais o círculo demora para alcançar o mouse.
      var f = reduz ? 1 : 0.12;
      x += (mx - x) * f;
      y += (my - y) * f;
      c.style.transform = 'translate3d(' + x + 'px,' + y + 'px,0)';
      if (Math.abs(mx - x) > 0.1 || Math.abs(my - y) > 0.1) requestAnimationFrame(passo);
      else rodando = false;
    }
    addEventListener('pointermove', function (e) {
      if (e.pointerType !== 'mouse') return;
      if (!c.classList.contains('ativo')) { x = mx = e.clientX; y = my = e.clientY; c.classList.add('ativo'); }
      mx = e.clientX; my = e.clientY;
      if (!rodando) { rodando = true; requestAnimationFrame(passo); }
    }, { passive: true });
    document.documentElement.addEventListener('mouseleave', function () { c.classList.remove('ativo'); });
  })();
</script>
