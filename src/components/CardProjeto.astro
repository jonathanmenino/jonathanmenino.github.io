---
// Card de um projeto do portfólio (dados em src/data/portfolio.ts).
import { CATEGORIAS, type Projeto } from '../data/portfolio';
import { url } from '../data/site';
interface Props { p: Projeto; eager?: boolean }
const { p, eager = false } = Astro.props;
---
<a class="pj" href={url(p.link)} data-categorias={p.categorias.join(' ')}>
  <span class="pj-capa"><img src={url(p.capa)} alt="" width="1200" height="630" loading={eager ? 'eager' : 'lazy'} decoding="async" /></span>
  <span class="pj-txt">
    <span class="pj-tipo">{p.tipo}</span>
    <span class="pj-titulo">{p.titulo} <span class="pj-seta" aria-hidden="true">→</span></span>
    <span class="pj-cliente">{p.cliente}</span>
    <span class="pj-resumo">{p.resumo}</span>
    <span class="pj-tags">{p.categorias.map((c) => <span>{CATEGORIAS[c]}</span>)}</span>
  </span>
</a>

<style is:global>
.pj { display: flex; flex-direction: column; height: 100%; border: 1px solid rgba(255,255,255,.1); border-radius: 18px; overflow: hidden; background: #151317; color: #fff; text-decoration: none; transition: border-color .2s, transform .2s; }
.pj:hover { border-color: rgba(155,123,255,.6); transform: translateY(-3px); }
.pj-capa { display: block; aspect-ratio: 1200 / 630; overflow: hidden; background: #1d1a22; }
.pj-capa img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
.pj:hover .pj-capa img { transform: scale(1.03); }
.pj-txt { display: flex; flex-direction: column; gap: 6px; padding: 20px 22px 22px; flex: 1; }
.pj-tipo { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #9B7BFF; }
.pj-titulo { font-size: 20px; font-weight: 650; letter-spacing: -.01em; }
.pj-seta { display: inline-block; color: #9B7BFF; transition: transform .2s; }
.pj:hover .pj-seta { transform: translateX(3px); }
.pj-cliente { font-size: 13px; color: rgba(255,255,255,.55); }
.pj-resumo { margin-top: 4px; font-size: 15px; line-height: 1.55; color: rgba(255,255,255,.72); flex: 1; }
.pj-tags { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px; }
.pj-tags span { padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,.12); font-size: 12px; color: rgba(255,255,255,.7); }
@media (prefers-reduced-motion: reduce) { .pj, .pj-capa img, .pj-seta { transition: none; } }
</style>
