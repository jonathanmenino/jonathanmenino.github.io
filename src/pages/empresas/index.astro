---
/* PARA EMPRESAS: serviços diretos para marcas, como funciona e perguntas frequentes.
   Textos e listas ficam nas constantes abaixo. Mesmo visual da home (src/styles/home.css e src/scripts/home.ts).
   Mensagem do WhatsApp: MENSAGENS.empresa em src/data/site.ts. */
import Base from '../../layouts/Base.astro';
import Prancheta from '../../components/novo/Prancheta.astro';
import Topo from '../../components/site/Topo.astro';
import Rodape from '../../components/site/Rodape.astro';
import ChamadaBlog from '../../components/site/ChamadaBlog.astro';
import Mural from '../../components/novo/Mural.astro';
import FundoLiquido from '../../components/novo/FundoLiquido.astro';
import { SITE, mensagens, url, linkWhatsApp } from '../../data/site';
import { PROJETOS, categoria } from '../../data/portfolio';
import { idioma, tradutor, pagina, em } from '../../i18n';
import '@fontsource/anton/latin-400.css';
import '@fontsource/caveat-brush/latin-400.css';
import '../../styles/home.css';

const L = idioma(Astro.url);
const T = tradutor(L);
const wa = linkWhatsApp(mensagens(L).empresa);
const DESTAQUES = PROJETOS.filter((p) => p.destaque).map((p) => em(p, L));
const EMAIL = 'jmeninodesign@gmail.com';
const capa = (link: string) => PROJETOS.find((p) => p.link === link)?.capa ?? 'og/home.jpg';

const SERVICOS = T([
  {
    titulo: 'Identidade visual',
    texto: 'Para quem está começando ou quer arrumar a casa. Uma marca com cara própria, que funciona do cartão ao Instagram.',
    itens: ['Logo e versões', 'Cores e tipografia', 'Grafismos', 'Papelaria e aplicações', 'Guia de uso da marca'],
    exemplo: { nome: 'Gois & Silva', link: 'portfolio/gois-e-silva/' },
  },
  {
    titulo: 'Campanhas e redes sociais',
    texto: 'Lançamentos, datas sazonais e o dia a dia das redes. Todas as peças falando a mesma língua.',
    itens: ['Posts e stories', 'Anúncios', 'Conceito de campanha', 'Impressos', 'Ponto de venda'],
    exemplo: { nome: 'Escalados Macarrone', link: 'portfolio/escalados-macarrone/' },
  },
  {
    titulo: 'Vídeo e motion',
    texto: 'Vídeos curtos que prendem a atenção nos primeiros segundos, com ritmo e acabamento.',
    itens: ['Reels e TikTok', 'Vídeos para anúncio', 'Motion design', 'Telão de LED', 'Cenas com IA'],
    exemplo: { nome: 'Costelinha BBQ', link: 'portfolio/macarrone-costelinha-bbq/' },
  },
  {
    titulo: 'Sites e landing pages',
    texto: 'Desenho no Figma e desenvolvo em código. Sites rápidos, que abrem bem no celular e levam o cliente até o contato.',
    itens: ['Landing pages', 'Sites institucionais', 'Interface no Figma', 'Versão para celular', 'Botão de WhatsApp'],
    exemplo: { nome: 'Omuch', link: 'portfolio/omuch/' },
  },
], [
  {
    titulo: 'Visual identity',
    texto: 'For businesses that are just starting or want to get their house in order. A brand with its own personality that works from business cards to Instagram.',
    itens: ['Logo and versions', 'Colors and typography', 'Graphic elements', 'Stationery and applications', 'Brand guidelines'],
    exemplo: { nome: 'Gois & Silva', link: 'portfolio/gois-e-silva/' },
  },
  {
    titulo: 'Campaigns and social media',
    texto: 'Launches, seasonal dates and everyday social media. Every piece speaking the same language.',
    itens: ['Posts and stories', 'Ads', 'Campaign concept', 'Print', 'Point of sale'],
    exemplo: { nome: 'Escalados Macarrone', link: 'portfolio/escalados-macarrone/' },
  },
  {
    titulo: 'Video and motion',
    texto: 'Short videos that hold attention in the first few seconds, with rhythm and polish.',
    itens: ['Reels and TikTok', 'Ad videos', 'Motion design', 'LED screens', 'AI-generated scenes'],
    exemplo: { nome: 'Costelinha BBQ', link: 'portfolio/macarrone-costelinha-bbq/' },
  },
  {
    titulo: 'Websites and landing pages',
    texto: 'I design in Figma and build in code. Fast websites that work well on phones and lead customers to get in touch.',
    itens: ['Landing pages', 'Corporate websites', 'Figma interface', 'Mobile version', 'WhatsApp button'],
    exemplo: { nome: 'Omuch', link: 'portfolio/omuch/' },
  },
]);

const ETAPAS = T([
  { t: 'Conversa', d: 'Você me conta sobre a empresa, o que precisa e para quando. Pode ser pelo WhatsApp ou numa chamada rápida.' },
  { t: 'Proposta', d: 'Envio o que vou entregar, o prazo e o valor. Tudo fechado antes de começar, sem surpresa no meio do caminho.' },
  { t: 'Criação', d: 'Pesquiso a marca e o público e apresento o caminho criativo, explicando cada escolha.' },
  { t: 'Ajustes', d: 'Você comenta e eu refino. As rodadas de ajuste já vêm combinadas na proposta.' },
  { t: 'Entrega', d: 'Arquivos finais organizados, nos formatos que você vai usar: impressão, redes, site e vídeo.' },
], [
  { t: 'Conversation', d: 'You tell me about your business, what you need and by when. It can be on WhatsApp or a quick call.' },
  { t: 'Proposal', d: 'I send what I’ll deliver, the timeline and the price. Everything agreed before we start, no surprises along the way.' },
  { t: 'Creation', d: 'I research the brand and the audience and present the creative direction, explaining every choice.' },
  { t: 'Revisions', d: 'You comment and I refine. Revision rounds are already set in the proposal.' },
  { t: 'Delivery', d: 'Organized final files in the formats you’ll use: print, social media, web and video.' },
]);

const MOTIVOS = T([
  { t: 'Direto com quem cria', d: 'Você fala comigo do começo ao fim. Sem intermediário e sem briefing perdido no caminho.' },
  { t: 'Tudo coerente', d: 'A mesma pessoa cuida da marca, das peças, do vídeo e do site. A sua empresa fica com uma cara só.' },
  { t: '13 anos de estrada', d: 'Já atendi segurança digital, automotivo, educação, alimentação e varejo, do B2B ao B2C.' },
  { t: 'Prazo é prazo', d: 'Venho do ritmo de agência: entrego no combinado, sem abrir mão do acabamento.' },
], [
  { t: 'Straight to the creator', d: 'You talk to me from start to finish. No middlemen and no briefing lost along the way.' },
  { t: 'Everything consistent', d: 'The same person takes care of the brand, the pieces, the video and the website. Your business keeps one single look.' },
  { t: '13 years in the field', d: 'I’ve worked with cybersecurity, automotive, education, food and retail, from B2B to B2C.' },
  { t: 'Deadlines are deadlines', d: 'I come from agency pace: I deliver on time without cutting corners on the finish.' },
]);

const PERGUNTAS = T([
  { q: 'Você atende empresas de outras cidades?', r: 'Sim. Moro em Limeira/SP, mas trabalho a distância com empresas de todo o Brasil. Conversas, aprovações e entregas são todas online.' },
  { q: 'Quanto custa?', r: 'Depende do que a sua empresa precisa. Depois de uma conversa rápida eu envio uma proposta com valor fechado e o que está incluído.' },
  { q: 'Qual é o prazo?', r: 'Varia com o tamanho do projeto. Uma peça avulsa sai em poucos dias; uma identidade completa ou um site levam algumas semanas. O prazo exato vai na proposta.' },
  { q: 'Dá para fazer só uma peça ou só um vídeo?', r: 'Dá. Atendo projetos pontuais e também demandas recorrentes, como posts e vídeos todo mês.' },
  { q: 'Eu fico com os arquivos?', r: 'Sim. Na entrega você recebe os arquivos finais em todos os formatos combinados, prontos para usar.' },
], [
  { q: 'Do you work with businesses in other cities?', r: 'Yes. I live in Limeira, Brazil, but I work remotely with businesses all over the country. Calls, approvals and deliveries all happen online.' },
  { q: 'How much does it cost?', r: 'It depends on what your business needs. After a quick conversation I send a proposal with a fixed price and everything that’s included.' },
  { q: 'How long does it take?', r: 'It depends on the size of the project. A single piece takes a few days; a full identity or a website takes a few weeks. The exact timeline goes in the proposal.' },
  { q: 'Can I order just one piece or one video?', r: 'Yes. I take on one-off projects and also recurring work, like monthly posts and videos.' },
  { q: 'Do I keep the files?', r: 'Yes. On delivery you get the final files in every format we agreed on, ready to use.' },
]);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: T('Jonathan Menino · Design para empresas', 'Jonathan Menino · Design for businesses'),
  description: T('Identidade visual, campanhas, vídeos e sites para empresas.', 'Visual identity, campaigns, videos and websites for businesses.'),
  url: new URL(pagina(L, 'empresas/'), Astro.site).href,
  areaServed: { '@type': 'Country', name: 'Brasil' },
  availableLanguage: ['pt-BR', 'en'],
  serviceType: T(['Identidade visual', 'Social media', 'Edição de vídeo', 'Motion design', 'Criação de sites', 'Landing pages'], ['Visual identity', 'Social media', 'Video editing', 'Motion design', 'Web design', 'Landing pages']),
  provider: { '@type': 'Person', name: SITE.nome, url: new URL(pagina(L), Astro.site).href, sameAs: Object.values(SITE.redes).filter(Boolean) },
};
---
<Base
  title={T('Design para empresas · Jonathan Menino', 'Design for businesses · Jonathan Menino')}
  description={T('Identidade visual, campanhas, vídeos e sites para a sua empresa, feitos direto com o designer. Atendo todo o Brasil a partir de Limeira/SP.', 'Visual identity, campaigns, videos and websites for your business, made directly with the designer. Based in Limeira, Brazil, working remotely.')}
  jsonld={jsonld}
>
<Prancheta />
<Topo tom="escuro" cta={{ texto: T('Pedir orçamento', 'Get a quote'), curto: T('Orçamento', 'Quote'), href: wa }} />

<header class="heroi" id="topo">
  <FundoLiquido />
  <div></div>
  <div></div>
  <div class="base">
    <p class="selo"><span class="pulso" aria-hidden="true"></span>{T('Orçamento sem compromisso', 'Free, no-obligation quote')}</p>
    <div class="linha-nome">
      <p class="mao nota-mao" aria-hidden="true">{T('↙ direto com quem cria, do briefing à entrega', '↙ straight to the creator, from brief to delivery')}</p>
      {L === 'en'
        ? <h1 class="tt nome nome-longo"><span class="l">Design that gets</span> <span class="l">your brand seen.</span> <span class="l"><em>And remembered.</em></span></h1>
        : <h1 class="tt nome nome-longo"><span class="l">Design para a sua</span> <span class="l">marca ser vista.</span> <span class="l"><em>E lembrada.</em></span></h1>}
    </div>
    <div class="sob-nome">
      <div class="esq">
        <a class="mao desce" href="#servicos">{T('↓ veja o que eu faço', '↓ see what I do')}</a>
        <svg class="risco" id="risco-heroi" viewBox="0 0 600 18" preserveAspectRatio="none" aria-hidden="true"><path d="M4 12 C 120 4, 260 14, 380 8 S 560 6, 596 10"/></svg>
      </div>
      <div class="acoes">
        <a class="btn" href={wa}>{T('Pedir orçamento no WhatsApp', 'Get a quote on WhatsApp')}</a>
        <a class="btn sec" href={pagina(L, 'portfolio/')}>{T('Ver portfólio', 'View portfolio')} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</header>

<div class="corpo solo">
  <main>
    <section class="secao" id="servicos" aria-labelledby="t-serv">
      <h2 class="tt titulo-sec" id="t-serv">{T('O que eu faço pela', 'What I do for')} <em>{T('sua empresa', 'your business')}</em></h2>
      <p class="mao sub-mao">{T('→ crio identidade visual, campanhas, vídeos e sites para empresas que querem se comunicar bem', '→ I create visual identities, campaigns, videos and websites for businesses that want to communicate well')}</p>
      <ul class="frentes">
        {SERVICOS.map((s, i) => (
          <li>
            <a href={pagina(L, s.exemplo.link)} data-previa={url(capa(s.exemplo.link))}><h3 class="tt"><span class="num">0{i + 1}</span>{s.titulo}</h3></a>
            <p class="txt">{s.texto}</p>
            <div class="tags mono">{s.itens.map((x) => <span>{x}</span>)}</div>
            <a class="mao ex" href={pagina(L, s.exemplo.link)}>{T('→ ver', '→ see')} {s.exemplo.nome}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="secao" id="como" aria-labelledby="t-como">
      <div class="cab"><h2 class="tt" id="t-como">{T('Como', 'How it')} <em>{T('funciona', 'works')}</em></h2><p class="mao">{T('→ tudo combinado antes de começar', '→ everything agreed before we start')}</p></div>
      <ol class="linha-tempo cinco">
        {ETAPAS.map((e, i) => <li><span class="ano">0{i + 1}</span><h3>{e.t}</h3><p>{e.d}</p></li>)}
      </ol>
    </section>

    <section class="secao" aria-labelledby="t-por">
      <h2 class="tt titulo-sec" id="t-por">{T('Por que', 'Why work')} <em>{T('comigo', 'with me')}</em></h2>
      <svg class="risco" viewBox="0 0 600 18" preserveAspectRatio="none" aria-hidden="true" style="width:min(100%,520px);height:14px;margin-top:10px;color:var(--lilas)"><path d="M4 10 C 140 15, 300 3, 450 9 S 570 12, 596 7"/></svg>
      <ul class="motivos">
        {MOTIVOS.map((m) => <li><h3 class="tt">{m.t}</h3><p>{m.d}</p></li>)}
      </ul>
    </section>

    <section class="secao" id="trabalhos" aria-labelledby="t-trab">
      <div class="cab"><h2 class="tt" id="t-trab">{T('Alguns', 'Selected')} <em>{T('projetos', 'projects')}</em></h2><p class="mao">{T('→ arraste para o lado', '→ drag sideways')}</p></div>
      <div class="trilho-area" id="trilho-area"><div class="trilho" id="trilho">
        {DESTAQUES.map((p) => (
          <a class="card" href={pagina(L, p.link)} draggable="false">
            <div class="foto"><img src={url(p.capa)} alt={T(`Capa do projeto ${p.titulo}`, `${p.titulo} project cover`)} width="1200" height="630" loading="lazy" draggable="false"></div>
            <div class="meta"><div><h3 class="tt">{p.titulo}</h3><p class="cli">{p.cliente}</p></div><span class="mono tag">{categoria(p.categorias[0], L)}</span></div>
          </a>
        ))}
      </div></div>
      <div class="trilho-pe"><div class="barra"><i id="barra"></i></div><a class="mono" href={pagina(L, 'portfolio/')}>{T('Ver todos os projetos →', 'See all projects →')}</a></div>
    </section>

    <section class="secao" aria-labelledby="t-faq">
      <h2 class="tt titulo-sec" id="t-faq">{T('Perguntas', 'Frequently asked')} <em>{T('frequentes', 'questions')}</em></h2>
      <div class="faq">
        {PERGUNTAS.map((p) => (
          <details>
            <summary>{p.q}</summary>
            <p>{p.r}</p>
          </details>
        ))}
      </div>
    </section>

    <ChamadaBlog publico="empresas" tom="escuro" titulo="Dicas para o site da sua empresa" class="secao" />

    <section class="pergunta" aria-labelledby="t-perg">
      <h2 class="tt" id="t-perg">{T('Vamos tirar a sua ideia', 'Shall we bring your idea')}<br><em>{T('do papel?', 'to life?')}</em></h2>
    </section>
  </main>
</div>

<Mural titulo={T('Pedir orçamento', 'Get a quote')}>
  <h2 class="tt">{L === 'en' ? <><em>Tell me</em> what you need</> : <><em>Me conta</em> o que você precisa</>}</h2>
  <svg class="risco" viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true"><path d="M3 7 C 90 3, 180 10, 297 6"/></svg>
  <p class="txt">{T('Respondo rápido e envio uma proposta sem compromisso, com prazo e valor fechados.', 'I reply quickly and send a no-obligation proposal with a fixed timeline and price.')}</p>
  <div class="caixa-email"><span>{EMAIL}</span><button type="button" data-copiar={EMAIL}>{T('Copiar', 'Copy')}</button></div>
  <div class="acoes" style="justify-content:center">
    <a class="btn" href={wa}>{T('Pedir orçamento no WhatsApp', 'Get a quote on WhatsApp')}</a>
    <a class="btn sec" href={pagina(L, 'portfolio/')}>{T('Ver portfólio', 'View portfolio')}</a>
  </div>
</Mural>

<Rodape />
</Base>

<script>
  import { initHome } from '../../scripts/home';
  initHome();
</script>
