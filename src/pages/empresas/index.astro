---
/* PARA EMPRESAS: serviços diretos para marcas, como funciona e perguntas frequentes.
   Textos e listas ficam nas constantes abaixo. Mesmo visual da home (src/styles/home.css e src/scripts/home.ts).
   Mensagem do WhatsApp: MENSAGENS.empresa em src/data/site.ts. */
import Base from '../../layouts/Base.astro';
import Prancheta from '../../components/novo/Prancheta.astro';
import BarraMob from '../../components/novo/BarraMob.astro';
import MenuTopo from '../../components/novo/MenuTopo.astro';
import Mural from '../../components/novo/Mural.astro';
import FundoLiquido from '../../components/novo/FundoLiquido.astro';
import { SITE, MENSAGENS, url, linkWhatsApp } from '../../data/site';
import { PROJETOS, CATEGORIAS } from '../../data/portfolio';
import '@fontsource/anton/latin-400.css';
import '@fontsource/caveat-brush/latin-400.css';
import '../../styles/home.css';

const wa = linkWhatsApp(MENSAGENS.empresa);
const DESTAQUES = PROJETOS.filter((p) => p.destaque);
const EMAIL = 'jmeninodesign@gmail.com';
const capa = (link: string) => PROJETOS.find((p) => p.link === link)?.capa ?? 'og/home.jpg';

const SERVICOS = [
  {
    titulo: 'Identidade visual',
    texto: 'Para quem está começando ou quer arrumar a casa. Uma marca com cara própria, que funciona do cartão ao Instagram.',
    itens: ['Logo e versões', 'Cores e tipografia', 'Grafismos', 'Papelaria e aplicações', 'Guia de uso da marca'],
    exemplo: { nome: 'Gois & Silva', link: 'portfolio/gois-e-silva/' },
  },
  {
    titulo: 'Campanhas e redes sociais',
    texto: 'Lançamentos, datas sazonais e o dia a dia das redes. Todas as peças falando a mesma língua.',
    itens: ['Posts e stories', 'Anúncios', 'Conceito de campanha', 'Impressos', 'Ponto de venda'],
    exemplo: { nome: 'Escalados Macarrone', link: 'portfolio/escalados-macarrone/' },
  },
  {
    titulo: 'Vídeo e motion',
    texto: 'Vídeos curtos que prendem a atenção nos primeiros segundos, com ritmo e acabamento.',
    itens: ['Reels e TikTok', 'Vídeos para anúncio', 'Motion design', 'Telão de LED', 'Cenas com IA'],
    exemplo: { nome: 'Costelinha BBQ', link: 'portfolio/macarrone-costelinha-bbq/' },
  },
  {
    titulo: 'Sites e landing pages',
    texto: 'Desenho no Figma e desenvolvo em código. Sites rápidos, que abrem bem no celular e levam o cliente até o contato.',
    itens: ['Landing pages', 'Sites institucionais', 'Interface no Figma', 'Versão para celular', 'Botão de WhatsApp'],
    exemplo: { nome: 'Omuch', link: 'portfolio/omuch/' },
  },
];

const ETAPAS = [
  { t: 'Conversa', d: 'Você me conta sobre a empresa, o que precisa e para quando. Pode ser pelo WhatsApp ou numa chamada rápida.' },
  { t: 'Proposta', d: 'Envio o que vou entregar, o prazo e o valor. Tudo fechado antes de começar, sem surpresa no meio do caminho.' },
  { t: 'Criação', d: 'Pesquiso a marca e o público e apresento o caminho criativo, explicando cada escolha.' },
  { t: 'Ajustes', d: 'Você comenta e eu refino. As rodadas de ajuste já vêm combinadas na proposta.' },
  { t: 'Entrega', d: 'Arquivos finais organizados, nos formatos que você vai usar: impressão, redes, site e vídeo.' },
];

const MOTIVOS = [
  { t: 'Direto com quem cria', d: 'Você fala comigo do começo ao fim. Sem intermediário e sem briefing perdido no caminho.' },
  { t: 'Tudo coerente', d: 'A mesma pessoa cuida da marca, das peças, do vídeo e do site. A sua empresa fica com uma cara só.' },
  { t: '13 anos de estrada', d: 'Já atendi segurança digital, automotivo, educação, alimentação e varejo, do B2B ao B2C.' },
  { t: 'Prazo é prazo', d: 'Venho do ritmo de agência: entrego no combinado, sem abrir mão do acabamento.' },
];

const PERGUNTAS = [
  { q: 'Você atende empresas de outras cidades?', r: 'Sim. Moro em Limeira/SP, mas trabalho a distância com empresas de todo o Brasil. Conversas, aprovações e entregas são todas online.' },
  { q: 'Quanto custa?', r: 'Depende do que a sua empresa precisa. Depois de uma conversa rápida eu envio uma proposta com valor fechado e o que está incluído.' },
  { q: 'Qual é o prazo?', r: 'Varia com o tamanho do projeto. Uma peça avulsa sai em poucos dias; uma identidade completa ou um site levam algumas semanas. O prazo exato vai na proposta.' },
  { q: 'Dá para fazer só uma peça ou só um vídeo?', r: 'Dá. Atendo projetos pontuais e também demandas recorrentes, como posts e vídeos todo mês.' },
  { q: 'Eu fico com os arquivos?', r: 'Sim. Na entrega você recebe os arquivos finais em todos os formatos combinados, prontos para usar.' },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Jonathan Menino · Design para empresas',
  description: 'Identidade visual, campanhas, vídeos e sites para empresas.',
  url: new URL(url('empresas/'), Astro.site).href,
  areaServed: { '@type': 'Country', name: 'Brasil' },
  availableLanguage: 'pt-BR',
  serviceType: ['Identidade visual', 'Social media', 'Edição de vídeo', 'Motion design', 'Criação de sites', 'Landing pages'],
  provider: { '@type': 'Person', name: SITE.nome, url: new URL(url(), Astro.site).href, sameAs: Object.values(SITE.redes).filter(Boolean) },
};
---
<Base
  title="Design para empresas · Jonathan Menino"
  description="Identidade visual, campanhas, vídeos e sites para a sua empresa, feitos direto com o designer. Atendo todo o Brasil a partir de Limeira/SP."
  jsonld={jsonld}
>
<Prancheta />
<BarraMob links={[['Portfólio', url('portfolio/')], ['Orçamento', '#contato']]} />

<header class="heroi" id="topo">
  <FundoLiquido />
  <MenuTopo sub="Para empresas · Todo o Brasil" itens={[['Início', url()], ['Portfólio', url('portfolio/')], ['Empresas', url('empresas/'), true], ['Agências', url('white-label/')], ['Orçamento', '#contato']]} />
  <div></div>
  <div class="base">
    <p class="selo"><span class="pulso" aria-hidden="true"></span>Orçamento sem compromisso</p>
    <div class="linha-nome">
      <p class="mao nota-mao" aria-hidden="true">↙ direto com quem cria, do briefing à entrega</p>
      <h1 class="tt nome nome-longo"><span class="l">Design para a sua</span> <span class="l">marca ser vista.</span> <span class="l"><em>E lembrada.</em></span></h1>
    </div>
    <div class="sob-nome">
      <div class="esq">
        <a class="mao desce" href="#servicos">↓ veja o que eu faço</a>
        <svg class="risco" id="risco-heroi" viewBox="0 0 600 18" preserveAspectRatio="none" aria-hidden="true"><path d="M4 12 C 120 4, 260 14, 380 8 S 560 6, 596 10"/></svg>
      </div>
      <div class="acoes">
        <a class="btn" href={wa}>Pedir orçamento no WhatsApp</a>
        <a class="btn sec" href={url('portfolio/')}>Ver portfólio <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</header>

<div class="corpo solo">
  <main>
    <section class="secao" id="servicos" aria-labelledby="t-serv">
      <h2 class="tt titulo-sec" id="t-serv">O que eu faço pela <em>sua empresa</em></h2>
      <p class="mao sub-mao">→ crio identidade visual, campanhas, vídeos e sites para empresas que querem se comunicar bem</p>
      <ul class="frentes">
        {SERVICOS.map((s, i) => (
          <li>
            <a href={url(s.exemplo.link)} data-previa={url(capa(s.exemplo.link))}><h3 class="tt"><span class="num">0{i + 1}</span>{s.titulo}</h3></a>
            <p class="txt">{s.texto}</p>
            <div class="tags mono">{s.itens.map((x) => <span>{x}</span>)}</div>
            <a class="mao ex" href={url(s.exemplo.link)}>→ ver {s.exemplo.nome}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="secao" id="como" aria-labelledby="t-como">
      <div class="cab"><h2 class="tt" id="t-como">Como <em>funciona</em></h2><p class="mao">→ tudo combinado antes de começar</p></div>
      <ol class="linha-tempo cinco">
        {ETAPAS.map((e, i) => <li><span class="ano">0{i + 1}</span><h3>{e.t}</h3><p>{e.d}</p></li>)}
      </ol>
    </section>

    <section class="secao" aria-labelledby="t-por">
      <h2 class="tt titulo-sec" id="t-por">Por que <em>comigo</em></h2>
      <svg class="risco" viewBox="0 0 600 18" preserveAspectRatio="none" aria-hidden="true" style="width:min(100%,520px);height:14px;margin-top:10px;color:var(--lilas)"><path d="M4 10 C 140 15, 300 3, 450 9 S 570 12, 596 7"/></svg>
      <ul class="motivos">
        {MOTIVOS.map((m) => <li><h3 class="tt">{m.t}</h3><p>{m.d}</p></li>)}
      </ul>
    </section>

    <section class="secao" id="trabalhos" aria-labelledby="t-trab">
      <div class="cab"><h2 class="tt" id="t-trab">Alguns <em>projetos</em></h2><p class="mao">→ arraste para o lado</p></div>
      <div class="trilho-area" id="trilho-area"><div class="trilho" id="trilho">
        {DESTAQUES.map((p) => (
          <a class="card" href={url(p.link)} draggable="false">
            <div class="foto"><img src={url(p.capa)} alt={`Capa do projeto ${p.titulo}`} width="1200" height="630" loading="lazy" draggable="false"></div>
            <div class="meta"><div><h3 class="tt">{p.titulo}</h3><p class="cli">{p.cliente}</p></div><span class="mono tag">{CATEGORIAS[p.categorias[0]]}</span></div>
          </a>
        ))}
      </div></div>
      <div class="trilho-pe"><div class="barra"><i id="barra"></i></div><a class="mono" href={url('portfolio/')}>Ver todos os projetos →</a></div>
    </section>

    <section class="secao" aria-labelledby="t-faq">
      <h2 class="tt titulo-sec" id="t-faq">Perguntas <em>frequentes</em></h2>
      <div class="faq">
        {PERGUNTAS.map((p) => (
          <details>
            <summary>{p.q}</summary>
            <p>{p.r}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="pergunta" aria-labelledby="t-perg">
      <h2 class="tt" id="t-perg">Vamos tirar a sua ideia<br><em>do papel?</em></h2>
    </section>
  </main>
</div>

<Mural titulo="Pedir orçamento">
  <h2 class="tt"><em>Me conta</em> o que você precisa</h2>
  <svg class="risco" viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true"><path d="M3 7 C 90 3, 180 10, 297 6"/></svg>
  <p class="txt">Respondo rápido e envio uma proposta sem compromisso, com prazo e valor fechados.</p>
  <div class="caixa-email"><span>{EMAIL}</span><button type="button" data-copiar={EMAIL}>Copiar</button></div>
  <div class="acoes" style="justify-content:center">
    <a class="btn" href={wa}>Pedir orçamento no WhatsApp</a>
    <a class="btn sec" href={url('portfolio/')}>Ver portfólio</a>
  </div>
</Mural>

<footer class="rodape">
  <span>© {new Date().getFullYear()} Jonathan Menino</span>
  <span><a href={url()}>Início</a> · <a href={url('white-label/')}>Para agências</a></span>
</footer>
</Base>

<script>
  import { initHome } from '../../scripts/home';
  initHome();
</script>
