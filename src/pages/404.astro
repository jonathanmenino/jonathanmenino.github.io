---
// Página para endereços que não existem (o GitHub Pages usa o 404.html gerado daqui).
import Base from '../layouts/Base.astro';
import Fox from '../components/Fox.astro';
import { url } from '../data/site';
---
<Base title="Página não encontrada · Jonathan Menino" description="Esta página não existe. Volte para o início do site de Jonathan Menino.">
  <meta slot="head" name="robots" content="noindex">
  <main class="grid min-h-[100dvh] place-items-center bg-ink px-5 text-center text-white">
    <div>
      <Fox cor="#9B7BFF" class="mx-auto h-14 w-auto" />
      <p class="mt-8 font-mono text-xs uppercase tracking-[.14em] text-white/60">Erro 404</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">Esta página não existe.</h1>
      <p class="mt-4 text-white/70">O endereço pode ter mudado ou foi digitado errado.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={url()} class="rounded-full bg-brand px-6 py-3.5 text-sm font-semibold transition hover:bg-brand-dark">Ir para o início</a>
        <a href={url('white-label/')} class="rounded-full border border-white/20 px-6 py-3.5 text-sm font-semibold transition hover:border-white/50">White Label para agências</a>
      </div>
    </div>
  </main>
</Base>
