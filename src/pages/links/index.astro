---
/* LINKS DA BIO (Instagram @devmenino): https://jonathanmenino.github.io/links/
   Página curta, pensada para o celular: foto, os caminhos principais do site, o artigo mais novo do blog
   (atualiza sozinho) e as redes. Sem o topo completo de propósito: quem chega aqui só escolhe um link.
   Os links levam ?utm_source=instagram para aparecer separado no Clarity.
   Não linkar /white-label/parceiros/ (valores de parceiro). Só em português. */
import Base from '../../layouts/Base.astro';
import Fox from '../../components/Fox.astro';
import { Image } from 'astro:assets';
import foto from '../../assets/sobre/jonathan.png';
import { SITE, linkWhatsApp, url } from '../../data/site';
import { artigos } from '../../data/blog';

const origem = (caminho: string) => `${url(caminho)}?utm_source=instagram&utm_medium=bio`;
const [novo] = await artigos();
const whats = linkWhatsApp('Olá, Jonathan! Vi seu Instagram e quero conversar sobre um projeto.');

const LINKS = [
  { titulo: 'Quero um site ou uma marca', dica: 'Para empresas e negócios', href: origem('empresas/'), icone: 'loja' },
  { titulo: 'Sou agência: White Label', dica: 'Sites com a sua marca, feitos por mim', href: origem('white-label/'), icone: 'agencia' },
  { titulo: 'Portfólio', dica: 'Marcas, vídeos e sites que fiz', href: origem('portfolio/'), icone: 'grade' },
  { titulo: 'Blog', dica: 'Sites, Google e IA sem enrolação', href: origem('blog/'), icone: 'artigo' },
  { titulo: 'Currículo', dica: 'Experiência e ferramentas', href: origem('curriculo/'), icone: 'doc' },
];

const ICONES: Record<string, string> = {
  loja: '<path d="M3 9.5 4.5 4h15L21 9.5M3 9.5h18M3 9.5a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0M5 12v8h14v-8M10 20v-5h4v5"/>',
  agencia: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4M7 9l2.5 2.5L7 14M12 14h4"/>',
  grade: '<rect x="3" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5"/>',
  artigo: '<path d="M5 3h10l4 4v14H5z"/><path d="M15 3v4h4M8 12h8M8 16h8M8 8h4"/>',
  doc: '<circle cx="12" cy="8" r="3.5"/><path d="M5 21a7 7 0 0 1 14 0"/>',
};

const REDES: { nome: string; usuario: string; href: string; icone: string }[] = [
  { nome: 'LinkedIn', usuario: 'in/jonathanmenino', href: SITE.redes.linkedin, icone: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>' },
  { nome: 'Instagram', usuario: '@devmenino', href: SITE.redes.instagram, icone: '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/>' },
  { nome: 'Behance', usuario: 'jonathanmenino', href: SITE.redes.behance, icone: '<text x="12" y="17.2" text-anchor="middle" font-family="Inter, sans-serif" font-size="15" font-weight="800" fill="currentColor" stroke="none">Bē</text>' },
  { nome: 'GitHub', usuario: 'jonathanmenino', href: SITE.redes.github, icone: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>' },
].filter((r) => r.href);

const seta = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---
<Base
  title="Links · Jonathan Menino"
  description="Sites, marcas e vídeos. Todos os links do Jonathan Menino: WhatsApp, portfólio, serviços para empresas e agências, blog e redes."
  themeColor="#F7F6F3"
  soPortugues
>
  <main class="lk">
    <div class="lk-col">
      <header class="lk-perfil">
        <Image src={foto} alt="Foto de Jonathan Menino" widths={[96, 192, 288]} sizes="96px" loading="eager" fetchpriority="high" class="lk-foto" />
        <h1>Jonathan Menino</h1>
        <p class="lk-eyebrow">Design · Vídeo · Sites</p>
        <p class="lk-bio">Sites rápidos, marcas e vídeos para empresas. Desenvolvimento White Label para agências.</p>
      </header>

      <a class="lk-whats" href={whats} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1.1 2.7.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
        <span><b>Pedir orçamento no WhatsApp</b><small>Seg–Sex, 9h–18h · resposta rápida</small></span>
      </a>

      <nav aria-label="Links principais">
        <ul class="lk-lista">
          {LINKS.map((l) => (
            <li>
              <a class="lk-item" href={l.href}>
                <span class="lk-ic"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONES[l.icone]} /></span>
                <span class="lk-txt"><b>{l.titulo}</b><small>{l.dica}</small></span>
                <svg class="lk-seta" viewBox="0 0 24 24" aria-hidden="true" set:html={seta} />
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {novo && (
        <section class="lk-novo" aria-labelledby="t-novo">
          <p class="lk-rot" id="t-novo">Artigo novo no blog</p>
          <a class="lk-art" href={origem(`blog/${novo.id}/`)}>
            {novo.data.capa && <Image src={novo.data.capa} alt="" widths={[160, 320]} sizes="88px" loading="lazy" class="lk-art-capa" />}
            <span><b>{novo.data.titulo}</b><small>Ler artigo</small></span>
          </a>
        </section>
      )}

      <section aria-labelledby="t-redes">
        <p class="lk-rot" id="t-redes">Redes</p>
        <ul class="lk-redes">
          {REDES.map((r) => (
            <li>
              <a href={r.href} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={r.icone} />
                <span><b>{r.nome}</b><small>{r.usuario}</small></span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <footer class="lk-pe">
        <a href={origem('')}><Fox cor="#6E44FF" class="lk-fox" /><span>jonathanmenino.github.io</span></a>
        <p>Limeira/SP · atendo todo o Brasil</p>
      </footer>
    </div>
  </main>
</Base>

<style is:global>
  body:has(.lk) { background: #F7F6F3; }
  .lk ::selection { background: #6E44FF; color: #fff; }
  .lk { min-height: 100vh; min-height: 100dvh; color: #0B0A0D; font-family: "Inter Variable", Inter, ui-sans-serif, system-ui, sans-serif;
    background: radial-gradient(120% 60% at 50% -10%, #EEE9FF 0%, rgb(238 233 255 / 0) 60%), #F7F6F3;
    padding: calc(env(safe-area-inset-top, 0px) + 40px) max(16px, env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + 32px) max(16px, env(safe-area-inset-left, 0px)); }
  .lk-col { max-width: 480px; margin: 0 auto; display: grid; gap: 14px; }
  .lk svg { display: block; }

  .lk-perfil { text-align: center; margin-bottom: 10px; }
  .lk-foto { width: 96px; height: 96px; border-radius: 999px; object-fit: cover; margin: 0 auto; box-shadow: 0 0 0 3px #F7F6F3, 0 0 0 5px #6E44FF; }
  .lk-perfil h1 { margin: 18px 0 0; font-size: 24px; font-weight: 700; letter-spacing: -.02em; line-height: 1.15; }
  .lk-eyebrow { margin: 8px 0 0; font: 500 11px/1 "JetBrains Mono", ui-monospace, monospace; text-transform: uppercase; letter-spacing: .14em; color: #5A30EE; }
  .lk-bio { margin: 12px auto 0; max-width: 340px; font-size: 15px; line-height: 1.5; color: #57545C; }

  .lk a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }
  .lk a:focus-visible { outline: 2px solid #6E44FF; outline-offset: 3px; }

  .lk-whats { display: flex; align-items: center; gap: 14px; padding: 16px 20px; border-radius: 18px; background: #6E44FF; color: #fff !important; box-shadow: 0 10px 24px -12px rgb(110 68 255 / .7); transition: background-color .2s, transform .2s; }
  .lk-whats:hover { background: #5A30EE; }
  .lk-whats:active { transform: scale(.98); }
  .lk-whats svg { width: 28px; height: 28px; flex-shrink: 0; }
  .lk-whats b { display: block; font-size: 16px; font-weight: 600; }
  .lk-whats small { display: block; margin-top: 3px; font-size: 12.5px; color: rgb(255 255 255 / .8); }

  .lk-lista, .lk-redes { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .lk-item { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 16px; background: #fff; border: 1px solid rgb(0 0 0 / .07); transition: border-color .2s, transform .2s, box-shadow .2s; }
  .lk-item:hover { border-color: #6E44FF; box-shadow: 0 6px 20px -14px rgb(110 68 255 / .8); }
  .lk-item:active, .lk-art:active, .lk-redes a:active { transform: scale(.98); }
  .lk-ic { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: #EEE9FF; color: #5A30EE; flex-shrink: 0; }
  .lk-ic svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .lk-txt { flex: 1; min-width: 0; }
  .lk-txt b { display: block; font-size: 15.5px; font-weight: 600; letter-spacing: -.01em; }
  .lk-txt small { display: block; margin-top: 2px; font-size: 13px; color: #6B6870; }
  .lk-seta { width: 18px; height: 18px; flex-shrink: 0; fill: none; stroke: #6E44FF; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform .2s; }
  .lk-item:hover .lk-seta { transform: translateX(3px); }

  .lk-rot { margin: 14px 0 10px; font: 500 10.5px/1 "JetBrains Mono", ui-monospace, monospace; text-transform: uppercase; letter-spacing: .12em; color: #6B6870; }
  .lk-art { display: flex; align-items: center; gap: 14px; padding: 10px; padding-right: 16px; border-radius: 16px; background: #0B0A0D; color: #F3F1F7 !important; transition: transform .2s; }
  .lk-art-capa { width: 88px; height: 88px; border-radius: 10px; object-fit: cover; flex-shrink: 0; }
  .lk-art b { display: block; font-size: 14.5px; font-weight: 600; line-height: 1.35; }
  .lk-art small { display: inline-block; margin-top: 8px; font: 500 11px/1 "JetBrains Mono", ui-monospace, monospace; text-transform: uppercase; letter-spacing: .1em; color: #B79CFF; }

  .lk-redes { grid-template-columns: 1fr 1fr; }
  .lk-redes a { display: flex; align-items: center; gap: 10px; padding: 12px; border-radius: 14px; background: #fff; border: 1px solid rgb(0 0 0 / .07); transition: border-color .2s, transform .2s; }
  .lk-redes a:hover { border-color: #6E44FF; }
  .lk-redes svg { width: 20px; height: 20px; flex-shrink: 0; fill: none; stroke: #0B0A0D; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; color: #0B0A0D; }
  .lk-redes span { min-width: 0; }
  .lk-redes b { display: block; font-size: 14px; font-weight: 600; }
  .lk-redes small { display: block; margin-top: 1px; font-size: 11.5px; color: #6B6870; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .lk-pe { margin-top: 22px; text-align: center; font-size: 12.5px; color: #6B6870; }
  .lk-pe a { display: inline-flex; align-items: center; gap: 8px; font: 500 12px/1 "JetBrains Mono", ui-monospace, monospace; color: #0B0A0D; }
  .lk-fox { height: 22px; width: auto; }
  .lk-pe p { margin: 10px 0 0; }

  @media (prefers-reduced-motion: reduce) { .lk * { transition: none !important; } }
</style>
