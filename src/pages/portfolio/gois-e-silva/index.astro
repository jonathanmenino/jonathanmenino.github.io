<style is:global>

/* Layout: manual de marca em faixas alternadas marfim e azul; uma coluna de leitura, grades para as versões. Visual único (claro), cores fixas. */
.gs { --azul:#17375F; --ouro:#C9A95C; --ouro2:#E6CF8E; --marfim:#F6F1E7; --grafite:#1F2329; --linha:#E3DACA; --suave:#5B5E66;
  --serif:'Cormorant Garamond', Garamond, 'Times New Roman', serif; --sans:'Lato', 'Helvetica Neue', Arial, sans-serif; color-scheme: light; }
.gs { background:var(--marfim); color:var(--grafite); font-family:var(--sans); font-size:16px; line-height:1.6; }
.gs *{box-sizing:border-box}
.gs .faixa { padding-block: clamp(56px,9vw,104px); }
.gs .faixa.azul { background:var(--azul); color:#fff; }
.gs .faixa.branca { background:#fff; }
.gs .w { max-width:1120px; margin:0 auto; padding-left:max(16px,env(safe-area-inset-left,0px)); padding-right:max(16px,env(safe-area-inset-right,0px)); }
.gs .rot { font-size:12px; font-weight:700; letter-spacing:.22em; text-transform:uppercase; color:var(--ouro); margin:0; }
.gs h1, .gs h2, .gs h3 { font-family:var(--serif); font-weight:600; line-height:1.05; text-wrap:balance; margin:0; }
.gs h1 { font-size:clamp(44px,7vw,84px); }
.gs h2 { font-size:clamp(34px,4.6vw,54px); margin-top:14px; color:var(--azul); }
.gs .azul h2 { color:#fff; }
.gs h3 { font-size:24px; color:var(--azul); }
.gs .azul h3 { color:#fff; }
.gs p.intro { max-width:62ch; margin:18px 0 0; color:var(--suave); font-size:17px; }
.gs .azul p.intro { color:rgba(255,255,255,.78); }
.gs .topo { display:grid; gap:40px; align-items:center; }
@media (min-width:860px){ .gs .topo { grid-template-columns:1.1fr 1fr; } }
.gs .topo .lk { width:100%; max-width:440px; justify-self:center; }
.gs .ficha { display:flex; flex-wrap:wrap; gap:10px 28px; margin-top:28px; font-size:14px; color:rgba(255,255,255,.8); }
.gs .ficha b { display:block; font-size:11px; letter-spacing:.18em; text-transform:uppercase; color:var(--ouro2); }
.gs .ad { display:grid; gap:20px; margin-top:40px; }
@media (min-width:760px){ .gs .ad { grid-template-columns:1fr 1fr; } }
.gs .ad figure { margin:0; }
.gs .ad .cx { aspect-ratio:1; border-radius:6px; overflow:hidden; display:grid; place-items:center; background:var(--azul); }
.gs .ad img { width:100%; height:100%; object-fit:cover; display:block; }
.gs .ad .cx .lk { width:78%; }
.gs figcaption { margin-top:10px; font-size:13px; color:var(--suave); }
.gs figcaption b { color:var(--grafite); }
.gs .mud { list-style:none; padding:0; margin:32px 0 0; display:grid; gap:14px 32px; }
@media (min-width:760px){ .gs .mud { grid-template-columns:1fr 1fr; } }
.gs .mud li { padding-top:14px; border-top:1px solid var(--linha); font-size:15px; }
.gs .mud b { display:block; font-family:var(--serif); font-size:21px; color:var(--azul); font-weight:600; }
.gs .dois { display:grid; gap:32px; margin-top:40px; align-items:center; }
@media (min-width:860px){ .gs .dois { grid-template-columns:1fr 1fr; gap:56px; } }
.gs .constr { width:100%; max-width:420px; background:#fff; border:1px solid var(--linha); }
.gs .sym { display:block; }
.gs .notas { list-style:none; padding:0; margin:0; display:grid; gap:18px; }
.gs .notas li { font-size:15px; color:var(--suave); }
.gs .notas b { display:block; color:var(--grafite); font-size:16px; }
