---
/* CASE DE CAMPANHA: Escalados Macarrone (Macarrone in Box, Copa do Mundo 2026).
   A página usa a identidade da própria campanha (verde, amarelo, branco e Poppins).
   Ainda não está linkada em nenhum lugar: quando a seção Portfólio existir,
   troque o link "Portfólio" do topo e do rodapé (const portfolio). */
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Fox from '../../../components/Fox.astro';
import { url } from '../../../data/site';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-800.css';

import logo from '../../../assets/portfolio/escalados-macarrone/logo.png';
import keyVisual from '../../../assets/portfolio/escalados-macarrone/key-visual.jpg';
import aGolacooo from '../../../assets/portfolio/escalados-macarrone/adesivos/golacooo.png';
import aPepperoni from '../../../assets/portfolio/escalados-macarrone/adesivos/pepperoni.png';
import aPeito from '../../../assets/portfolio/escalados-macarrone/adesivos/peito-de-peru.png';
import aParmigiano from '../../../assets/portfolio/escalados-macarrone/adesivos/parmigiano.png';
import aVaiBrasil from '../../../assets/portfolio/escalados-macarrone/adesivos/vai-brasil.png';
import aEscalados from '../../../assets/portfolio/escalados-macarrone/adesivos/escalados.png';
import aHexa from '../../../assets/portfolio/escalados-macarrone/adesivos/rumo-ao-hexa.png';
import aTaca from '../../../assets/portfolio/escalados-macarrone/adesivos/taca.png';
import bannerDelivery from '../../../assets/portfolio/escalados-macarrone/banner-delivery.jpg';
import landing from '../../../assets/portfolio/escalados-macarrone/landing.jpg';
import postSabores from '../../../assets/portfolio/escalados-macarrone/post-sabores.jpg';
import display from '../../../assets/portfolio/escalados-macarrone/display-a4.jpg';
import capa from '../../../assets/portfolio/escalados-macarrone/capa.jpg';
import car1 from '../../../assets/portfolio/escalados-macarrone/carrossel-01.jpg';
import car2 from '../../../assets/portfolio/escalados-macarrone/carrossel-02.jpg';
import car3 from '../../../assets/portfolio/escalados-macarrone/carrossel-03.jpg';
import car4 from '../../../assets/portfolio/escalados-macarrone/carrossel-04.jpg';
import st1 from '../../../assets/portfolio/escalados-macarrone/story-01.jpg';
import st2 from '../../../assets/portfolio/escalados-macarrone/story-02.jpg';
import st3 from '../../../assets/portfolio/escalados-macarrone/story-03.jpg';
import st4 from '../../../assets/portfolio/escalados-macarrone/story-04.jpg';
import stDisplay from '../../../assets/portfolio/escalados-macarrone/story-display.jpg';
import assinatura from '../../../assets/portfolio/escalados-macarrone/assinatura.png';
import zava from '../../../assets/agencias/zava-branco.svg';

const portfolio = url(); // TODO: trocar por url('portfolio/') quando a página existir
const video = (nome: string) => url(`portfolio/escalados-macarrone/videos/${nome}`);

const ficha = [
  ['Cliente', 'Macarrone in Box'],
  ['Ocasião', 'Copa do Mundo 2026'],
  ['Meu papel', 'Identidade da campanha, direção de arte, peças e vídeos'],
  ['Período', '12 de maio a 30 de junho'],
];

const paleta = [
  { nome: 'Verde Gramado', hex: '#0C843B', rgb: '12 132 59', uso: 'Fundo principal, campo e selos' },
  { nome: 'Amarelo Taça', hex: '#FEC302', rgb: '254 195 2', uso: 'Estrelas, "Macarrone" e chamadas' },
  { nome: 'Branco', hex: '#FFFFFF', rgb: '255 255 255', uso: 'Lettering "Escalados" e textos' },
  { nome: 'Preto', hex: '#111111', rgb: '17 17 17', uso: 'Fundo da landing e textos longos' },
];

const pratos = [
  { nome: 'Parmigiano', massa: 'Penne', texto: 'Molho cremoso de parmesão, frango grelhado e alho frito.', img: car2 },
  { nome: 'Peito de Peru', massa: 'Penne', texto: 'Requeijão cremoso da casa, peito de peru defumado e ervilhas.', img: car3 },
  { nome: 'Pepperoni', massa: 'Caracol', texto: 'Provolone defumado, parmesão fresco e pepperoni italiano.', img: car4 },
];

const grupos = [
  {
    titulo: 'Chamadas da campanha',
    texto: 'Vídeos de lançamento que apresentam os escalados, o sorteio e onde pedir.',
    videos: [
      { arquivo: 'chamada-oficial', legenda: 'Chamada oficial' },
      { arquivo: 'chamada-chef', legenda: 'Chamada com o chef' },
      { arquivo: 'chamada-carro', legenda: 'Chamada com creator' },
    ],
  },
  {
    titulo: 'Reels com creators',
    texto: 'O chef e a creator provando cada sabor, com a marca da campanha nas legendas e no prato.',
    videos: [
      { arquivo: 'chef-parmigiano', legenda: 'Chef · Parmigiano' },
      { arquivo: 'lari-parmigiano', legenda: 'Creator · Parmigiano' },
    ],
  },
  {
    titulo: 'Trends',
    texto: 'Formatos curtos de tendência para alcance orgânico.',
    videos: [
      { arquivo: 'trend-sabores', legenda: 'Trend dos sabores' },
      { arquivo: 'trend-nome', legenda: 'Trend do nome do prato' },
    ],
  },
  {
    titulo: 'Vídeos para tráfego pago',
    texto: 'Close no prato e na box, com nome do sabor, descrição e "Peça agora". Um por sabor.',
    videos: [
      { arquivo: 'box-parmigiano', legenda: 'Box Parmigiano' },
      { arquivo: 'box-peito-de-peru', legenda: 'Box Peito de Peru' },
      { arquivo: 'box-pepperoni', legenda: 'Box Pepperoni' },
    ],
  },
];

const adesivos = [
  { img: aVaiBrasil, nome: 'Vai Brasil', r: -6 },
  { img: aGolacooo, nome: 'Golaçooo de Sabor', r: 4 },
  { img: aHexa, nome: 'Rumo ao Hexa', r: -3 },
  { img: aTaca, nome: 'A Taça do Mundo é Nossa', r: 5 },
  { img: aEscalados, nome: 'Escalados Macarrone', r: 0 },
  { img: aParmigiano, nome: 'Etiqueta Parmigiano', r: -4 },
  { img: aPeito, nome: 'Etiqueta Petto di Tacchino', r: 3 },
  { img: aPepperoni, nome: 'Etiqueta Pepperoni', r: -2 },
];

// Adesivos flutuando pela página (decorativos). pos: posição no CSS; w: largura; v: velocidade do parallax.
type Flutua = { img: ImageMetadata; pos: string; w: string; r: number; v: number; d?: number; desk?: boolean };
const flutuam: Record<string, Flutua[]> = {
  hero: [
    { img: aVaiBrasil, pos: 'top:5%;right:2%', w: 'clamp(84px,11vw,150px)', r: 10, v: -0.06, desk: true },
    { img: aHexa, pos: 'bottom:4%;left:47%', w: 'clamp(90px,10vw,140px)', r: -12, v: 0.05, d: 1.5, desk: true },
  ],
  desafio: [{ img: aGolacooo, pos: 'bottom:24px;right:-36px', w: 'clamp(120px,14vw,200px)', r: 12, v: -0.08 }],
  time: [{ img: aTaca, pos: 'top:28px;right:5%', w: 'clamp(60px,7vw,100px)', r: 14, v: -0.1, d: 0.8, desk: true }],
  redes: [{ img: aEscalados, pos: 'top:40px;right:4%', w: 'clamp(100px,12vw,180px)', r: 8, v: -0.07, desk: true }],
  videos: [
    { img: aParmigiano, pos: 'top:60px;right:4%', w: 'clamp(110px,12vw,170px)', r: -10, v: -0.06, d: 1, desk: true },
    { img: aPepperoni, pos: 'top:48%;right:-30px', w: 'clamp(110px,12vw,170px)', r: 14, v: -0.12, d: 2, desk: true },
  ],
  site: [{ img: aPeito, pos: 'bottom:40px;left:-30px', w: 'clamp(110px,12vw,170px)', r: -12, v: -0.06, desk: true }],
  pdv: [{ img: aVaiBrasil, pos: 'bottom:30px;right:4%', w: 'clamp(90px,11vw,160px)', r: -8, v: -0.08, d: 1.2, desk: true }],
};

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Escalados Macarrone',
  description: 'Campanha da Macarrone in Box para a Copa do Mundo 2026, feita para a Agência Zava.',
  creator: { '@type': 'Person', name: 'Jonathan Menino' },
  inLanguage: 'pt-BR',
};
---
<Base
  title="Escalados Macarrone · Campanha · Jonathan Menino"
  description="Campanha Escalados Macarrone para a Copa do Mundo 2026: identidade, posts, stories, vídeos, landing page e ponto de venda. Feita para a Agência Zava."
  image="og/escalados-macarrone.jpg"
  tipo="article"
  themeColor="#0C843B"
  jsonld={jsonld}
>
<div class="em">
  <header class="topo">
    <a href={portfolio} class="marca" aria-label="Jonathan Menino, portfólio">
      <Fox cor="#FEC302" class="raposa" />
      <span><span class="nome">Jonathan Menino</span><span class="sub">Portfólio</span></span>
    </a>
    <a href={portfolio} class="voltar"><span aria-hidden="true">←</span> Todos os projetos</a>
  </header>

  <main>
    <!-- ============ TOPO ============ -->
    <section class="hero gramado">
      {flutuam.hero.map((f) => <span class:list={['flutua', f.desk && 'so-desk']} data-v={f.v} style={`${f.pos};--w:${f.w};--r:${f.r}deg;--d:${f.d ?? 0}s`} aria-hidden="true"><Image src={f.img} alt="" widths={[200, 400]} sizes="180px" /></span>)}
      <div class="campo" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow">Campanha · Copa do Mundo 2026</p>
          <h1 class="sr-only">Escalados Macarrone</h1>
          <Image src={logo} alt="Logo Escalados Macarrone" widths={[600, 1200]} sizes="(min-width: 1024px) 560px, 90vw" class="hero-logo" loading="eager" fetchpriority="high" />
          <p class="lead">Três sabores exclusivos convocados para a Copa. Criei a identidade da campanha e todas as peças, do feed ao balcão da loja.</p>
          <dl class="ficha">
            {ficha.map(([r, v]) => (<div><dt>{r}</dt><dd>{v}</dd></div>))}
            <div class="agencia">
              <dt>Feito para</dt>
              <dd><Image src={zava} alt="Agência Zava" height={28} class="zava" /></dd>
            </div>
          </dl>
        </div>
        <div class="hero-arte">
          <Image src={keyVisual} alt="Key visual da campanha com os três pratos sobre um campo de futebol" widths={[480, 960]} sizes="(min-width: 1024px) 480px, 90vw" loading="eager" />
        </div>
      </div>
    </section>

    <!-- ============ DESAFIO E IDEIA ============ -->
    <section class="claro">
      {flutuam.desafio.map((f) => <span class:list={['flutua', f.desk && 'so-desk']} data-v={f.v} style={`${f.pos};--w:${f.w};--r:${f.r}deg;--d:${f.d ?? 0}s`} aria-hidden="true"><Image src={f.img} alt="" widths={[200, 400]} sizes="180px" /></span>)}
      <div class="wrap duas">
        <div>
          <p class="num">01 · O desafio</p>
          <h2>Entrar no clima da Copa sem perder o sabor da marca.</h2>
          <p>A Macarrone in Box queria lançar três pratos que só existiriam durante a Copa, com sorteio de bolas oficiais nas unidades de Americana, Piracicaba e Limeira e no delivery. A campanha precisava falar a língua da torcida e funcionar em tudo: feed, stories, reels, iFood, site e ponto de venda.</p>
        </div>
        <div>
          <p class="num">02 · A ideia</p>
          <h2>Os pratos são a seleção. Eles foram escalados.</h2>
          <p>"Escalados" trata os três sabores como o time convocado. O nome em letras de camisa de futebol divide espaço com o "Macarrone" manuscrito, que puxa a assinatura da marca. Cinco estrelas lembram os títulos do Brasil e a estrela dentro do O é a sexta: rumo ao hexa.</p>
        </div>
      </div>
    </section>

    <!-- ============ O TIME ============ -->
    <section class="escuro">
      {flutuam.time.map((f) => <span class:list={['flutua', f.desk && 'so-desk']} data-v={f.v} style={`${f.pos};--w:${f.w};--r:${f.r}deg;--d:${f.d ?? 0}s`} aria-hidden="true"><Image src={f.img} alt="" widths={[200, 400]} sizes="180px" /></span>)}
      <div class="wrap">
        <p class="num">03 · O time escalado</p>
        <h2 class="grande">Parmigiano, Peito de Peru e Pepperoni.</h2>
        <ul class="pratos">
          {pratos.map((p) => (
            <li>
              <Image src={p.img} alt={`Post do Macarrone ${p.nome}`} widths={[400, 800]} sizes="(min-width: 900px) 380px, 90vw" />
              <div class="prato-txt">
                <h3>{p.nome}</h3>
                <p class="massa">Massa {p.massa}</p>
                <p>{p.texto}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ IDENTIDADE ============ -->
    <section class="claro">
      <div class="wrap">
        <p class="num">04 · Identidade da campanha</p>
        <h2 class="grande">Um uniforme próprio para a Copa.</h2>

        <div class="logo-palco gramado">
          <Image src={logo} alt="Logo Escalados Macarrone sobre o verde da campanha" widths={[800, 1600]} sizes="(min-width: 1200px) 900px, 90vw" />
        </div>
        <ul class="anatomia">
          <li><span>★★★★★</span><p><b>Cinco estrelas</b> em arco, como o escudo da seleção.</p></li>
          <li><span>ESCALADOS</span><p><b>Lettering de camisa</b>, condensado e com letras em alturas diferentes, como uma escalação.</p></li>
          <li><Image src={assinatura} alt="Macarrone" width={300} class="script" /><p><b>Assinatura manuscrita</b> em amarelo, que mantém o laço com a marca.</p></li>
        </ul>

        <h3 class="sub-h">Paleta</h3>
        <ul class="paleta">
          {paleta.map((c) => (
            <li>
              <span class="amostra" style={`background:${c.hex}`}></span>
              <div>
                <p class="cor-nome">{c.nome}</p>
                <p class="cor-cod">{c.hex} · RGB {c.rgb}</p>
                <p class="cor-uso">{c.uso}</p>
              </div>
            </li>
          ))}
        </ul>

        <h3 class="sub-h">Tipografia</h3>
        <div class="tipo">
          <div class="tipo-aa" aria-hidden="true">Aa</div>
          <div>
            <p class="tipo-nome">Poppins</p>
            <p class="tipo-desc">Família usada só na campanha: Bold e ExtraBold nas chamadas, Regular nos textos e espaçada em caixa alta para selos como "por tempo limitado".</p>
            <p class="tipo-amostra"><b>COMPRE &amp; CONCORRA</b></p>
            <p class="tipo-esp">POR TEMPO LIMITADO</p>
            <p class="tipo-reg">Macarrone Parmigiano · Peito de Peru · Pepperoni</p>
          </div>
        </div>

        <h3 class="sub-h">Adesivos e selos</h3>
        <p class="adesivos-txt">Selos de torcida para as peças, o jogo americano e a embalagem, e uma etiqueta para cada sabor colada no prato.</p>
        <ul class="adesivos gramado">
          {adesivos.map((a) => (
            <li style={`--r:${a.r}deg`}><Image src={a.img} alt={a.nome} widths={[200, 400]} sizes="(min-width: 900px) 220px, 40vw" /></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ REDES ============ -->
    <section class="gramado secao">
      {flutuam.redes.map((f) => <span class:list={['flutua', f.desk && 'so-desk']} data-v={f.v} style={`${f.pos};--w:${f.w};--r:${f.r}deg;--d:${f.d ?? 0}s`} aria-hidden="true"><Image src={f.img} alt="" widths={[200, 400]} sizes="180px" /></span>)}
      <div class="wrap">
        <p class="num">05 · Redes sociais</p>
        <h2 class="grande">Feed e stories.</h2>
        <p class="intro">Carrossel de lançamento com o preço e um card por sabor, adaptado para stories.</p>

        <h3 class="sub-h">Feed · 1080 × 1350</h3>
        <ul class="trilho feed">
          {[car1, car2, car3, car4, postSabores].map((img, i) => (
            <li><Image src={img} alt={`Post de feed ${i + 1}`} widths={[360, 720]} sizes="320px" /></li>
          ))}
        </ul>

        <h3 class="sub-h">Stories · 1080 × 1920</h3>
        <ul class="trilho stories">
          {[capa, st1, st2, st3, st4, stDisplay].map((img, i) => (
            <li><Image src={img} alt={`Story ${i + 1}`} widths={[270, 540]} sizes="240px" /></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ VÍDEOS ============ -->
    <section class="escuro">
      {flutuam.videos.map((f) => <span class:list={['flutua', f.desk && 'so-desk']} data-v={f.v} style={`${f.pos};--w:${f.w};--r:${f.r}deg;--d:${f.d ?? 0}s`} aria-hidden="true"><Image src={f.img} alt="" widths={[200, 400]} sizes="180px" /></span>)}
      <div class="wrap">
        <p class="num">06 · Vídeos</p>
        <h2 class="grande">Reels, trends e anúncios.</h2>
        <p class="intro">Edição e motion de todos os vídeos da campanha. Toque em um vídeo para ouvir.</p>
        {grupos.map((g) => (
          <div class="grupo">
            <div class="grupo-cab">
              <h3>{g.titulo}</h3>
              <p>{g.texto}</p>
            </div>
            <ul class="trilho videos">
              {g.videos.map((v) => (
                <li>
                  <video src={video(`${v.arquivo}.mp4`)} poster={video(`${v.arquivo}.jpg`)} muted loop playsinline controls preload="none" aria-label={v.legenda}></video>
                  <p class="legenda">{v.legenda}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ SITE E DELIVERY ============ -->
    <section class="claro">
      {flutuam.site.map((f) => <span class:list={['flutua', f.desk && 'so-desk']} data-v={f.v} style={`${f.pos};--w:${f.w};--r:${f.r}deg;--d:${f.d ?? 0}s`} aria-hidden="true"><Image src={f.img} alt="" widths={[200, 400]} sizes="180px" /></span>)}
      <div class="wrap duas site">
        <div>
          <p class="num">07 · Site e delivery</p>
          <h2>Landing page do sorteio e banners para o iFood.</h2>
          <p>A página reúne os sabores, como participar, o prêmio, as unidades, o formulário de cadastro e o regulamento completo. Os banners levam a campanha para o site da marca e para o app de delivery.</p>
          <div class="banners">
            <Image src={bannerDelivery} alt="Banner horizontal para delivery" widths={[500, 850]} sizes="(min-width: 900px) 500px, 90vw" />
          </div>
        </div>
        <div class="navegador">
          <div class="nav-barra"><span></span><span></span><span></span><em>macarrone.com.br/escalados-macarrone</em></div>
          <div class="nav-rolagem" tabindex="0" aria-label="Landing page, role para ver tudo">
            <Image src={landing} alt="Landing page completa da campanha Escalados Macarrone" widths={[520, 1033]} sizes="(min-width: 900px) 520px, 90vw" />
          </div>
        </div>
      </div>
    </section>

    <!-- ============ TELAS DO SHOPPING ============ -->
    <section class="escuro">
      <div class="wrap">
        <p class="num">08 · Telas do shopping</p>
        <h2 class="grande">A campanha no corredor do shopping.</h2>
        <p class="intro">Animações para as telas dos shoppings onde ficam as lojas: um painel de LED grande e uma parede de seis TVs verticais lado a lado.</p>
        <div class="telao">
          <h3 class="telao-tit">Parede de 6 TVs verticais · 6480 × 1920</h3>
          <div class="tvs">
            <video src={video('tv-6-telas.mp4')} poster={video('tv-6-telas.jpg')} muted loop playsinline preload="none" aria-label="Animação para seis TVs verticais"></video>
            <span class="tvs-divisas" aria-hidden="true"></span>
          </div>
        </div>
        <div class="telao">
          <h3 class="telao-tit">Painel de LED · 2560 × 1280</h3>
          <div class="led">
            <video src={video('led.mp4')} poster={video('led.jpg')} muted loop playsinline preload="none" aria-label="Animação para o painel de LED"></video>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PONTO DE VENDA ============ -->
    <section class="gramado secao">
      {flutuam.pdv.map((f) => <span class:list={['flutua', f.desk && 'so-desk']} data-v={f.v} style={`${f.pos};--w:${f.w};--r:${f.r}deg;--d:${f.d ?? 0}s`} aria-hidden="true"><Image src={f.img} alt="" widths={[200, 400]} sizes="180px" /></span>)}
      <div class="wrap duas pdv">
        <div class="pdv-img">
          <Image src={display} alt="Display impresso A4 da campanha para o balcão" widths={[500, 1000]} sizes="(min-width: 900px) 460px, 90vw" />
        </div>
        <div>
          <p class="num">09 · Ponto de venda</p>
          <h2>Display A4 para o balcão.</h2>
          <p>Peça impressa para as três lojas, com os sabores, o "Compre &amp; Concorra" e as regras do sorteio no rodapé.</p>
        </div>
      </div>
    </section>

    <!-- ============ CRÉDITOS ============ -->
    <section class="escuro creditos">
      <div class="wrap">
        <p>Projeto desenvolvido para a <b>Agência Zava</b>. Cliente: <b>Macarrone in Box</b>.</p>
        <a href={portfolio} class="botao">Ver outros projetos <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</div>
</Base>

<script>
  // Vídeos tocam sem som quando aparecem na tela e pausam quando saem.
  const videos = document.querySelectorAll<HTMLVideoElement>('.em video');
  const reduzir = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduzir && 'IntersectionObserver' in window) {
    const obs = new IntersectionObserver((itens) => {
      for (const i of itens) {
        const v = i.target as HTMLVideoElement;
        if (i.isIntersecting) v.play().catch(() => {});
        else v.pause();
      }
    }, { threshold: 0.6 });
    videos.forEach((v) => obs.observe(v));
  }

  // Parallax leve nos adesivos flutuantes.
  const flutuam = [...document.querySelectorAll<HTMLElement>('.em .flutua')];
  if (!reduzir && flutuam.length) {
    let pendente = false;
    const mover = () => {
      pendente = false;
      const meio = innerHeight / 2;
      for (const f of flutuam) {
        const caixa = f.parentElement!.getBoundingClientRect();
        if (caixa.bottom < 0 || caixa.top > innerHeight) continue;
        const dist = caixa.top + caixa.height / 2 - meio;
        f.style.transform = `translate3d(0, ${(dist * Number(f.dataset.v)).toFixed(1)}px, 0)`;
      }
    };
    addEventListener('scroll', () => { if (!pendente) { pendente = true; requestAnimationFrame(mover); } }, { passive: true });
    mover();
  }
</script>

