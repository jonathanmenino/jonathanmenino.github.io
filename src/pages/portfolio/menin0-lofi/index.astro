---
/* CASE DE SITE: menin0 lo-fi (projeto musical do Jonathan).
   Apresentação enxuta de um site: topo, desafio e ideia, o site rolando no
   computador e no celular, as cenas e os bastidores.
   A página usa a identidade do próprio site: noite verde-escura, vermelho, areia,
   Heebo nos textos e a manuscrita Hertine nos títulos.
   Ainda não está linkada em nenhum lugar: quando a seção Portfólio existir,
   troque o link "Portfólio" do topo e do rodapé (const portfolio). */
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Fox from '../../../components/Fox.astro';
import { url } from '../../../data/site';
import '@fontsource/heebo/latin-400.css';
import '@fontsource/heebo/latin-500.css';
import '@fontsource/heebo/latin-700.css';
import hertine from '../../../assets/portfolio/menin0-lofi/Hertine.ttf?url';

import logo from '../../../assets/portfolio/menin0-lofi/logo.svg';
import mockup from '../../../assets/portfolio/menin0-lofi/mockup.png';
import capaBlur from '../../../assets/portfolio/menin0-lofi/blur-cover.png';
import baleia from '../../../assets/portfolio/menin0-lofi/ilustracoes/blue-whale.png';
import gato from '../../../assets/portfolio/menin0-lofi/ilustracoes/cat.png';
import cidade from '../../../assets/portfolio/menin0-lofi/cenarios/cidade.png';
import ceu from '../../../assets/portfolio/menin0-lofi/cenarios/ceu.png';
import praia from '../../../assets/portfolio/menin0-lofi/cenarios/praia.png';
import mar from '../../../assets/portfolio/menin0-lofi/cenarios/mar.png';
import siteDesktop from '../../../assets/portfolio/menin0-lofi/site-desktop.jpg';
import siteMobile from '../../../assets/portfolio/menin0-lofi/site-mobile.jpg';

const portfolio = url('portfolio/');

const links = {
  github: 'https://github.com/jonathanmenino/menin0-lofi',
  figma: 'https://www.figma.com/design/VRfx6O96uid1v8RRLesghX/menin0?node-id=57-285&t=n3tpVLtizsGxKhVr-0',
  spotify: 'https://open.spotify.com/intl-pt/artist/25aFd5MLcf5yOSRLMksbYa',
};

const ficha = [
  ['Projeto', 'menin0, meu projeto de lo-fi hip hop'],
  ['Meu papel', 'Identidade, design no Figma e desenvolvimento'],
  ['Contexto', 'Curso de HTML e CSS da Coder House'],
  ['Resultado', 'Nota máxima na avaliação final'],
];

const cenas = [
  { img: cidade, hora: 'Noite', nome: 'Cidade', secao: 'Ouça agora', texto: 'Prédios no escuro para o convite principal: escolher a plataforma e dar o play.' },
  { img: ceu, hora: 'Manhã', nome: 'Céu', secao: 'Use a música', texto: 'Céu aberto para liberar as faixas para criadores e rádios lo-fi.' },
  { img: praia, hora: 'Tarde', nome: 'Praia', secao: 'Newsletter', texto: 'Areia vista de cima, para quem quer saber do próximo lançamento.' },
  { img: mar, hora: 'Fim de tarde', nome: 'Mar', secao: 'Contato', texto: 'A onda chegando na areia fecha a página com o formulário.' },
];

// Paleta da identidade, na proporção em que aparece no guia (w = largura relativa).
const paleta = [
  { nome: 'Areia', hex: '#FFE6B5', uso: 'Fundos claros e calor das cenas de dia', w: 3.5 },
  { nome: 'Céu', hex: '#49B0ED', uso: 'Céu e mar, o lado fresco do dia', w: 3 },
  { nome: 'Vinil', hex: '#DB3E51', uso: 'Destaques, traço dos títulos e botões', w: 1 },
  { nome: 'Musgo', hex: '#2B3F3D', uso: 'Superfícies escuras e detalhes', w: 1 },
  { nome: 'Névoa', hex: '#F3FEFB', uso: 'Textos sobre o escuro e caixas claras', w: 1 },
  { nome: 'Noite', hex: '#152524', uso: 'Fundo base da marca', w: 0 },
];

// Personagens flutuando pela página (decorativos). pos: posição no CSS; w: largura; v: velocidade do parallax.
type Flutua = { img: ImageMetadata; pos: string; w: string; r: number; v: number; d?: number; desk?: boolean };
const flutuam: Record<string, Flutua[]> = {
  ideia: [{ img: baleia, pos: 'bottom:24px;right:-40px', w: 'clamp(130px,16vw,230px)', r: -6, v: -0.08, desk: true }],
  cenas: [{ img: gato, pos: 'top:56px;right:4%', w: 'clamp(110px,11vw,160px)', r: 8, v: -0.06, d: 1, desk: true }],
};

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'menin0 · Lo-fi Hip Hop',
  description: 'Site do menin0, projeto de lo-fi hip hop de Jonathan Menino: design no Figma e desenvolvimento em HTML e CSS.',
  creator: { '@type': 'Person', name: 'Jonathan Menino' },
  inLanguage: 'pt-BR',
};
---
<Base
  title="menin0 · Site de artista lo-fi · Jonathan Menino"
  description="Site do menin0, meu projeto de lo-fi hip hop: uma página que atravessa um dia, da cidade à noite até o mar. Identidade, design no Figma e desenvolvimento em HTML e CSS."
  image="og/menin0-lofi.jpg"
  tipo="article"
  themeColor="#0E1918"
  jsonld={jsonld}
>
<Fragment slot="head">
  <link rel="preload" href={hertine} as="font" type="font/ttf" crossorigin />
  <Fragment set:html={`<style>@font-face{font-family:'Hertine';src:url("${hertine}") format("truetype");font-display:swap}</style>`} />
</Fragment>
<div class="mn">
  <header class="topo">
    <a href={portfolio} class="marca" aria-label="Jonathan Menino, portfólio">
      <Fox cor="#DB3E51" class="raposa" />
      <span><span class="nome">Jonathan Menino</span><span class="sub">Portfólio</span></span>
    </a>
    <a href={portfolio} class="voltar"><span aria-hidden="true">←</span> Todos os projetos</a>
  </header>

  <main>
    <!-- ============ TOPO ============ -->
    <section class="hero">
      <div class="hero-luz" aria-hidden="true"><Image src={capaBlur} alt="" widths={[900]} sizes="100vw" loading="eager" /></div>
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow">Site · Artista de lo-fi hip hop</p>
          <h1 class="sr-only">menin0</h1>
          <Image src={logo} alt="Logo menin0, escrito à mão" class="hero-logo" loading="eager" />
          <p class="lead">Um site para o meu projeto musical que atravessa um dia inteiro: começa na cidade à noite, sobe para o céu, desce na praia e termina no mar. Do jeito que uma playlist lo-fi acompanha o dia.</p>
          <dl class="ficha">
            {ficha.map(([r, v]) => (<div><dt>{r}</dt><dd>{v}</dd></div>))}
          </dl>
          <div class="hero-links">
            <a class="botao" href={links.github} target="_blank" rel="noopener">Ver o código <span aria-hidden="true">↗</span></a>
            <a class="botao fantasma" href={links.figma} target="_blank" rel="noopener">Ver no Figma <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="hero-arte">
          <Image src={mockup} alt="O site do menin0 aberto em um iPad e em um iPhone" widths={[560, 888]} sizes="(min-width: 1024px) 560px, 92vw" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </section>

    <!-- ============ DESAFIO E IDEIA ============ -->
    <section class="areia">
      {flutuam.ideia.map((f) => <span class:list={['flutua', f.desk && 'so-desk']} data-v={f.v} style={`${f.pos};--w:${f.w};--r:${f.r}deg;--d:${f.d ?? 0}s`} aria-hidden="true"><Image src={f.img} alt="" widths={[240, 480]} sizes="220px" /></span>)}
      <div class="wrap duas">
        <div>
          <p class="num">01 · O desafio</p>
          <h2>Dar uma casa para a música fora das plataformas.</h2>
          <p>As faixas do menin0 estão espalhadas por Spotify, Apple Music, YouTube, Amazon e Deezer. O site precisava juntar tudo em um lugar só e ainda abrir espaço para o que as plataformas não fazem: liberar a música para criadores, receber apoio, captar e-mails e falar comigo.</p>
        </div>
        <div>
          <p class="num">02 · A ideia</p>
          <h2>Rolar a página é passar o dia ouvindo lo-fi.</h2>
          <p>Cada seção ganhou uma cena ilustrada, da noite ao fim de tarde, e um bichinho que respira devagar no seu canto. Os títulos são manuscritos, como o logo, e as caixas brancas translúcidas deixam a cena aparecer por trás do texto. A estética é de propósito um pouco crua, como o próprio gênero.</p>
        </div>
      </div>
    </section>

    <!-- ============ IDENTIDADE ============ -->
    <section class="noite identidade">
      <div class="wrap">
        <p class="num">03 · Identidade</p>
        <h2 class="script">A marca do menin0</h2>
        <p class="intro">Também criei a identidade do projeto: o logo escrito à mão, a paleta e o par de fontes que o site usa.</p>

        <div class="ident-grid">
          <div class="logo-palco">
            <Image src={logo} alt="Logo menin0, escrito à mão" class="logo-grande" />
          </div>
          <div class="logo-txt">
            <h3>Logo</h3>
            <p>Um "menin0" escrito à mão, em traço contínuo, com o zero no lugar do "o" final. Solto e um pouco irregular, como um beat lo-fi.</p>
          </div>
        </div>

        <h3 class="sub-h">Paleta</h3>
        <div class="paleta-barra" role="img" aria-label="Paleta: Areia, Céu, Vinil, Musgo e Névoa sobre o fundo Noite">
          {paleta.filter((c) => c.w > 0 && c.nome !== 'Névoa').map((c) => (
            c.nome === 'Musgo'
              ? <div class="par" style={`flex:${c.w}`}><span style={`background:${c.hex}`}></span><span style="background:#F3FEFB"></span></div>
              : <span style={`flex:${c.w};background:${c.hex}`}></span>
          ))}
        </div>
        <ul class="paleta">
          {paleta.map((c) => (
            <li>
              <span class="amostra" style={`background:${c.hex}`}></span>
              <div>
                <p class="cor-nome">{c.nome}</p>
                <p class="cor-cod">{c.hex}</p>
                <p class="cor-uso">{c.uso}</p>
              </div>
            </li>
          ))}
        </ul>

        <h3 class="sub-h">Tipografia</h3>
        <div class="tipos">
          <div class="tipo">
            <p class="tipo-aa script-aa" aria-hidden="true">Aa</p>
            <p class="tipo-nome">Hertine</p>
            <p class="tipo-desc">Manuscrita nos títulos das seções, conversando com o logo.</p>
            <p class="tipo-amostra script-aa">Listen now</p>
          </div>
          <div class="tipo">
            <p class="tipo-aa" aria-hidden="true">Aa</p>
            <p class="tipo-nome">Heebo</p>
            <p class="tipo-desc">Sem serifa para o resto: nome do lançamento, textos, formulários e botões.</p>
            <p class="tipo-amostra"><b>Rainy Coffee</b></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ O SITE ============ -->
    <section class="noite">
      <div class="wrap">
        <p class="num">04 · O site</p>
        <h2 class="script">Role e passe o dia</h2>
        <p class="intro">A página inteira, no computador e no celular. Role dentro de cada tela.</p>
        <div class="telas">
          <div class="navegador">
            <div class="nav-barra"><span></span><span></span><span></span><em>menin0 | Lo-fi Hip Hop</em></div>
            <div class="nav-rolagem" tabindex="0" aria-label="Site no computador, role para ver tudo">
              <Image src={siteDesktop} alt="Página completa do site do menin0 no computador" widths={[720, 1440]} sizes="(min-width: 1100px) 760px, 92vw" />
            </div>
          </div>
          <div class="celular">
            <div class="cel-tela" tabindex="0" aria-label="Site no celular, role para ver tudo">
              <Image src={siteMobile} alt="Página completa do site do menin0 no celular" widths={[300, 600]} sizes="280px" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ AS CENAS ============ -->
    <section class="claro">
      {flutuam.cenas.map((f) => <span class:list={['flutua', f.desk && 'so-desk']} data-v={f.v} style={`${f.pos};--w:${f.w};--r:${f.r}deg;--d:${f.d ?? 0}s`} aria-hidden="true"><Image src={f.img} alt="" widths={[240, 480]} sizes="180px" /></span>)}
      <div class="wrap">
        <p class="num">05 · As cenas</p>
        <h2 class="script escura">Um dia em quatro cenas</h2>
        <p class="intro">Depois do lançamento mais recente no topo, cada cena sustenta uma parte do conteúdo.</p>
        <ol class="cenas">
          {cenas.map((c, i) => (
            <li>
              <div class="cena-img"><Image src={c.img} alt={`Cenário ${c.nome}`} widths={[480, 960]} sizes="(min-width: 1024px) 280px, (min-width: 640px) 45vw, 90vw" /></div>
              <p class="cena-hora">{String(i + 1).padStart(2, '0')} · {c.hora}</p>
              <h3>{c.secao}</h3>
              <p>{c.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ BASTIDORES ============ -->
    <section class="ceu-rosa">
      <div class="wrap duas">
        <div>
          <p class="num">06 · Bastidores</p>
          <h2>Do Figma para o HTML, sem framework de design.</h2>
          <p>Criei a identidade e desenhei o layout no Figma e construí a página com HTML e CSS, usando Bootstrap só no menu. O projeto foi a entrega final do curso de HTML e CSS da Coder House e recebeu a nota máxima.</p>
        </div>
        <ul class="feito">
          <li><b>Figma</b><span>Layout, cenas e responsivo</span></li>
          <li><b>HTML e CSS</b><span>Estrutura, cenas em fundo e animação dos personagens</span></li>
          <li><b>Bootstrap</b><span>Menu com versão recolhida no celular</span></li>
          <li><b>GitHub</b><span>Código aberto no repositório menin0-lofi</span></li>
        </ul>
      </div>
    </section>

    <!-- ============ CRÉDITOS ============ -->
    <section class="noite creditos">
      <div class="wrap">
        <p>Projeto pessoal. Música, design e código por <b>Jonathan Menino</b>, o menin0.</p>
        <div class="creditos-links">
          <a href={links.spotify} class="botao fantasma" target="_blank" rel="noopener">Ouvir no Spotify <span aria-hidden="true">↗</span></a>
          <a href={portfolio} class="botao">Ver outros projetos <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>
</div>
</Base>

<script>
  // Parallax leve nos personagens flutuantes.
  const reduzir = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const flutuam = [...document.querySelectorAll<HTMLElement>('.mn .flutua')];
  if (!reduzir && flutuam.length) {
    let pendente = false;
    const mover = () => {
      pendente = false;
      const meio = innerHeight / 2;
      for (const f of flutuam) {
        const caixa = f.parentElement!.getBoundingClientRect();
        if (caixa.bottom < 0 || caixa.top > innerHeight) continue;
        const dist = caixa.top + caixa.height / 2 - meio;
        f.style.transform = `translate3d(0, ${(dist * Number(f.dataset.v)).toFixed(1)}px, 0)`;
      }
    };
    addEventListener('scroll', () => { if (!pendente) { pendente = true; requestAnimationFrame(mover); } }, { passive: true });
    mover();
  }
</script>

<style is:global>
.mn {
  --noite: #0E1918; --noite-2: #15231F; --vinil: #DB3E51; --vinil-forte: #C8364A; --areia: #FFE6B5; --papel: #FBF7EF;
  font-family: Heebo, ui-sans-serif, system-ui, sans-serif;
  background: var(--noite); color: #fff; -webkit-font-smoothing: antialiased;
}
.mn * { box-sizing: border-box; }
.mn .wrap { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 20px; }
@media (min-width: 768px) { .mn .wrap { padding: 0 32px; } }
.mn .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.mn a:focus-visible, .mn [tabindex]:focus-visible { outline: 3px solid var(--vinil); outline-offset: 3px; }

/* Topo */
.mn .topo { position: sticky; top: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 20px; background: rgba(14,25,24,.9); backdrop-filter: blur(8px); border-bottom: 1px solid rgba(255,255,255,.08); }
@media (min-width: 768px) { .mn .topo { padding: 14px 32px; } }
.mn .marca { display: flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; }
.mn .raposa { height: 32px; width: auto; }
.mn .nome { display: block; font-weight: 700; font-size: 15px; line-height: 1.2; }
.mn .sub { display: block; font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.7); }
.mn .voltar { font-size: 14px; font-weight: 500; color: #fff; text-decoration: none; }
.mn .voltar:hover { color: var(--vinil); }

/* Hero: a capa desfocada vira luz de fundo, como no site */
.mn .hero { position: relative; overflow: hidden; padding: 48px 0 72px; }
@media (min-width: 1024px) { .mn .hero { padding: 72px 0 104px; } }
.mn .hero-luz { position: absolute; inset: 0; opacity: .35; }
.mn .hero-luz img { width: 100%; height: 100%; object-fit: cover; }
.mn .hero-luz::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, var(--noite) 15%, rgba(14,25,24,.55) 100%); }
.mn .hero-grid { position: relative; display: grid; gap: 40px; align-items: center; }
@media (min-width: 1024px) { .mn .hero-grid { grid-template-columns: 1fr 1.05fr; gap: 56px; } }
.mn .eyebrow { position: relative; display: inline-block; padding-bottom: 14px; font-size: 13px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.8); }
.mn .eyebrow::after, .mn .num::after { content: ""; position: absolute; left: 0; bottom: 0; width: 32px; height: 4px; background: var(--vinil); }
.mn .hero-logo { display: block; width: 100%; max-width: 400px; height: auto; margin-top: 32px; }
.mn .lead { margin-top: 28px; max-width: 34rem; font-size: 17px; line-height: 1.7; color: rgba(255,255,255,.88); }
@media (min-width: 768px) { .mn .lead { font-size: 19px; } }
.mn .ficha { margin: 36px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 20px 24px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.18); }
.mn .ficha dt { font-size: 11px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: rgba(255,255,255,.65); }
.mn .ficha dd { margin: 6px 0 0; font-size: 15px; font-weight: 500; line-height: 1.4; }
.mn .hero-links { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px; }
.mn .hero-arte img { display: block; width: 100%; max-width: 620px; height: auto; margin: 0 auto; border-radius: 18px; box-shadow: 0 40px 80px -30px rgba(0,0,0,.7); }

/* Botões retos, como os do site */
.mn .botao { display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px; background: var(--vinil-forte); color: #fff; font-weight: 700; font-size: 15px; text-decoration: none; transition: background-color .2s; }
.mn .botao:hover { background: #E2566A; }
.mn .botao.fantasma { background: transparent; box-shadow: inset 0 0 0 2px rgba(255,255,255,.5); }
.mn .botao.fantasma:hover { background: rgba(255,255,255,.08); }

/* Seções */
.mn main > section { position: relative; overflow: hidden; }
.mn main > section > .wrap { position: relative; z-index: 2; }
.mn .areia { background: var(--areia); color: #1b1b1b; padding: 72px 0; }
.mn .claro { background: var(--papel); color: #1b1b1b; padding: 72px 0; }
.mn .noite { background: var(--noite); color: #fff; padding: 72px 0; }
.mn .ceu-rosa { background: linear-gradient(180deg, #F9C9CF 0%, #FFE6C9 100%); color: #1b1b1b; padding: 72px 0; }
@media (min-width: 768px) { .mn .areia, .mn .claro, .mn .noite, .mn .ceu-rosa { padding: 112px 0; } }
.mn .num { position: relative; display: inline-block; padding-bottom: 12px; font-size: 12px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: #8C1F2E; }
.mn .noite .num { color: rgba(255,255,255,.85); }
.mn h2 { margin-top: 20px; font-size: clamp(1.6rem, 3.4vw, 2.25rem); font-weight: 700; line-height: 1.18; letter-spacing: -.01em; text-wrap: balance; }
.mn h2.script { font-family: Hertine, 'Brush Script MT', cursive; font-weight: 400; font-size: clamp(2.6rem, 7vw, 4.75rem); line-height: 1.2; letter-spacing: 0; }
.mn h2.script.escura { color: #1b1b1b; }
.mn .duas p:not(.num) { margin-top: 18px; line-height: 1.75; font-size: 16px; color: #3d3d3d; }
.mn .intro { margin-top: 12px; max-width: 40rem; line-height: 1.7; color: rgba(255,255,255,.8); }
.mn .claro .intro { color: #4a4a4a; }
.mn h2.script + .intro { margin-top: 20px; }
.mn .duas { display: grid; gap: 48px; }
@media (min-width: 900px) { .mn .duas { grid-template-columns: 1fr 1fr; gap: 64px; } }

/* Identidade */
.mn .identidade { border-bottom: 1px solid rgba(255,255,255,.06); }
.mn .ident-grid { margin-top: 40px; display: grid; gap: 24px; align-items: center; }
@media (min-width: 900px) { .mn .ident-grid { grid-template-columns: 1.6fr 1fr; gap: 48px; } }
.mn .logo-palco { display: grid; place-items: center; padding: clamp(48px, 9vw, 110px) 24px; background: #152524; border: 1px solid rgba(255,255,255,.08); }
.mn .logo-grande { width: 100%; max-width: 440px; height: auto; }
.mn .logo-txt h3 { font-size: 22px; font-weight: 700; }
