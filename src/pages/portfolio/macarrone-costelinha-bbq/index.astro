---
/* CASE DE CAMPANHA: Macarrone Costelinha BBQ (Macarrone in Box, lançamento de sabor, setembro de 2025).
   A página usa a identidade da própria campanha (vermelho, preto, marrom defumado, Roadhawk).
   Acumin Pro (texto da marca) é fonte da Adobe e não pode ser servida aqui: Inter entra no lugar.
   Ainda não está linkada em nenhum lugar: quando a seção Portfólio existir,
   troque o link "Portfólio" do topo e do rodapé (const portfolio). */
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Fox from '../../../components/Fox.astro';
import { url } from '../../../data/site';
import '@fontsource-variable/inter';

import logo from '../../../assets/portfolio/macarrone-costelinha-bbq/logo.png';
import logoPreto from '../../../assets/portfolio/macarrone-costelinha-bbq/logo-preto.jpg';
import logoBranco from '../../../assets/portfolio/macarrone-costelinha-bbq/logo-branco.jpg';
import logoVermelho from '../../../assets/portfolio/macarrone-costelinha-bbq/logo-vermelho.jpg';
import seloBbq from '../../../assets/portfolio/macarrone-costelinha-bbq/selo-costelinha-bbq.png';
import seloIrresistivel from '../../../assets/portfolio/macarrone-costelinha-bbq/selo-irresistivel.png';
import postPrato from '../../../assets/portfolio/macarrone-costelinha-bbq/post-prato.jpg';
import postTexas from '../../../assets/portfolio/macarrone-costelinha-bbq/post-texas.jpg';
import postLogo from '../../../assets/portfolio/macarrone-costelinha-bbq/post-logo.jpg';
import cartaz from '../../../assets/portfolio/macarrone-costelinha-bbq/cartaz-em-breve.jpg';
import stTeaser from '../../../assets/portfolio/macarrone-costelinha-bbq/story-teaser.jpg';
import stTexas from '../../../assets/portfolio/macarrone-costelinha-bbq/story-texas.jpg';
import stModelo from '../../../assets/portfolio/macarrone-costelinha-bbq/story-modelo.jpg';
import assinatura from '../../../assets/portfolio/macarrone-costelinha-bbq/assinatura.png';
import voucher from '../../../assets/portfolio/macarrone-costelinha-bbq/voucher.jpg';
import neon from '../../../assets/portfolio/macarrone-costelinha-bbq/neon.jpg';
import e16 from '../../../assets/portfolio/macarrone-costelinha-bbq/ensaio-16.jpg';
import e21 from '../../../assets/portfolio/macarrone-costelinha-bbq/ensaio-21.jpg';
import e33 from '../../../assets/portfolio/macarrone-costelinha-bbq/ensaio-33.jpg';
import e58 from '../../../assets/portfolio/macarrone-costelinha-bbq/ensaio-58.jpg';
import e59 from '../../../assets/portfolio/macarrone-costelinha-bbq/ensaio-59.jpg';
import e62 from '../../../assets/portfolio/macarrone-costelinha-bbq/ensaio-62.jpg';
import zava from '../../../assets/agencias/zava-branco.svg';

const portfolio = url(); // TODO: trocar por url('portfolio/') quando a página existir
const base = url('portfolio/macarrone-costelinha-bbq/');
const video = (nome: string) => `${base}videos/${nome}`;

const ficha = [
  ['Cliente', 'Macarrone in Box'],
  ['Ocasião', 'Lançamento do sabor Costelinha BBQ'],
  ['Meu papel', 'Conceito e identidade da campanha, direção de arte, peças e vídeos'],
  ['Período', 'Setembro de 2025'],
];

const paleta = [
  { nome: 'Vermelho Brasa', hex: '#BD0000', rgb: '189 0 0', uso: '"BBQ", tarjas, títulos e selo do Texas' },
  { nome: 'Preto Carvão', hex: '#0B0B0B', rgb: '11 11 11', uso: 'Fundo do logo, vídeos e chamadas' },
  { nome: 'Marrom Defumado', hex: '#3C2827', rgb: '60 40 39', uso: 'Fundo do cartaz e das fotos de prato' },
  { nome: 'Fumaça', hex: '#F2EFF6', rgb: '242 239 246', uso: 'Fundos claros do feed e textos sobre escuro' },
];

const outros = [
  { arquivo: 'chef', titulo: 'Chef apresentando', texto: 'O chef Andrade conta como o prato foi criado.' },
  { arquivo: 'preparo', titulo: 'Preparo', texto: 'Do fogo da panela ao prato montado, com os ingredientes na legenda.' },
  { arquivo: 'anuncio-box', titulo: 'Anúncio para tráfego pago', texto: 'Close na box de delivery, para impulsionar o pedido.' },
];

const ensaio = [
  { img: e16, alt: 'Modelo de chapéu de cowboy na loja da Macarrone in Box', classe: 'alto' },
  { img: e21, alt: 'Modelo à mesa com o prato Costelinha BBQ servido na bandeja' },
  { img: e58, alt: 'Modelo em fundo verde segurando a box e o garfo com costelinha' },
  { img: e33, alt: 'Modelo apresentando o prato na loja' },
  { img: e59, alt: 'Modelo em fundo verde provando o Costelinha BBQ' },
  { img: e62, alt: 'Modelo em fundo verde sorrindo com a box' },
];

// Selos flutuando pela página (decorativos). pos: posição no CSS; w: largura; v: velocidade do parallax.
type Flutua = { img: ImageMetadata; pos: string; w: string; r: number; v: number; d?: number; desk?: boolean };
const flutuam: Record<string, Flutua[]> = {
  desafio: [{ img: seloIrresistivel, pos: 'top:36px;right:-24px', w: 'clamp(130px,15vw,220px)', r: -8, v: -0.08, desk: true }],
  prelanc: [{ img: seloBbq, pos: 'top:48px;right:3%', w: 'clamp(90px,10vw,150px)', r: 8, v: -0.07, desk: true }],
  videos: [{ img: seloIrresistivel, pos: 'top:70px;right:3%', w: 'clamp(140px,14vw,220px)', r: 6, v: -0.06, d: 1.2, desk: true }],
  ensaio: [{ img: seloBbq, pos: 'top:48px;right:4%', w: 'clamp(90px,10vw,150px)', r: -10, v: -0.08, d: 0.6, desk: true }],
};

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Macarrone Costelinha BBQ',
  description: 'Campanha de lançamento do sabor Costelinha BBQ da Macarrone in Box, feita para a Agência Zava.',
  creator: { '@type': 'Person', name: 'Jonathan Menino' },
  dateCreated: '2025-09',
  inLanguage: 'pt-BR',
};
---
<Base
  title="Macarrone Costelinha BBQ · Campanha · Jonathan Menino"
  description="Campanha de lançamento do Costelinha BBQ da Macarrone in Box, inspirada no Texas: identidade, teaser, cartaz, posts, stories, vídeo oficial com chroma key e ensaio. Feita para a Agência Zava."
  image="og/macarrone-costelinha-bbq.jpg"
  tipo="article"
  themeColor="#0B0B0B"
  jsonld={jsonld}
>
<div class="bbq">
  <header class="topo">
    <a href={portfolio} class="marca" aria-label="Jonathan Menino, portfólio">
      <Fox cor="#FF2A2A" class="raposa" />
      <span><span class="nome">Jonathan Menino</span><span class="sub">Portfólio</span></span>
    </a>
    <a href={portfolio} class="voltar"><span aria-hidden="true">←</span> Todos os projetos</a>
  </header>

  <main>
    <!-- ============ TOPO ============ -->
    <section class="hero brasa">
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow">Campanha · Lançamento de sabor</p>
          <h1 class="sr-only">Macarrone Costelinha BBQ</h1>
          <Image src={logo} alt="Logo Macarrone BBQ, Absolutamente Irresistível" widths={[600, 882]} sizes="(min-width: 1024px) 560px, 90vw" class="hero-logo" loading="eager" fetchpriority="high" />
          <p class="lead">Um sabor novo com sotaque texano. Criei a campanha de lançamento do Costelinha BBQ, do teaser com a data de estreia ao vídeo oficial.</p>
          <dl class="ficha">
            {ficha.map(([r, v]) => (<div><dt>{r}</dt><dd>{v}</dd></div>))}
            <div class="agencia">
              <dt>Feito para</dt>
              <dd><Image src={zava} alt="Agência Zava" height={28} class="zava" /></dd>
            </div>
          </dl>
        </div>
        <div class="hero-arte">
          <Image src={postTexas} alt="Post com o selo do Texas e o título Costelinha BBQ, Absolutamente Irresistível" widths={[480, 960]} sizes="(min-width: 1024px) 460px, 90vw" loading="eager" />
        </div>
      </div>
    </section>

    <!-- ============ DESAFIO E IDEIA ============ -->
    <section class="claro">
      {flutuam.desafio.map((f) => <span class:list={['flutua', f.desk && 'so-desk']} data-v={f.v} style={`${f.pos};--w:${f.w};--r:${f.r}deg;--d:${f.d ?? 0}s`} aria-hidden="true"><Image src={f.img} alt="" widths={[240, 480]} sizes="240px" /></span>)}
      <div class="wrap duas">
        <div>
          <p class="num">01 · O desafio</p>
          <h2>Fazer um sabor novo parecer um acontecimento.</h2>
          <p>A Macarrone in Box ia lançar o Costelinha BBQ, prato novo criado pelo chef Andrade. A campanha precisava criar expectativa antes da estreia em 12 de setembro e mostrar, em poucos segundos, que esse não era só mais um item do cardápio.</p>
        </div>
        <div>
          <p class="num">02 · A ideia</p>
          <h2>Levar o Texas para dentro da Macarrone.</h2>
          <p>O prato nasceu da culinária texana, então a campanha foi buscar lá a sua linguagem: o mapa do estado como selo, letreiros em neon, lettering de faroeste e figurino de cowboy no ensaio e no vídeo. Por cima de tudo, uma promessa curta: Absolutamente Irresistível.</p>
        </div>
      </div>
    </section>

    <!-- ============ O PRATO ============ -->
    <section class="defumado">
      <div class="wrap duas prato">
        <div class="prato-img">
          <Image src={postPrato} alt="Post do Macarrone BBQ com o prato visto de cima" widths={[480, 960]} sizes="(min-width: 900px) 480px, 90vw" />
        </div>
        <div>
          <p class="num">03 · O prato</p>
          <h2 class="grande">Costelinha BBQ.</h2>
          <p class="receita">Molho BBQ Jack preparado pelo chef Andrade, costelinha de porco cozida lentamente em vinho branco chileno, caldo de legumes e especiarias, servida desfiada como pulled pork. Vai com o molho cheddar da casa, macarrão caracolino e crispy de cebola.</p>
          <ul class="fatos">
            <li><b>12/09</b><span>Data de estreia</span></li>
            <li><b>Texas</b><span>Inspiração</span></li>
            <li><b>Chef Andrade</b><span>Receita</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ IDENTIDADE ============ -->
    <section class="claro">
      <div class="wrap">
        <p class="num">04 · Identidade da campanha</p>
        <h2 class="grande">Assinatura da casa, sotaque do Texas.</h2>

        <div class="logo-palco">
          <Image src={logo} alt="Logo Macarrone BBQ em branco e vermelho sobre preto" widths={[800, 882]} sizes="(min-width: 1200px) 860px, 90vw" />
        </div>
        <ul class="anatomia">
          <li><span><Image src={assinatura} alt="Macarrone" width={260} class="script" /></span><p><b>Assinatura manuscrita</b> da marca, que mantém o prato dentro da família Macarrone.</p></li>
          <li><span class="rh">BBQ</span><p><b>Roadhawk condensada</b>, com serifas de faroeste, como letreiro de saloon.</p></li>
          <li><span class="tarja"><i>ABSOLUTAMENTE</i><em>IRRESISTÍVEL</em></span><p><b>Slogan espaçado com tarja</b>, que vira a assinatura de todas as peças.</p></li>
        </ul>

        <h3 class="sub-h">Versões do logo</h3>
        <ul class="versoes">
          <li><Image src={logoVermelho} alt="Logo em branco e vermelho sobre preto" widths={[500, 1000]} sizes="(min-width: 900px) 360px, 90vw" /></li>
          <li><Image src={logoBranco} alt="Logo em branco sobre preto" widths={[500, 1000]} sizes="(min-width: 900px) 360px, 90vw" /></li>
          <li><Image src={logoPreto} alt="Logo em preto sobre branco" widths={[500, 1000]} sizes="(min-width: 900px) 360px, 90vw" /></li>
        </ul>

        <h3 class="sub-h">Selo do Texas e neon</h3>
        <p class="bloco-txt">Nas peças de impacto, o logo da Macarrone entra dentro do mapa do Texas com textura de carimbo, e os títulos ganham sombra em vermelho. Nos vídeos, o mesmo mapa vira um letreiro de neon.</p>
        <div class="texas">
          <div class="texas-selos brasa">
            <Image src={seloBbq} alt="Selo do Texas com Macarrone in Box e o título Costelinha BBQ" widths={[300, 600]} sizes="(min-width: 900px) 280px, 50vw" class="selo-bbq" />
            <Image src={seloIrresistivel} alt="Lettering Absolutamente Irresistível com sombra vermelha" widths={[300, 600]} sizes="(min-width: 900px) 300px, 60vw" class="selo-irr" />
          </div>
          <div class="texas-neon">
            <Image src={neon} alt="Letreiro de neon com o mapa do Texas e a palavra Macarrone" widths={[400, 720]} sizes="(min-width: 900px) 380px, 90vw" />
          </div>
        </div>

        <h3 class="sub-h">Paleta</h3>
        <ul class="paleta">
          {paleta.map((c) => (
            <li>
              <span class="amostra" style={`background:${c.hex}`}></span>
              <div>
                <p class="cor-nome">{c.nome}</p>
                <p class="cor-cod">{c.hex} · RGB {c.rgb}</p>
                <p class="cor-uso">{c.uso}</p>
              </div>
            </li>
          ))}
        </ul>

        <h3 class="sub-h">Tipografia</h3>
        <div class="tipos">
          <div class="tipo">
            <div class="tipo-aa rh" aria-hidden="true">Aa</div>
            <p class="tipo-nome">Roadhawk</p>
            <p class="tipo-desc">Títulos da campanha. Condensada e pesada, com o ar das placas de faroeste.</p>
            <p class="tipo-amostra rh">COSTELINHA BBQ</p>
          </div>
          <div class="tipo">
            <div class="tipo-aa acumin" aria-hidden="true">Aa</div>
            <p class="tipo-nome">Acumin Pro</p>
            <p class="tipo-desc">Fonte padrão da Macarrone in Box, nos textos de apoio, descrições e chamadas.</p>
            <p class="tipo-reg acumin">Toda a essência do Texas em um prato exclusivo.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PRÉ-LANÇAMENTO ============ -->
    <section class="brasa secao">
      {flutuam.prelanc.map((f) => <span class:list={['flutua', f.desk && 'so-desk']} data-v={f.v} style={`${f.pos};--w:${f.w};--r:${f.r}deg;--d:${f.d ?? 0}s`} aria-hidden="true"><Image src={f.img} alt="" widths={[200, 400]} sizes="160px" /></span>)}
      <div class="wrap">
        <p class="num">05 · Pré-lançamento</p>
        <h2 class="grande">Contagem para 12/09.</h2>
        <p class="intro">Antes da estreia, o prato apareceu só em pedaços: o fogo da panela, o neon do Texas e a data. O cartaz "Em breve" fechou o ciclo com a foto e a descrição completa, e no dia da estreia um voucher premiava quem chegasse primeiro.</p>
        <div class="prelanc">
          <div class="cartaz">
            <Image src={cartaz} alt="Cartaz Em breve na Macarrone in Box: Costelinha BBQ, disponível a partir de 12 de setembro" widths={[500, 1000]} sizes="(min-width: 900px) 460px, 90vw" />
            <p class="legenda">Cartaz "Em breve"</p>
          </div>
          <div class="prelanc-lado">
            <div>
              <Image src={stTeaser} alt="Story teaser: Absolutamente Irresistível, 12/09" widths={[270, 540]} sizes="(min-width: 900px) 240px, 44vw" />
              <p class="legenda">Story teaser</p>
            </div>
            <div>
              <video src={video('spoiler.mp4')} poster={video('spoiler.jpg')} muted loop playsinline controls preload="none" aria-label="Vídeo spoiler do Costelinha BBQ"></video>
              <p class="legenda">Vídeo spoiler</p>
            </div>
          </div>
        </div>
        <div class="voucher">
          <div class="voucher-txt">
            <h3>Voucher do dia da estreia.</h3>
            <p>Ação para o 12/09: os primeiros 15 da fila que pedissem o Costelinha BBQ ganhavam um combo de brigadeiro e Coca-Cola. O voucher segue o formato de ingresso, com o canhoto numerado.</p>
          </div>
          <Image src={voucher} alt="Voucher Você ganhou um combo brigadeiro tradicional mais Coca-Cola 220 ml comprando o Macarrone Costelinha BBQ, número 01 na fila" widths={[600, 1200, 1772]} sizes="(min-width: 900px) 700px, 92vw" class="voucher-img" />
        </div>
      </div>
    </section>

    <!-- ============ REDES ============ -->
    <section class="escuro">
      <div class="wrap">
        <p class="num">06 · Redes sociais</p>
        <h2 class="grande">Feed e stories.</h2>
        <p class="intro">Posts de lançamento com o selo do Texas, o prato e o logo, e stories com o teaser e a modelo da campanha.</p>

        <h3 class="sub-h">Feed · 1080 × 1350</h3>
        <ul class="trilho feed">
          {[
            { img: postTexas, alt: 'Post Costelinha BBQ com o selo do Texas' },
            { img: postPrato, alt: 'Post Macarrone BBQ com o prato' },
            { img: postLogo, alt: 'Post com o logo Macarrone BBQ' },
          ].map((p) => (
            <li><Image src={p.img} alt={p.alt} widths={[360, 720]} sizes="320px" /></li>
          ))}
        </ul>

        <h3 class="sub-h">Stories · 1080 × 1920</h3>
        <ul class="trilho stories">
          {[
            { img: stTeaser, alt: 'Story teaser com a data 12/09' },
            { img: stTexas, alt: 'Story Costelinha BBQ com o selo do Texas' },
            { img: stModelo, alt: 'Story com a modelo de cowboy segurando a box em cenário de faroeste' },
          ].map((s) => (
            <li><Image src={s.img} alt={s.alt} widths={[270, 540]} sizes="240px" /></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ VÍDEOS ============ -->
    <section class="defumado">
      {flutuam.videos.map((f) => <span class:list={['flutua', f.desk && 'so-desk']} data-v={f.v} style={`${f.pos};--w:${f.w};--r:${f.r}deg;--d:${f.d ?? 0}s`} aria-hidden="true"><Image src={f.img} alt="" widths={[240, 480]} sizes="220px" /></span>)}
      <div class="wrap">
        <p class="num">07 · Vídeos</p>
        <h2 class="grande">Do saloon ao delivery.</h2>
        <p class="intro">Edição e motion dos vídeos da campanha. Toque em um vídeo para ouvir.</p>

        <div class="oficial">
          <div class="oficial-video">
            <video src={video('oficial.mp4')} poster={video('oficial.jpg')} muted loop playsinline controls preload="none" aria-label="Vídeo oficial da campanha Costelinha BBQ"></video>
          </div>
          <div>
            <p class="selo-oficial">Vídeo oficial</p>
            <h3>O filme principal da campanha.</h3>
            <p>A peça mais complexa do projeto: gravação em chroma key, cenários de faroeste montados na pós, letreiros de neon animados e cenas reais na loja, costurados com os títulos da campanha.</p>
            <ul class="tags">
              <li>Chroma key</li><li>Composição de cenários</li><li>Motion e lettering</li><li>Edição</li>
            </ul>
          </div>
        </div>

        <div class="led">
          <div class="led-tela">
            <video src={video('led.mp4')} poster={video('led.jpg')} muted loop playsinline preload="none" aria-label="Animação para o telão de LED do shopping"></video>
          </div>
          <div class="led-txt">
            <h3>Telão de LED no shopping.</h3>
            <p>Versão horizontal 2:1 para o painel do shopping: o prato em close, com o logo entrando por cima. Sem som, feita para ser entendida de longe e em poucos segundos.</p>
          </div>
        </div>

        <ul class="trilho videos">
          {outros.map((v) => (
            <li>
              <video src={video(`${v.arquivo}.mp4`)} poster={video(`${v.arquivo}.jpg`)} muted loop playsinline controls preload="none" aria-label={v.titulo}></video>
              <p class="legenda">{v.titulo}</p>
              <p class="legenda-txt">{v.texto}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ ENSAIO ============ -->
    <section class="claro">
      {flutuam.ensaio.map((f) => <span class:list={['flutua', f.desk && 'so-desk']} data-v={f.v} style={`${f.pos};--w:${f.w};--r:${f.r}deg;--d:${f.d ?? 0}s`} aria-hidden="true"><Image src={f.img} alt="" widths={[200, 400]} sizes="160px" /></span>)}
      <div class="wrap">
        <p class="num">08 · Ensaio</p>
        <h2 class="grande">Cowboy na praça de alimentação.</h2>
        <p class="bloco-txt">Fotos em dois cenários: na loja, com o prato servido na bandeja, e em fundo verde, para recortar e aplicar a modelo nas peças e nos cenários do vídeo.</p>
        <ul class="ensaio">
          {ensaio.map((f) => (
            <li class={f.classe}><Image src={f.img} alt={f.alt} widths={[400, 800, 1200]} sizes="(min-width: 900px) 380px, 50vw" /></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ CRÉDITOS ============ -->
    <section class="escuro creditos">
      <div class="wrap">
        <p>Projeto desenvolvido para a <b>Agência Zava</b>. Cliente: <b>Macarrone in Box</b>.</p>
        <a href={portfolio} class="botao">Ver outros projetos <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</div>
</Base>

<script>
  // Vídeos tocam sem som quando aparecem na tela e pausam quando saem.
  const videos = document.querySelectorAll<HTMLVideoElement>('.bbq video');
  const reduzir = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduzir && 'IntersectionObserver' in window) {
    const obs = new IntersectionObserver((itens) => {
      for (const i of itens) {
        const v = i.target as HTMLVideoElement;
        if (i.isIntersecting) v.play().catch(() => {});
        else v.pause();
      }
    }, { threshold: 0.6 });
    videos.forEach((v) => obs.observe(v));
  }

  // Parallax leve nos selos flutuantes.
  const flutuam = [...document.querySelectorAll<HTMLElement>('.bbq .flutua')];
  if (!reduzir && flutuam.length) {
    let pendente = false;
    const mover = () => {
      pendente = false;
      const meio = innerHeight / 2;
      for (const f of flutuam) {
        const caixa = f.parentElement!.getBoundingClientRect();
        if (caixa.bottom < 0 || caixa.top > innerHeight) continue;
        const dist = caixa.top + caixa.height / 2 - meio;
        f.style.transform = `translate3d(0, ${(dist * Number(f.dataset.v)).toFixed(1)}px, 0)`;
      }
    };
    addEventListener('scroll', () => { if (!pendente) { pendente = true; requestAnimationFrame(mover); } }, { passive: true });
