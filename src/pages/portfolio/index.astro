---
/* PORTFÓLIO: todos os projetos com filtro por categoria.
   Projetos e categorias em src/data/portfolio.ts. O filtro funciona com ?categoria=video
   (ou sites, campanhas, identidade, ia); sem JavaScript aparecem todos.
   Visual igual ao da home (src/styles/home.css e src/scripts/home.ts). */
import Base from '../../layouts/Base.astro';
import Prancheta from '../../components/novo/Prancheta.astro';
import BarraMob from '../../components/novo/BarraMob.astro';
import MenuTopo from '../../components/novo/MenuTopo.astro';
import Mural from '../../components/novo/Mural.astro';
import '@fontsource/anton/latin-400.css';
import '@fontsource/caveat-brush/latin-400.css';
import '../../styles/home.css';
import CardProjeto from '../../components/CardProjeto.astro';
import { PROJETOS, CATEGORIAS, type Categoria } from '../../data/portfolio';
import { SITE, url, linkWhatsApp } from '../../data/site';

const contagem = (c: Categoria) => PROJETOS.filter((p) => p.categorias.includes(c)).length;
const filtros = (Object.keys(CATEGORIAS) as Categoria[]).filter((c) => contagem(c) > 0);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Portfólio · Jonathan Menino',
  author: { '@type': 'Person', name: SITE.nome },
  hasPart: PROJETOS.map((p) => ({ '@type': 'CreativeWork', name: p.titulo, url: new URL(url(p.link), Astro.site).href })),
};
---
<Base
  title="Portfólio · Jonathan Menino"
  description="Portfólio de Jonathan Menino: campanhas, identidade visual, edição de vídeo e motion, sites e projetos com IA generativa."
  jsonld={jsonld}
>
<Prancheta />
<BarraMob links={[['Início', url()], ['Contato', '#contato']]} />

<header class="port-topo" id="topo">
  <MenuTopo sub="Portfólio · Projetos selecionados" itens={[['Início', url()], ['Portfólio', url('portfolio/'), true], ['Currículo', url('curriculo/')], ['Empresas', url('empresas/')], ['Contato', '#contato']]} />
</header>

<div class="corpo solo">
  <main>
    <div class="port-cab">
      <h1 class="tt">Projetos <sup id="total">{PROJETOS.length}</sup></h1>
      <svg class="risco" viewBox="0 0 600 18" preserveAspectRatio="none" aria-hidden="true" style="width:min(100%,560px);height:14px;margin-top:6px;color:var(--lilas)"><path d="M4 10 C 140 15, 300 3, 450 9 S 570 12, 596 7"/></svg>
      <p class="lead">Campanhas, identidades, vídeos e sites que criei para agências, marcas e projetos próprios.</p>
      <p class="mao sub-mao">→ escolha uma categoria para filtrar</p>

      <div class="filtros" role="group" aria-label="Filtrar por categoria">
        <button type="button" data-filtro="todos" aria-pressed="true">Todos <span>{PROJETOS.length}</span></button>
        {filtros.map((c) => (
          <button type="button" data-filtro={c} aria-pressed="false">{CATEGORIAS[c]} <span>{contagem(c)}</span></button>
        ))}
      </div>

      <ul class="grade" aria-live="polite">
        {PROJETOS.map((p, i) => (
          <li data-categorias={p.categorias.join(' ')}><CardProjeto p={p} eager={i < 2} /></li>
        ))}
      </ul>
    </div>

    <section class="pergunta" aria-labelledby="t-perg">
      <h2 class="tt" id="t-perg">Gostou de algum<br><em>projeto?</em></h2>
    </section>
  </main>
</div>

<Mural titulo="Contato">
  <h2 class="tt"><em>Bora</em> conversar</h2>
  <svg class="risco" viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true"><path d="M3 7 C 90 3, 180 10, 297 6"/></svg>
  <p class="txt">Estou aberto a vagas de design gráfico, UI, edição de vídeo e criação de sites.</p>
  <div class="caixa-email"><span>jmeninodesign@gmail.com</span><button type="button" data-copiar="jmeninodesign@gmail.com">Copiar</button></div>
  <div class="acoes" style="justify-content:center">
    <a class="btn" href={linkWhatsApp('Olá, Jonathan! Vi seu portfólio e quero conversar.')}>Chamar no WhatsApp</a>
    <a class="btn sec" href={url('curriculo/')}>Ver currículo</a>
  </div>
</Mural>

<footer class="rodape">
  <span>© {new Date().getFullYear()} Jonathan Menino</span>
  <span><a href={url()}>Início</a> · <a href={url('empresas/')}>Para empresas</a> · <a href={url('white-label/')}>Para agências</a></span>
</footer>
</Base>

<script>
  import { initHome } from '../../scripts/home';
  initHome();
  const botoes = [...document.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
  const itens = [...document.querySelectorAll<HTMLElement>('.grade > li')];
  const aplicar = (filtro: string, salvar = true) => {
    if (!botoes.some((b) => b.dataset.filtro === filtro)) filtro = 'todos';
    botoes.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === filtro)));
    itens.forEach((li) => { li.hidden = filtro !== 'todos' && !li.dataset.categorias!.split(' ').includes(filtro); });
    document.getElementById('total')!.textContent = String(itens.filter((li) => !li.hidden).length);
    if (salvar) {
      const u = new URL(location.href);
      filtro === 'todos' ? u.searchParams.delete('categoria') : u.searchParams.set('categoria', filtro);
      history.replaceState(null, '', u);
    }
  };
  botoes.forEach((b) => b.addEventListener('click', () => aplicar(b.dataset.filtro!)));
  aplicar(new URLSearchParams(location.search).get('categoria') || 'todos', false);
</script>
