---
/* PORTFÓLIO: todos os projetos com filtro por categoria.
   Projetos e categorias em src/data/portfolio.ts. O filtro funciona com ?categoria=video
   (ou sites, campanhas, identidade, ia); sem JavaScript aparecem todos.
   Visual igual ao da home (src/styles/home.css e src/scripts/home.ts). */
import Base from '../../layouts/Base.astro';
import Prancheta from '../../components/novo/Prancheta.astro';
import Topo from '../../components/site/Topo.astro';
import Rodape from '../../components/site/Rodape.astro';
import Mural from '../../components/novo/Mural.astro';
import '@fontsource/anton/latin-400.css';
import '@fontsource/caveat-brush/latin-400.css';
import '../../styles/home.css';
import CardProjeto from '../../components/CardProjeto.astro';
import { PROJETOS, CATEGORIAS, categoria, type Categoria } from '../../data/portfolio';
import { SITE, url, linkWhatsApp } from '../../data/site';
import { idioma, tradutor, pagina, em } from '../../i18n';

const L = idioma(Astro.url);
const T = tradutor(L);

const contagem = (c: Categoria) => PROJETOS.filter((p) => p.categorias.includes(c)).length;
const filtros = (Object.keys(CATEGORIAS) as Categoria[]).filter((c) => contagem(c) > 0);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: T('Portfólio · Jonathan Menino', 'Portfolio · Jonathan Menino'),
  author: { '@type': 'Person', name: SITE.nome },
  hasPart: PROJETOS.map((p) => ({ '@type': 'CreativeWork', name: em(p, L).titulo, url: new URL(pagina(L, p.link), Astro.site).href })),
};
---
<Base
  title={T('Portfólio · Jonathan Menino', 'Portfolio · Jonathan Menino')}
  description={T('Portfólio de Jonathan Menino: campanhas, identidade visual, edição de vídeo e motion, sites e projetos com IA generativa.', 'Jonathan Menino’s portfolio: campaigns, visual identity, video editing and motion, websites and generative AI projects.')}
  jsonld={jsonld}
>
<Prancheta />
<Topo tom="escuro" />

<div id="topo"></div>

<div class="corpo solo">
  <main>
    <div class="port-cab">
      <h1 class="tt">{T('Projetos', 'Projects')} <sup id="total">{PROJETOS.length}</sup></h1>
      <svg class="risco" viewBox="0 0 600 18" preserveAspectRatio="none" aria-hidden="true" style="width:min(100%,560px);height:14px;margin-top:6px;color:var(--lilas)"><path d="M4 10 C 140 15, 300 3, 450 9 S 570 12, 596 7"/></svg>
      <p class="lead">{T('Campanhas, identidades, vídeos e sites que criei para agências, marcas e projetos próprios.', 'Campaigns, identities, videos and websites I created for agencies, brands and my own projects.')}</p>
      <p class="mao sub-mao">{T('→ escolha uma categoria para filtrar', '→ pick a category to filter')}</p>

      <div class="filtros" role="group" aria-label={T('Filtrar por categoria', 'Filter by category')}>
        <button type="button" data-filtro="todos" aria-pressed="true">{T('Todos', 'All')} <span>{PROJETOS.length}</span></button>
        {filtros.map((c) => (
          <button type="button" data-filtro={c} aria-pressed="false">{categoria(c, L)} <span>{contagem(c)}</span></button>
        ))}
      </div>

      <ul class="grade" aria-live="polite">
        {PROJETOS.map((p, i) => (
          <li data-categorias={p.categorias.join(' ')}><CardProjeto p={p} eager={i < 2} /></li>
        ))}
      </ul>
    </div>

    <section class="pergunta" aria-labelledby="t-perg">
      <h2 class="tt" id="t-perg">{T('Gostou de algum', 'Like any of')}<br><em>{T('projeto?', 'these projects?')}</em></h2>
    </section>
  </main>
</div>

<Mural titulo={T('Contato', 'Contact')}>
  <h2 class="tt">{L === 'en' ? <><em>Let’s</em> talk</> : <><em>Bora</em> conversar</>}</h2>
  <svg class="risco" viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true"><path d="M3 7 C 90 3, 180 10, 297 6"/></svg>
  <p class="txt">{T('Estou aberto a vagas de design gráfico, UI, edição de vídeo e criação de sites.', 'I’m open to roles in graphic design, UI, video editing and web design.')}</p>
  <div class="caixa-email"><span>jmeninodesign@gmail.com</span><button type="button" data-copiar="jmeninodesign@gmail.com">{T('Copiar', 'Copy')}</button></div>
  <div class="acoes" style="justify-content:center">
    <a class="btn" href={linkWhatsApp(T('Olá, Jonathan! Vi seu portfólio e quero conversar.', 'Hi, Jonathan! I saw your portfolio and would like to talk.'))}>{T('Chamar no WhatsApp', 'Message on WhatsApp')}</a>
    <a class="btn sec" href={pagina(L, 'curriculo/')}>{T('Ver currículo', 'View résumé')}</a>
  </div>
</Mural>

<Rodape />
</Base>

<script>
  import { initHome } from '../../scripts/home';
  initHome();
  const botoes = [...document.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
  const itens = [...document.querySelectorAll<HTMLElement>('.grade > li')];
  const reduzir = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const aplicar = (filtro: string, salvar = true) => {
    if (!botoes.some((b) => b.dataset.filtro === filtro)) filtro = 'todos';
    botoes.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === filtro)));
    itens.forEach((li) => { li.hidden = filtro !== 'todos' && !li.dataset.categorias!.split(' ').includes(filtro); });
    // Ao filtrar, os projetos que ficam entram com um fade curto em sequência (até 6 com atraso, o resto junto).
    if (salvar) itens.filter((li) => !li.hidden).forEach((li, i) => li.animate(
      reduzir ? [{ opacity: 0 }, { opacity: 1 }] : [{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'none' }],
      { duration: reduzir ? 150 : 320, delay: Math.min(i, 6) * 40, easing: 'cubic-bezier(.23, 1, .32, 1)', fill: 'backwards' },
    ));
    document.getElementById('total')!.textContent = String(itens.filter((li) => !li.hidden).length);
    if (salvar) {
      const u = new URL(location.href);
      filtro === 'todos' ? u.searchParams.delete('categoria') : u.searchParams.set('categoria', filtro);
      history.replaceState(null, '', u);
    }
  };
  botoes.forEach((b) => b.addEventListener('click', () => aplicar(b.dataset.filtro!)));
  aplicar(new URLSearchParams(location.search).get('categoria') || 'todos', false);
</script>
