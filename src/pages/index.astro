---
/* HOME (Sobre mim): quem sou, o que faço, projetos em destaque, como trabalho e minhas skills.
   O endereço antigo /sobre/ redireciona para cá (astro.config.mjs).
   Textos e listas ficam nas constantes abaixo. Foto em src/assets/sobre/jonathan.png. */
import { Image } from 'astro:assets';
import foto from '../assets/sobre/jonathan.png';
import Base from '../layouts/Base.astro';
import Fox from '../components/Fox.astro';
import Redes from '../components/Redes.astro';
import { SITE, url, linkWhatsApp } from '../data/site';
import CardProjeto from '../components/CardProjeto.astro';
import { PROJETOS } from '../data/portfolio';
import '../styles/pagina.css';

const DESTAQUES = PROJETOS.filter((p) => p.destaque);

const FRENTES = [
  {
    titulo: 'Design gráfico e identidade',
    texto: 'Identidades visuais, direção de arte e campanhas completas: posts, stories, anúncios, impressos e ponto de venda. Cada peça falando a mesma língua da marca.',
    exemplo: { nome: 'Escalados Macarrone', link: 'portfolio/escalados-macarrone/' },
    icone: '<path d="M12 3a9 9 0 1 0 9 9"/><path d="M12 3v9h9"/><path d="M15.5 3.7A9 9 0 0 1 20.3 8.5"/>',
  },
  {
    titulo: 'Vídeo e motion',
    texto: 'Edição de vídeo e motion design para Reels, anúncios e telões de LED. Ritmo, corte e movimento pensados para prender a atenção nos primeiros segundos.',
    exemplo: { nome: 'Costelinha BBQ', link: 'portfolio/macarrone-costelinha-bbq/' },
    icone: '<rect x="3" y="5" width="14" height="14" rx="2"/><path d="m17 10 4-2.5v9L17 14"/>',
  },
  {
    titulo: 'UI e sites',
    texto: 'Desenho a interface no Figma e desenvolvo o site em código: landing pages e sites institucionais rápidos, responsivos e fáceis de usar.',
    exemplo: { nome: 'Sites White Label', link: 'white-label/' },
    icone: '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 8h18M8 21h8M12 18v3"/>',
  },
  {
    titulo: 'Fluxos com IA',
    texto: 'Uso IA generativa no dia a dia para criar cenários, objetos e variações, e para ganhar tempo na produção. A ferramenta acelera; a direção continua sendo minha.',
    exemplo: { nome: 'Doces da Fer · Páscoa', link: 'portfolio/doces-da-fer-pascoa/' },
    icone: '<path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/><circle cx="12" cy="12" r="3"/>',
  },
];

const JEITO = [
  { t: 'Ideia antes da ferramenta', d: 'Primeiro entendo o que a marca precisa dizer e para quem. Só depois abro o Illustrator, o Premiere ou o Figma.' },
  { t: 'Bonito e claro', d: 'Gosto de design que chama atenção sem deixar de lado a funcionalidade e a clareza da mensagem.' },
  { t: 'Do começo ao fim', d: 'Consigo levar uma ideia da peça estática ao vídeo e ao site, mantendo tudo coerente.' },
  { t: 'Ritmo de agência', d: 'Estou acostumado a prazos curtos e várias marcas ao mesmo tempo, sem abrir mão do acabamento.' },
];

const SKILLS = [
  { grupo: 'Design', itens: ['Identidade visual', 'Direção de arte', 'Social media', 'Campanhas digitais', 'Impressos e PDV', 'Apresentações'] },
  { grupo: 'Vídeo', itens: ['Edição de vídeo', 'Motion design', 'Reels e anúncios', 'Chroma key', 'Telão de LED'] },
  { grupo: 'Web', itens: ['UI design', 'Landing pages', 'Sites institucionais', 'HTML e CSS', 'JavaScript'] },
  { grupo: 'IA', itens: ['IA generativa para imagem', 'IA generativa para vídeo', 'IA no fluxo de criação'] },
  { grupo: 'Ferramentas', itens: ['Photoshop', 'Illustrator', 'InDesign', 'Premiere Pro', 'Figma'] },
];

const TRAJETORIA = [
  { ano: '2019', onde: 'BluePex', oque: 'Analista de marketing em segurança digital: campanhas, CRM e landing pages.' },
  { ano: '2021', onde: 'DISEMP', oque: 'Designer pleno em marketing automotivo, já com motion e edição de vídeo.' },
  { ano: '2023', onde: 'Acade', oque: 'Designer pleno em educação para o mercado fitness: campanhas, PDV e eventos.' },
  { ano: '2025', onde: 'Agência Zava', oque: 'Designer gráfico sênior: identidade, campanhas, vídeos e IA para várias marcas.' },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: SITE.nome,
    jobTitle: 'Designer Gráfico',
    address: { '@type': 'PostalAddress', addressLocality: 'Limeira', addressRegion: 'SP', addressCountry: 'BR' },
    knowsAbout: ['Design gráfico', 'Identidade visual', 'Direção de arte', 'Edição de vídeo', 'Motion design', 'UI design', 'Desenvolvimento de sites', 'IA generativa'],
    sameAs: Object.values(SITE.redes).filter(Boolean),
  },
};
---
<Base
  title="Jonathan Menino · Designer gráfico, vídeo e sites"
  description="Sou Jonathan Menino, designer gráfico em Limeira/SP. Há mais de 13 anos crio identidades, campanhas, vídeos e sites, hoje com fluxos de IA no dia a dia."
  tipo="article"
  jsonld={jsonld}
>
<header class="nav">
  <a href={url()} class="marca" aria-label="Jonathan Menino, início">
    <Fox cor="#9B7BFF" class="raposa" />
    <span>Jonathan Menino</span>
  </a>
  <nav class="nav-links" aria-label="Páginas">
    <a href={url('portfolio/')}>Portfólio</a>
    <a href={url('curriculo/')}>Currículo</a>
    <a href={url('empresas/')}><span class="longo">Para empresas</span><span class="curto">Empresas</span></a>
    <a href={url('white-label/')}><span class="longo">Para agências</span><span class="curto">Agências</span></a>
  </nav>
</header>

<main>
  <section class="hero wrap">
    <div class="hero-txt">
      <p class="selo"><span class="pulso" aria-hidden="true"></span>Disponível para vagas e freelas</p>
      <h1>Oi, eu sou o Jonathan. <span>Eu transformo ideias em marcas, vídeos e sites.</span></h1>
      <p class="lead">Sou designer gráfico em Limeira, interior de São Paulo. Há mais de 13 anos trabalho com agências e empresas, do B2B ao B2C, criando o que uma marca precisa para ser vista e lembrada.</p>
      <div class="acoes-topo">
        <a class="btn" href={url('portfolio/')}>Ver portfólio <span aria-hidden="true">→</span></a>
        <a class="btn sec" href={linkWhatsApp('Olá, Jonathan! Vi seu site e quero conversar.')}>Falar comigo no WhatsApp</a>
      </div>
    </div>
    <figure class="retrato">
      <Image src={foto} alt="Retrato de Jonathan Menino, de perfil, sobre fundo roxo" widths={[400, 640]} sizes="(max-width: 760px) 100vw, 420px" loading="eager" fetchpriority="high" />
      <figcaption>design · vídeo · web · IA</figcaption>
    </figure>
  </section>

  <section class="wrap reel" aria-labelledby="reel-titulo">
    <h2 class="titulo" id="reel-titulo">Showreel</h2>
    <video src={url('showreel/showreel.mp4')} poster={url('showreel/showreel.jpg')} muted loop playsinline autoplay controls preload="metadata" aria-label="Showreel com trechos dos vídeos de Escalados Macarrone, Costelinha BBQ e Doces da Fer"></video>
    <script is:inline>if (matchMedia('(prefers-reduced-motion: reduce)').matches) { var v = document.currentScript.previousElementSibling; v.removeAttribute('autoplay'); v.pause(); }</script>
  </section>

  <section class="wrap historia">
    <h2 class="titulo">Quem sou eu</h2>
    <div class="colunas">
      <p>Estudei Design Gráfico na FAAL e, ao longo da carreira, passei por agências e empresas de segmentos bem diferentes: segurança digital, marketing automotivo, educação fitness e, hoje, a Agência Zava, onde atendo marcas de alimentação e varejo.</p>
      <p>Essa variedade me fez um designer de muitas frentes. Num mesmo dia posso estar criando uma identidade, editando um Reels, montando uma landing page ou testando um fluxo de IA para gerar um cenário. O que une tudo é a mesma vontade: fazer algo bonito que também seja claro e funcione para quem vê.</p>
    </div>
  </section>

  <section class="wrap">
    <h2 class="titulo">O que eu faço</h2>
    <ul class="frentes">
      {FRENTES.map((f) => (
        <li class="frente">
          <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={f.icone} /></span>
          <h3>{f.titulo}</h3>
          <p>{f.texto}</p>
          <a class="exemplo" href={url(f.exemplo.link)}>Ver {f.exemplo.nome} <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap">
    <div class="titulo titulo-link"><h2>Projetos em destaque</h2><a href={url('portfolio/')}>Ver todos <span aria-hidden="true">→</span></a></div>
    <ul class="destaques">{DESTAQUES.map((p) => <li><CardProjeto p={p} /></li>)}</ul>
    <p class="ver-todos"><a class="btn sec" href={url('portfolio/')}>Ver todos os projetos <span aria-hidden="true">→</span></a></p>
  </section>

  <section class="wrap">
    <h2 class="titulo">Como eu trabalho</h2>
    <ol class="jeito">
      {JEITO.map((j, i) => (
        <li>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{j.t}</h3>
          <p>{j.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap">
    <h2 class="titulo">Skills</h2>
    <div class="skills">
      {SKILLS.map((s) => (
        <div class="skill">
          <p class="grupo">{s.grupo}</p>
          <ul class="chips">{s.itens.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap">
    <h2 class="titulo">Trajetória recente</h2>
    <ol class="linha">
      {TRAJETORIA.map((t) => (
        <li>
          <span class="ano">{t.ano}</span>
          <div><h3>{t.onde}</h3><p>{t.oque}</p></div>
        </li>
      ))}
    </ol>
    <p class="mais"><a href={url('curriculo/')}>Ver o currículo completo <span aria-hidden="true">→</span></a></p>
  </section>

  <section class="wrap atalhos">
    <a class="agencias" href={url('empresas/')}>
      <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg></span>
      <span><span class="ag-rotulo">Para empresas</span><span class="ag-t">Design para a sua marca</span><span class="ag-d">Identidade visual, campanhas, vídeos e sites feitos direto com quem cria.</span></span>
      <span class="ag-seta" aria-hidden="true">→</span>
    </a>
    <a class="agencias" href={url('white-label/')}>
      <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 8h18M8 21h8M12 18v3"/></svg></span>
      <span><span class="ag-rotulo">Para agências</span><span class="ag-t">Sites White Label</span><span class="ag-d">Desenvolvo sites e landing pages para a sua agência entregar com a própria marca.</span></span>
      <span class="ag-seta" aria-hidden="true">→</span>
    </a>
  </section>

  <section class="wrap fim">
    <h2>Bora criar algo juntos?</h2>
    <p>Estou aberto a vagas de design gráfico, UI, edição de vídeo e criação de sites, e a projetos com agências.</p>
    <div class="acoes">
      <a class="btn" href={url('portfolio/')}>Ver portfólio</a>
      <a class="btn sec" href={linkWhatsApp('Olá, Jonathan! Vi sua página e quero conversar.')}>Chamar no WhatsApp</a>
      <a class="btn sec" href="mailto:jmeninodesign@gmail.com">jmeninodesign@gmail.com</a>
    </div>
  </section>
</main>

<footer class="wrap rodape">
  <Redes whatsapp class="redes" />
  <p>© {new Date().getFullYear()} Jonathan Menino</p>
</footer>
</Base>
