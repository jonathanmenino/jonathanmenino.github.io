---
/* HOME: quem sou, o que faço, showreel, trabalhos, trajetória e contato.
   Layout inspirado no portfólio de Daniel Kiss: herói com grade de projetos revelada em "líquido" (WebGL),
   barra lateral fixa no desktop e mural arrastável no contato. Estilos em src/styles/home.css.
   O endereço antigo /sobre/ redireciona para cá (astro.config.mjs). Foto em src/assets/sobre/jonathan.png. */
import { Image } from 'astro:assets';
import foto from '../assets/sobre/jonathan.png';
import Base from '../layouts/Base.astro';
import { SITE, url, linkWhatsApp } from '../data/site';
import { PROJETOS, CATEGORIAS } from '../data/portfolio';
import '@fontsource/anton/latin-400.css';
import '@fontsource/caveat-brush/latin-400.css';
import '../styles/home.css';
import Prancheta from '../components/novo/Prancheta.astro';
import BarraMob from '../components/novo/BarraMob.astro';
import MenuTopo from '../components/novo/MenuTopo.astro';
import Mural from '../components/novo/Mural.astro';
import FundoLiquido from '../components/novo/FundoLiquido.astro';

const DESTAQUES = PROJETOS.filter((p) => p.destaque);

const FRENTES = [
  { t: 'Design gráfico & identidade', tags: ['Identidade visual', 'Direção de arte', 'Social media', 'Campanhas', 'Impressos e PDV'], ex: 'Escalados Macarrone', capa: 'og/escalados-macarrone.jpg', link: 'portfolio/escalados-macarrone/' },
  { t: 'Vídeo & motion', tags: ['Edição', 'Motion design', 'Reels e anúncios', 'Chroma key', 'Telão de LED'], ex: 'Costelinha BBQ', capa: 'og/macarrone-costelinha-bbq.jpg', link: 'portfolio/macarrone-costelinha-bbq/' },
  { t: 'UI & sites', tags: ['Figma', 'Landing pages', 'Sites institucionais', 'HTML, CSS e JS'], ex: 'Sentinela', capa: 'og/sentinela.jpg', link: 'white-label/projetos/sentinela/' },
  { t: 'Fluxos com IA', tags: ['Imagem generativa', 'Vídeo generativo', 'IA no fluxo de criação'], ex: 'Doces da Fer', capa: 'og/doces-da-fer-pascoa.jpg', link: 'portfolio/doces-da-fer-pascoa/' },
];

const TRAJETORIA = [
  { ano: '2019', onde: 'BluePex', oque: 'Analista de marketing em segurança digital.' },
  { ano: '2021', onde: 'DISEMP', oque: 'Designer pleno, marketing automotivo, motion e vídeo.' },
  { ano: '2023', onde: 'Acade', oque: 'Designer pleno, educação fitness: campanhas, PDV e eventos.' },
  { ano: '2025', onde: 'Agência Zava', oque: 'Designer gráfico sênior: identidade, campanhas, vídeos e IA.' },
];

const MENU = [
  ['sobre', 'Sobre'],
  ['frentes', 'Frentes'],
  ['trabalhos', 'Trabalhos'],
  ['trajetoria', 'Trajetória'],
  ['contato', 'Contato'],
];

const EMAIL = 'jmeninodesign@gmail.com';
const whats = linkWhatsApp('Olá, Jonathan! Vi seu site e quero conversar.');

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: SITE.nome,
    jobTitle: 'Designer Gráfico',
    address: { '@type': 'PostalAddress', addressLocality: 'Limeira', addressRegion: 'SP', addressCountry: 'BR' },
    knowsAbout: ['Design gráfico', 'Identidade visual', 'Direção de arte', 'Edição de vídeo', 'Motion design', 'UI design', 'Desenvolvimento de sites', 'IA generativa'],
    sameAs: Object.values(SITE.redes).filter(Boolean),
  },
};
---
<Base
  title="Jonathan Menino · Designer gráfico, vídeo e sites"
  description="Sou Jonathan Menino, designer gráfico em Limeira/SP. Há mais de 13 anos crio identidades, campanhas, vídeos e sites, hoje com fluxos de IA no dia a dia."
  tipo="article"
  jsonld={jsonld}
>
<Prancheta />
<BarraMob links={[['Portfólio', url('portfolio/')], ['Contato', '#contato']]} />

<header class="heroi" id="topo">
  <FundoLiquido />
  <MenuTopo itens={MENU.map(([id, nome]) => [nome, `#${id}`])} />
  <div></div>
  <div class="base">
    <p class="selo"><span class="pulso" aria-hidden="true"></span>Disponível para vagas e freelas</p>
    <div class="linha-nome">
      <p class="mao nota-mao" aria-hidden="true">↙ transformo ideias em marcas, vídeos e sites</p>
      <h1 class="tt nome"><span class="sr">Jonathan Menino, designer gráfico. Eu transformo ideias em marcas, vídeos e sites.</span><span class="l" aria-hidden="true">Jonathan</span> <span class="l" aria-hidden="true"><em>Menino</em></span></h1>
      <Image class="retrato-mini" src={foto} alt="Retrato de Jonathan Menino" widths={[180, 320]} sizes="160px" loading="eager" fetchpriority="high" />
    </div>
    <div class="sob-nome">
      <div class="esq">
        <a class="mao desce" href="#sobre">↓ continua descendo</a>
        <svg class="risco" id="risco-heroi" viewBox="0 0 600 18" preserveAspectRatio="none" aria-hidden="true"><path d="M4 12 C 120 4, 260 14, 380 8 S 560 6, 596 10"/></svg>
      </div>
      <div class="acoes">
        <a class="btn" href={url('portfolio/')}>Ver portfólio <span aria-hidden="true">→</span></a>
        <a class="btn sec" href={whats}>Falar comigo no WhatsApp</a>
      </div>
    </div>
  </div>
</header>

<div class="corpo">
  <main>
    <section class="secao" id="sobre" aria-labelledby="t-sobre">
      <h2 class="tt manifesto" id="t-sobre">Primeiro a ideia,<br><em>depois a ferramenta…</em></h2>
      <svg class="risco" viewBox="0 0 600 18" preserveAspectRatio="none" aria-hidden="true" style="width:min(100%,640px);height:14px;margin-top:10px;color:var(--lilas)"><path d="M4 10 C 140 15, 300 3, 450 9 S 570 12, 596 7"/></svg>
      <p class="intro-txt">Sou designer gráfico em Limeira, interior de São Paulo. Gosto de design que chama atenção sem deixar de lado a clareza da mensagem, e consigo levar uma ideia da peça estática ao vídeo e ao site.</p>
      <div class="numeros">
        <span class="seta" aria-hidden="true">↗</span>
        <div><strong>13+</strong><span>anos<br>de design</span></div>
        <div><strong>{PROJETOS.length}</strong><span>projetos<br>no portfólio</span></div>
        <div><strong>4</strong><span>frentes: design,<br>vídeo, web e IA</span></div>
      </div>
      <div class="quem">
        <p>Estudei Design Gráfico na FAAL e passei por segurança digital, marketing automotivo, educação fitness e, hoje, a Agência Zava, onde atendo marcas de alimentação e varejo.</p>
        <p>Num mesmo dia posso criar uma identidade, editar um Reels, montar uma landing page ou testar um fluxo de IA. O que une tudo é fazer algo bonito que funcione para quem vê.</p>
      </div>
      <div class="reel">
        <div class="rotulo"><p class="mao">→ 36 segundos do que eu faço</p><span class="mono" style="color:var(--papel-2)">Showreel</span></div>
        <div class="reel-caixa" id="reel">
          <video id="reel-video" src={url('showreel/showreel.mp4')} poster={url('showreel/showreel.jpg')} muted loop playsinline autoplay preload="metadata" aria-label="Showreel com trechos de Escalados Macarrone, Costelinha BBQ e Doces da Fer"></video>
          <button class="reel-pausa" id="reel-pausa" type="button">Pausar</button>
        </div>
      </div>
    </section>

    <section class="secao" id="frentes" aria-labelledby="t-frentes">
      <h2 class="tt" id="t-frentes" style="font-size:clamp(52px,7vw,116px)">O que eu <em>faço</em></h2>
      <p class="mao sub-mao">→ quatro frentes, a mesma vontade de fazer bonito e claro</p>
      <ul class="frentes">
        {FRENTES.map((f, i) => (
          <li>
            <a href={url(f.link)} data-previa={url(f.capa)}><h3 class="tt"><span class="num">0{i + 1}</span>{f.t}</h3></a>
            <div class="tags mono">{f.tags.map((x) => <span>{x}</span>)}</div>
            <a class="mao ex" href={url(f.link)}>→ ver {f.ex}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="secao" id="trabalhos" aria-labelledby="t-trab">
      <div class="cab"><h2 class="tt" id="t-trab">Trabalhos <em>recentes</em></h2><p class="mao">→ arraste para o lado</p></div>
      <div class="trilho-area" id="trilho-area"><div class="trilho" id="trilho">
        {DESTAQUES.map((p) => (
          <a class="card" href={url(p.link)} draggable="false">
            <div class="foto"><img src={url(p.capa)} alt={`Capa do projeto ${p.titulo}`} width="1200" height="630" loading="lazy" draggable="false"></div>
            <div class="meta"><div><h3 class="tt">{p.titulo}</h3><p class="cli">{p.cliente}</p></div><span class="mono tag">{CATEGORIAS[p.categorias[0]]}</span></div>
          </a>
        ))}
      </div></div>
      <div class="trilho-pe"><div class="barra"><i id="barra"></i></div><a class="mono" href={url('portfolio/')}>Ver todos os projetos →</a></div>
    </section>

    <section class="secao" id="trajetoria" aria-labelledby="t-traj">
      <div class="cab"><h2 class="tt" id="t-traj">Trajetória</h2><a class="mono" href={url('curriculo/')}>Currículo completo →</a></div>
      <ol class="linha-tempo">
        {TRAJETORIA.map((t) => <li><span class="ano">{t.ano}</span><h3>{t.onde}</h3><p>{t.oque}</p></li>)}
      </ol>
    </section>

    <section class="pergunta" aria-labelledby="t-perg">
      <h2 class="tt" id="t-perg">E aí… bora criar<br><em>algo juntos?</em></h2>
    </section>
  </main>

  <aside class="lateral" aria-label="Jonathan Menino">
    <div>
      <p class="tt marca">Jonathan <em>Menino</em></p>
      <svg class="risco" viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true"><path d="M3 8 C 80 3, 160 10, 297 5"/></svg>
    </div>
    <p class="tt" style="font-size:15px;letter-spacing:.04em">Design / Vídeo / Web / IA</p>
    <div class="redes">
      {SITE.redes.linkedin && <a href={SITE.redes.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>}
      {SITE.redes.behance && <a href={SITE.redes.behance} target="_blank" rel="noopener">Behance ↗</a>}
      {SITE.redes.instagram && <a href={SITE.redes.instagram} target="_blank" rel="noopener">Instagram ↗</a>}
      {SITE.redes.github && <a href={SITE.redes.github} target="_blank" rel="noopener">GitHub ↗</a>}
    </div>
    <p class="bio">Designer gráfico sênior na Agência Zava. Identidade, campanhas, vídeo, sites e IA.<br><span class="mono" style="color:var(--papel-2)">● Limeira/SP · Remoto ou híbrido</span></p>
    <ul class="menu" id="menu-lateral">
      {MENU.map(([id, nome], i) => <li><a href={`#${id}`}><small>0{i + 1}</small>{nome}</a></li>)}
    </ul>
    <figure><Image src={foto} alt="Retrato de Jonathan Menino" widths={[300, 560]} sizes="270px" loading="lazy" /><span class="mono">Retrato / 01</span><span class="mono vert">13+ anos / design</span></figure>
    <div class="caixa-email"><span>{EMAIL}</span><button type="button" data-copiar={EMAIL}>Copiar</button></div>
  </aside>
</div>

<Mural titulo="Contato">
  <h2 class="tt" id="t-contato"><em>Chama</em> com a sua ideia</h2>
  <svg class="risco" viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true"><path d="M3 7 C 90 3, 180 10, 297 6"/></svg>
  <div class="caixa-email"><span>{EMAIL}</span><button type="button" data-copiar={EMAIL}>Copiar</button></div>
  <div class="acoes" style="justify-content:center">
    <a class="btn" href={whats}>Chamar no WhatsApp</a>
    <a class="btn sec" href={url('curriculo/')}>Ver currículo</a>
  </div>
  <p class="mono disp">Disponível para vagas e freelas</p>
</Mural>

<footer class="rodape">
  <span>© {new Date().getFullYear()} Jonathan Menino</span>
  <span><a href={url('empresas/')}>Para empresas</a> · <a href={url('white-label/')}>Para agências</a></span>
</footer>

</Base>

<script>
  import { initHome } from '../scripts/home';
  initHome();
</script>
