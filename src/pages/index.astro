---
/* HOME: página pessoal mínima com links para os serviços.
   Para adicionar um produto ou o currículo, copie um <li> da lista "Serviços". */
import Base from '../layouts/Base.astro';
import Fox from '../components/Fox.astro';
import Redes from '../components/Redes.astro';
import { SITE, url } from '../data/site';

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.nome,
  jobTitle: 'Web designer e desenvolvedor de sites',
  url: new URL(url(), Astro.site).href,
  sameAs: Object.values(SITE.redes).filter(Boolean),
};
---
<Base
  title="Jonathan Menino · Web designer e desenvolvedor de sites"
  description="Jonathan Menino, web designer e desenvolvedor de sites. Conheça meus serviços, como o desenvolvimento White Label de sites para agências."
  image="og/home.jpg"
  jsonld={jsonld}
>
<main class="wrap">
  <a href={url()} class="marca" aria-label="Jonathan Menino, início">
    <Fox cor="#9B7BFF" class="" />
    <span><span class="nome" style="display:block">Jonathan Menino</span><span class="sub">Web designer · Desenvolvedor</span></span>
  </a>

  <h1>Sites bem feitos, <span>do layout ao código.</span></h1>
  <p class="intro">Sou web designer e desenvolvedor de sites. Escolha por onde começar.</p>

  <p class="rotulo">Serviços</p>
  <ul class="links">
    <li>
      <a class="card" href={url('white-label/')}>
        <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 8h18M8 21h8M12 18v3"/></svg></span>
        <span><span class="t" style="display:block">White Label para agências</span><span class="d" style="display:block">Sites e landing pages desenvolvidos para a sua agência entregar com a própria marca.</span></span>
        <svg class="seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
      </a>
    </li>
    <li>
      <a class="card" href={url('portfolio/')}>
        <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span>
        <span><span class="t" style="display:block">Portfólio</span><span class="d" style="display:block">Campanhas, identidades, vídeos e sites.</span></span>
        <svg class="seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
      </a>
    </li>
    <li>
      <a class="card" href={url('sobre/')}>
        <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span>
        <span><span class="t" style="display:block">Sobre mim</span><span class="d" style="display:block">Quem sou, o que faço e como trabalho.</span></span>
        <svg class="seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
      </a>
    </li>
    <li>
      <a class="card" href={url('curriculo/')}>
        <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg></span>
        <span><span class="t" style="display:block">Currículo</span><span class="d" style="display:block">Experiência, projetos e competências. Também em PDF.</span></span>
        <svg class="seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
      </a>
    </li>
    <!-- Próximos itens (produtos, currículo): copie o <li> acima. -->
  </ul>

  <footer>
    <Redes whatsapp class="redes" />
    <p>© {new Date().getFullYear()} Jonathan Menino</p>
  </footer>
</main>
</Base>

<style is:global>
/* Home mínima: só aponta para os produtos. Cores e fontes do manual da marca. */
:root { --roxo: #6E44FF; --roxo-claro: #9B7BFF; --carvao: #0B0A0D; --grafite: #151317; }
* { box-sizing: border-box; margin: 0; }
html { -webkit-text-size-adjust: 100%; }
body { min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; background: var(--carvao); color: #fff; font-family: "Inter Variable", Inter, ui-sans-serif, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
body::before { content: ""; position: fixed; inset: 0; pointer-events: none; background: radial-gradient(80% 60% at 85% 0%, rgba(110,68,255,.22), transparent 70%); }
a { color: inherit; text-decoration: none; }
:focus-visible { outline: 2px solid var(--roxo-claro); outline-offset: 3px; border-radius: 8px; }
.wrap { position: relative; width: 100%; max-width: 640px; margin: 0 auto; padding: 56px 20px 32px; flex: 1; display: flex; flex-direction: column; }
.marca { display: flex; align-items: center; gap: 12px; }
.marca svg { height: 40px; width: auto; }
.nome { font-weight: 600; font-size: 17px; line-height: 1.2; }
.sub { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.6); }
h1 { margin-top: 56px; font-size: clamp(2rem, 6vw, 2.75rem); font-weight: 700; line-height: 1.1; letter-spacing: -.02em; text-wrap: balance; }
h1 span { color: var(--roxo-claro); }
.intro { margin-top: 16px; max-width: 30rem; line-height: 1.6; color: rgba(255,255,255,.7); }
.rotulo { margin-top: 48px; font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.6); }
.links { list-style: none; padding: 0; margin-top: 14px; display: grid; gap: 10px; }
.card { display: flex; align-items: center; gap: 16px; padding: 20px; border: 1px solid rgba(255,255,255,.1); border-radius: 16px; background: var(--grafite); transition: border-color .2s, transform .2s; }
.card:hover { border-color: var(--roxo-claro); transform: translateY(-2px); }
.card .t { font-weight: 600; font-size: 17px; }
.card .d { margin-top: 4px; font-size: 14px; line-height: 1.5; color: rgba(255,255,255,.65); }
.card .seta { margin-left: auto; flex-shrink: 0; width: 20px; height: 20px; color: var(--roxo-claro); transition: transform .2s; }
.card:hover .seta { transform: translate(2px, -2px); }
.ic { flex-shrink: 0; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: rgba(110,68,255,.16); color: var(--roxo-claro); }
.ic svg { width: 22px; height: 22px; }
footer { margin-top: auto; padding-top: 56px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; font-size: 12px; color: rgba(255,255,255,.6); }
.redes { display: flex; flex-wrap: wrap; gap: 8px; }
.redes a { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid rgba(255,255,255,.15); border-radius: 999px; color: rgba(255,255,255,.8); transition: border-color .2s, color .2s; }
.redes a:hover { border-color: var(--roxo-claro); color: var(--roxo-claro); }
.redes svg { width: 18px; height: 18px; }
@media (prefers-reduced-motion: reduce) { .card, .card .seta { transition: none; } .card:hover { transform: none; } }
</style>
