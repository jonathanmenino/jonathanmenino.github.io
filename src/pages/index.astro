---
/* HOME (Sobre mim): quem sou, o que faço, projetos em destaque, como trabalho e minhas skills.
   O endereço antigo /sobre/ redireciona para cá (astro.config.mjs).
   Textos e listas ficam nas constantes abaixo. Foto em src/assets/sobre/jonathan.png. */
import { Image } from 'astro:assets';
import foto from '../assets/sobre/jonathan.png';
import Base from '../layouts/Base.astro';
import Fox from '../components/Fox.astro';
import Redes from '../components/Redes.astro';
import { SITE, url, linkWhatsApp } from '../data/site';
import CardProjeto from '../components/CardProjeto.astro';
import { PROJETOS } from '../data/portfolio';

const DESTAQUES = PROJETOS.filter((p) => p.destaque);

const FRENTES = [
  {
    titulo: 'Design gráfico e identidade',
    texto: 'Identidades visuais, direção de arte e campanhas completas: posts, stories, anúncios, impressos e ponto de venda. Cada peça falando a mesma língua da marca.',
    exemplo: { nome: 'Escalados Macarrone', link: 'portfolio/escalados-macarrone/' },
    icone: '<path d="M12 3a9 9 0 1 0 9 9"/><path d="M12 3v9h9"/><path d="M15.5 3.7A9 9 0 0 1 20.3 8.5"/>',
  },
  {
    titulo: 'Vídeo e motion',
    texto: 'Edição de vídeo e motion design para Reels, anúncios e telões de LED. Ritmo, corte e movimento pensados para prender a atenção nos primeiros segundos.',
    exemplo: { nome: 'Costelinha BBQ', link: 'portfolio/macarrone-costelinha-bbq/' },
    icone: '<rect x="3" y="5" width="14" height="14" rx="2"/><path d="m17 10 4-2.5v9L17 14"/>',
  },
  {
    titulo: 'UI e sites',
    texto: 'Desenho a interface no Figma e desenvolvo o site em código: landing pages e sites institucionais rápidos, responsivos e fáceis de usar.',
    exemplo: { nome: 'Sites White Label', link: 'white-label/' },
    icone: '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 8h18M8 21h8M12 18v3"/>',
  },
  {
    titulo: 'Fluxos com IA',
    texto: 'Uso IA generativa no dia a dia para criar cenários, objetos e variações, e para ganhar tempo na produção. A ferramenta acelera; a direção continua sendo minha.',
    exemplo: { nome: 'Doces da Fer · Páscoa', link: 'portfolio/doces-da-fer-pascoa/' },
    icone: '<path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/><circle cx="12" cy="12" r="3"/>',
  },
];

const JEITO = [
  { t: 'Ideia antes da ferramenta', d: 'Primeiro entendo o que a marca precisa dizer e para quem. Só depois abro o Illustrator, o Premiere ou o Figma.' },
  { t: 'Bonito e claro', d: 'Gosto de design que chama atenção sem deixar de lado a funcionalidade e a clareza da mensagem.' },
  { t: 'Do começo ao fim', d: 'Consigo levar uma ideia da peça estática ao vídeo e ao site, mantendo tudo coerente.' },
  { t: 'Ritmo de agência', d: 'Estou acostumado a prazos curtos e várias marcas ao mesmo tempo, sem abrir mão do acabamento.' },
];

const SKILLS = [
  { grupo: 'Design', itens: ['Identidade visual', 'Direção de arte', 'Social media', 'Campanhas digitais', 'Impressos e PDV', 'Apresentações'] },
  { grupo: 'Vídeo', itens: ['Edição de vídeo', 'Motion design', 'Reels e anúncios', 'Chroma key', 'Telão de LED'] },
  { grupo: 'Web', itens: ['UI design', 'Landing pages', 'Sites institucionais', 'HTML e CSS', 'JavaScript'] },
  { grupo: 'IA', itens: ['IA generativa para imagem', 'IA generativa para vídeo', 'IA no fluxo de criação'] },
  { grupo: 'Ferramentas', itens: ['Photoshop', 'Illustrator', 'InDesign', 'Premiere Pro', 'Figma'] },
];

const TRAJETORIA = [
  { ano: '2019', onde: 'BluePex', oque: 'Analista de marketing em segurança digital: campanhas, CRM e landing pages.' },
  { ano: '2021', onde: 'DISEMP', oque: 'Designer pleno em marketing automotivo, já com motion e edição de vídeo.' },
  { ano: '2023', onde: 'Acade', oque: 'Designer pleno em educação para o mercado fitness: campanhas, PDV e eventos.' },
  { ano: '2025', onde: 'Agência Zava', oque: 'Designer gráfico sênior: identidade, campanhas, vídeos e IA para várias marcas.' },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: SITE.nome,
    jobTitle: 'Designer Gráfico',
    address: { '@type': 'PostalAddress', addressLocality: 'Limeira', addressRegion: 'SP', addressCountry: 'BR' },
    knowsAbout: ['Design gráfico', 'Identidade visual', 'Direção de arte', 'Edição de vídeo', 'Motion design', 'UI design', 'Desenvolvimento de sites', 'IA generativa'],
    sameAs: Object.values(SITE.redes).filter(Boolean),
  },
};
---
<Base
  title="Jonathan Menino · Designer gráfico, vídeo e sites"
  description="Sou Jonathan Menino, designer gráfico em Limeira/SP. Há mais de 14 anos crio identidades, campanhas, vídeos e sites, hoje com fluxos de IA no dia a dia."
  tipo="article"
  jsonld={jsonld}
>
<header class="nav">
  <a href={url()} class="marca" aria-label="Jonathan Menino, início">
    <Fox cor="#9B7BFF" class="raposa" />
    <span>Jonathan Menino</span>
  </a>
  <nav class="nav-links" aria-label="Páginas">
    <a href={url('portfolio/')}>Portfólio</a>
    <a href={url('curriculo/')}>Currículo</a>
    <a href={url('white-label/')}>Para agências</a>
  </nav>
</header>

<main>
  <section class="hero wrap">
    <div class="hero-txt">
      <p class="rotulo">Sobre mim</p>
      <h1>Oi, eu sou o Jonathan. <span>Eu transformo ideias em marcas, vídeos e sites.</span></h1>
      <p class="lead">Sou designer gráfico em Limeira, interior de São Paulo. Há mais de 14 anos trabalho com agências e empresas, do B2B ao B2C, criando o que uma marca precisa para ser vista e lembrada.</p>
    </div>
    <figure class="retrato">
      <Image src={foto} alt="Retrato de Jonathan Menino, de perfil, sobre fundo roxo" widths={[400, 640]} sizes="(max-width: 760px) 100vw, 420px" loading="eager" fetchpriority="high" />
      <figcaption>design · vídeo · web · IA</figcaption>
    </figure>
  </section>

  <section class="wrap historia">
    <h2 class="titulo">Quem sou eu</h2>
    <div class="colunas">
      <p>Estudei Design Gráfico na FAAL e, ao longo da carreira, passei por agências e empresas de segmentos bem diferentes: segurança digital, marketing automotivo, educação fitness e, hoje, a Agência Zava, onde atendo marcas de alimentação e varejo.</p>
      <p>Essa variedade me fez um designer de muitas frentes. Num mesmo dia posso estar criando uma identidade, editando um Reels, montando uma landing page ou testando um fluxo de IA para gerar um cenário. O que une tudo é a mesma vontade: fazer algo bonito que também seja claro e funcione para quem vê.</p>
    </div>
  </section>

  <section class="wrap">
    <h2 class="titulo">O que eu faço</h2>
    <ul class="frentes">
      {FRENTES.map((f) => (
        <li class="frente">
          <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={f.icone} /></span>
          <h3>{f.titulo}</h3>
          <p>{f.texto}</p>
          <a class="exemplo" href={url(f.exemplo.link)}>Ver {f.exemplo.nome} <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap">
    <div class="titulo titulo-link"><h2>Projetos em destaque</h2><a href={url('portfolio/')}>Ver todos <span aria-hidden="true">→</span></a></div>
    <ul class="destaques">{DESTAQUES.map((p) => <li><CardProjeto p={p} /></li>)}</ul>
    <p class="ver-todos"><a class="btn sec" href={url('portfolio/')}>Ver todos os projetos <span aria-hidden="true">→</span></a></p>
  </section>

  <section class="wrap">
    <h2 class="titulo">Como eu trabalho</h2>
    <ol class="jeito">
      {JEITO.map((j, i) => (
        <li>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{j.t}</h3>
          <p>{j.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap">
    <h2 class="titulo">Skills</h2>
    <div class="skills">
      {SKILLS.map((s) => (
        <div class="skill">
          <p class="grupo">{s.grupo}</p>
          <ul class="chips">{s.itens.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap">
    <h2 class="titulo">Trajetória recente</h2>
    <ol class="linha">
      {TRAJETORIA.map((t) => (
        <li>
          <span class="ano">{t.ano}</span>
          <div><h3>{t.onde}</h3><p>{t.oque}</p></div>
        </li>
      ))}
    </ol>
    <p class="mais"><a href={url('curriculo/')}>Ver o currículo completo <span aria-hidden="true">→</span></a></p>
  </section>

  <section class="wrap">
    <a class="agencias" href={url('white-label/')}>
      <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 8h18M8 21h8M12 18v3"/></svg></span>
      <span><span class="ag-rotulo">Para agências</span><span class="ag-t">Sites White Label</span><span class="ag-d">Desenvolvo sites e landing pages para a sua agência entregar com a própria marca.</span></span>
      <span class="ag-seta" aria-hidden="true">→</span>
    </a>
  </section>

  <section class="wrap fim">
    <h2>Bora criar algo juntos?</h2>
    <p>Estou aberto a vagas de design gráfico, UI, edição de vídeo e criação de sites, e a projetos com agências.</p>
    <div class="acoes">
      <a class="btn" href={url('portfolio/')}>Ver portfólio</a>
      <a class="btn sec" href={linkWhatsApp('Olá, Jonathan! Vi sua página e quero conversar.')}>Chamar no WhatsApp</a>
      <a class="btn sec" href="mailto:jmeninodesign@gmail.com">jmeninodesign@gmail.com</a>
    </div>
  </section>
</main>

<footer class="wrap rodape">
  <Redes whatsapp class="redes" />
  <p>© {new Date().getFullYear()} Jonathan Menino</p>
</footer>
</Base>

<style is:global>
/* Página escura no padrão da home: carvão, roxo, Inter e JetBrains Mono. */
:root { --roxo: #6E44FF; --roxo-claro: #9B7BFF; --carvao: #0B0A0D; --grafite: #151317; --texto2: rgba(255,255,255,.72); }
* { box-sizing: border-box; margin: 0; }
html { -webkit-text-size-adjust: 100%; }
body { background: var(--carvao); color: #fff; font-family: "Inter Variable", Inter, ui-sans-serif, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
body::before { content: ""; position: fixed; inset: 0; pointer-events: none; background: radial-gradient(70% 50% at 90% 0%, rgba(110,68,255,.22), transparent 70%); }
a { color: inherit; }
:focus-visible { outline: 2px solid var(--roxo-claro); outline-offset: 3px; border-radius: 8px; }
.wrap { position: relative; width: 100%; max-width: 1080px; margin-left: auto; margin-right: auto; padding: 0 20px; }
main > section { margin-top: 104px; }
main > section.hero { margin-top: 56px; }
@media (max-width: 600px) { main > section { margin-top: 72px; } main > section.hero { margin-top: 32px; } }

.nav { position: relative; max-width: 1080px; margin: 0 auto; padding: 24px 20px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.marca { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600; }
.raposa { height: 32px; width: auto; }
.nav-links { display: flex; gap: 20px; font-size: 14px; }
.nav-links a { text-decoration: none; color: var(--texto2); transition: color .2s; }
.nav-links a:hover { color: #fff; }

.rotulo, .titulo, .grupo, .num, .ano { font-family: "JetBrains Mono", ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; }
.rotulo { font-size: 11px; color: var(--roxo-claro); }
.titulo { font-size: 12px; font-weight: 500; color: rgba(255,255,255,.6); padding-bottom: 14px; border-bottom: 1px solid rgba(255,255,255,.1); margin-bottom: 32px; }

.hero { display: grid; grid-template-columns: 1.5fr 1fr; gap: 48px; align-items: center; }
h1 { margin-top: 16px; font-size: clamp(2.25rem, 5.5vw, 4rem); font-weight: 700; line-height: 1.05; letter-spacing: -.03em; text-wrap: balance; }
h1 span { display: block; color: var(--roxo-claro); }
.lead { margin-top: 24px; max-width: 34rem; font-size: 18px; line-height: 1.6; color: var(--texto2); }
.retrato { position: relative; margin: 0; aspect-ratio: 4 / 5; border-radius: 24px; overflow: hidden; border: 1px solid rgba(255,255,255,.1); background: #2a1450; }
.retrato img { width: 100%; height: 100%; object-fit: cover; object-position: 38% center; display: block; }
.retrato figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 40px 20px 18px; background: linear-gradient(transparent, rgba(11,10,13,.75)); font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.8); }
@media (max-width: 760px) { .hero { grid-template-columns: 1fr; gap: 32px; } .retrato { aspect-ratio: 1 / 1; } }

.colunas { columns: 2 320px; column-gap: 48px; }
.colunas p { break-inside: avoid; margin-bottom: 20px; font-size: 17px; line-height: 1.7; color: var(--texto2); }
.colunas a { color: var(--roxo-claro); text-decoration: underline; text-underline-offset: 3px; }

.titulo-link { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
.titulo-link h2 { font: inherit; letter-spacing: inherit; }
.titulo-link a { color: var(--roxo-claro); text-decoration: none; font-weight: 500; }
.titulo-link a:hover { color: #fff; }
.ver-todos { margin-top: 28px; display: flex; justify-content: center; }
.ver-todos .btn span { margin-left: 8px; transition: transform .2s; }
.ver-todos .btn:hover span { transform: translateX(3px); }
.destaques { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
@media (max-width: 700px) { .destaques { grid-template-columns: 1fr; } }
.agencias { display: flex; align-items: center; gap: 20px; padding: 28px; border: 1px solid rgba(255,255,255,.1); border-radius: 20px; background: var(--grafite); text-decoration: none; transition: border-color .2s, transform .2s; }
.agencias:hover { border-color: rgba(155,123,255,.6); transform: translateY(-2px); }
.agencias > span:nth-child(2) { display: grid; gap: 4px; flex: 1; }
.ag-rotulo { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--roxo-claro); }
.ag-t { font-size: 20px; font-weight: 650; }
.ag-d { font-size: 15px; line-height: 1.55; color: var(--texto2); }
.ag-seta { font-size: 22px; color: var(--roxo-claro); transition: transform .2s; }
.agencias:hover .ag-seta { transform: translateX(4px); }
@media (max-width: 600px) { .agencias { align-items: flex-start; padding: 22px; } .ag-seta { display: none; } .nav-links { gap: 16px; font-size: 14px; } .nav-links a { white-space: nowrap; } .marca > span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } }
.frentes { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
.frente { display: flex; flex-direction: column; padding: 24px; border: 1px solid rgba(255,255,255,.1); border-radius: 18px; background: var(--grafite); transition: border-color .2s, transform .2s; }
.frente:hover { border-color: rgba(155,123,255,.6); transform: translateY(-2px); }
.ic { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: rgba(110,68,255,.16); color: var(--roxo-claro); }
.ic svg { width: 22px; height: 22px; }
.frente h3 { margin-top: 20px; font-size: 18px; font-weight: 650; }
.frente p { margin-top: 10px; font-size: 15px; line-height: 1.6; color: var(--texto2); flex: 1; }
.exemplo { margin-top: 20px; font-size: 14px; font-weight: 600; color: var(--roxo-claro); text-decoration: none; }
.exemplo span { display: inline-block; transition: transform .2s; }
.exemplo:hover span { transform: translateX(3px); }

.jeito { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 32px; }
.num { font-size: 12px; color: var(--roxo-claro); }
.jeito h3 { margin-top: 10px; font-size: 18px; font-weight: 650; }
.jeito p { margin-top: 8px; font-size: 15px; line-height: 1.6; color: var(--texto2); }

.skills { display: grid; gap: 20px; }
.skill { display: grid; grid-template-columns: 140px 1fr; gap: 16px; align-items: start; }
.grupo { font-size: 12px; padding-top: 8px; color: rgba(255,255,255,.6); }
.chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
.chips li { padding: 7px 14px; border-radius: 999px; border: 1px solid rgba(255,255,255,.14); font-size: 14px; color: rgba(255,255,255,.9); }
@media (max-width: 600px) { .skill { grid-template-columns: 1fr; gap: 8px; } .grupo { padding-top: 0; } }

.linha { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0; border-top: 1px solid rgba(255,255,255,.1); }
.linha li { padding: 20px 20px 0 0; display: grid; gap: 10px; position: relative; }
.linha li::before { content: ""; position: absolute; top: -5px; left: 0; width: 9px; height: 9px; border-radius: 50%; background: var(--roxo-claro); }
.linha li:last-child::before { box-shadow: 0 0 0 5px rgba(155,123,255,.25); }
.ano { font-size: 12px; color: var(--roxo-claro); }
.linha h3 { font-size: 17px; font-weight: 650; }
.linha p { margin-top: 4px; font-size: 14px; line-height: 1.55; color: var(--texto2); }
.mais { margin-top: 32px; }
.mais a { font-weight: 600; color: var(--roxo-claro); text-decoration: none; }
@media (max-width: 760px) { .linha { border-top: 0; border-left: 1px solid rgba(255,255,255,.1); margin-left: 4px; } .linha li { padding: 0 0 24px 24px; } .linha li::before { top: 4px; left: -5px; } }

.fim { text-align: center; padding-top: 64px; padding-bottom: 64px; border-radius: 28px; background: radial-gradient(80% 100% at 50% 0%, rgba(110,68,255,.28), transparent 70%), var(--grafite); max-width: 1040px; }
.fim h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 700; letter-spacing: -.02em; }
.fim p { margin: 14px auto 0; max-width: 32rem; line-height: 1.6; color: var(--texto2); }
.acoes { margin-top: 28px; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
.btn { display: inline-flex; align-items: center; min-height: 46px; padding: 0 22px; border-radius: 999px; background: var(--roxo); color: #fff; font-weight: 600; font-size: 15px; text-decoration: none; transition: background .2s, border-color .2s; }
.btn:hover { background: #5A30EE; }
.btn.sec { background: transparent; border: 1px solid rgba(255,255,255,.22); }
.btn.sec:hover { border-color: var(--roxo-claro); }
@media (max-width: 600px) { .fim { border-radius: 0; } .btn { width: 100%; justify-content: center; } }

.rodape { margin-top: 64px; padding-top: 24px; padding-bottom: 32px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; font-size: 12px; color: rgba(255,255,255,.6); }
.redes { display: flex; flex-wrap: wrap; gap: 8px; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
