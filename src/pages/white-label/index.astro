---
/* LANDING DO WHITE LABEL
   Contato e mensagens do WhatsApp: src/data/site.ts
   Projetos: src/content/cases/ (cada arquivo vira um card e uma página)
   Benefícios: src/data/pilares.ts
   Desempenho (PageSpeed): src/data/desempenho.ts */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Seta from '../../components/Seta.astro';
import Redes from '../../components/Redes.astro';
import TemaToggle from '../../components/TemaToggle.astro';
import { SITE, MENSAGENS, linkWhatsApp, url } from '../../data/site';
import { PILARES } from '../../data/pilares';
import { DESEMPENHO } from '../../data/desempenho';
import Nota from '../../components/Nota.astro';
import Anima from '../../components/Anima.astro';
import '../../styles/landing.css';

const cases = (await getCollection('cases')).sort((a, b) => a.data.ordem - b.data.ordem);
const wa = {
  parceria: linkWhatsApp(MENSAGENS.parceria),
  valores: linkWhatsApp(MENSAGENS.valores),
  conversa: linkWhatsApp(MENSAGENS.conversa),
};
const inicio = new URL(url(), Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Jonathan Menino · Desenvolvimento White Label',
  description: 'Desenvolvimento White Label de sites e landing pages para agências.',
  url: new URL(url('white-label/'), Astro.site).href,
  image: new URL(url('og/white-label.jpg'), Astro.site).href,
  areaServed: { '@type': 'Country', name: 'Brasil' },
  availableLanguage: 'pt-BR',
  serviceType: ['Desenvolvimento de sites', 'Landing pages', 'WordPress', 'Elementor'],
  provider: { '@type': 'Person', name: SITE.nome, url: inicio, sameAs: Object.values(SITE.redes).filter(Boolean) },
  contactPoint: { '@type': 'ContactPoint', contactType: 'sales', telephone: `+${SITE.whatsapp}`, availableLanguage: 'Portuguese' },
};
---
<Base
  title="Desenvolvedor White Label para Agências | Jonathan Menino"
  description="Sites e landing pages em WordPress, Elementor e código para agências. Desenvolvimento White Label no prazo, sem manter desenvolvedor interno."
  image="og/white-label.jpg"
  themeColor="#F7F6F3"
  jsonld={jsonld}
>
<!-- ============ MENU ============ -->
<header class="sticky z-40 border-b border-line/5 bg-paper/90 backdrop-blur" style="top: var(--header-top)">
  <div class="mx-auto flex h-16 max-w-site items-center justify-between px-5 md:h-[72px] md:px-8">
    <a href="#topo" class="flex items-center gap-3" aria-label="Jonathan Menino, início">
