            <span class="flex items-center gap-1.5 rounded-full bg-paper py-1.5 pl-2 pr-3"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" aria-hidden="true"><path fill="#06B6D4" d="M12 4.8c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624C13.666 10.618 15.027 12 18 12c3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C16.337 6.182 14.976 4.8 12 4.8zM6 12c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624 1.177 1.194 2.538 2.576 5.512 2.576 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C10.337 13.382 8.976 12 6 12z"/></svg>Tailwind CSS</span>
          </div>
          <p class="font-mono text-[11px] uppercase tracking-[.12em] text-muted">Medido em {DESEMPENHO.data} · Lighthouse {DESEMPENHO.lighthouse}</p>
