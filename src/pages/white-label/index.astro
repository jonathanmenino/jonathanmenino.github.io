  <!-- ============ PROJETOS (carregados da lista PROJETOS no script) ============ -->
  <section id="projetos" class="bg-ink text-white">
    <div class="mx-auto max-w-site px-5 py-20 md:px-8 md:py-36">
      <p class="eyebrow text-white/60">Projetos selecionados</p>
      <h2 class="r-wipe mt-5 text-[2rem] font-bold leading-[1.1] tracking-tight md:text-5xl">
        Projetos desenvolvidos<br class="hidden sm:block"> com <span class="text-brand-light">padrão de agência</span>.
      </h2>

      <div class="r-stagger mt-12 md:mt-16 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {cases.map(({ id, data: p }) => (
          <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-white/[.08] bg-graphite transition duration-300 hover:border-white/20 focus-within:border-brand-light">
            <div class="relative aspect-[4/3] max-w-full overflow-hidden">
              <div class="r-zoom h-full w-full"><Image src={p.capa.desktop} alt={p.card.titulo ?? p.titulo} widths={[400, 800]} sizes="(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover object-top transition duration-700 group-hover:scale-[1.04]" /></div>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <ul class="flex flex-wrap gap-1.5">{p.card.tags.map((t) => <li class="rounded-full border border-white/15 px-2.5 py-1 text-[11px] text-white/75">{t}</li>)}</ul>
              <h3 class="mt-5 text-xl font-semibold">{p.card.titulo ?? p.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/65">{p.card.descricao}</p>
              <a href={url(`white-label/projetos/${id}/`)} aria-label={`Ver projeto: ${p.card.titulo ?? p.titulo}`} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">Ver projeto <Seta class="arrow h-4 w-4 text-brand-light" /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROCESSO ============ -->
  <section id="processo" class="bg-mist">
    <div class="mx-auto max-w-site px-5 py-20 md:px-8 md:py-36">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow text-muted">Processo simples</p>
          <h2 class="r-wipe mt-5 text-[2rem] font-bold leading-[1.1] tracking-tight md:text-5xl">
            Do primeiro briefing<br class="hidden sm:block"> até o <span class="text-hl">site no ar</span>.
          </h2>
        </div>
        <p class="flex max-w-sm items-start gap-3 rounded-2xl bg-surface p-4 text-sm leading-relaxed text-muted">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-hl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.4 1 1.1 1 1.8V16h5v-.3c0-.7.4-1.4 1-1.8A6 6 0 0 0 12 3Z"/></svg>
          O layout é opcional. Se precisar, o projeto pode começar do zero comigo.
        </p>
      </div>

      <div class="relative mt-16 md:mt-20">
        <!-- trilho e linha de progresso: horizontal no desktop, vertical no celular -->
        <div class="absolute bottom-0 left-[11px] top-0 w-0.5 bg-line/10 md:bottom-auto md:left-0 md:right-0 md:top-[11px] md:h-0.5 md:w-auto"></div>
        <div class="r-progress absolute bottom-0 left-[11px] top-0 w-0.5 origin-top bg-brand [--from-y:0] md:bottom-auto md:left-0 md:right-0 md:top-[11px] md:h-0.5 md:w-auto md:origin-left md:[--from-x:0] md:[--from-y:1]"></div>
        <ol class="r-stagger relative grid gap-10 md:grid-cols-4 md:gap-6">
          <li class="relative pl-12 md:pl-0">
            <span class="absolute left-0 grid h-6 w-6 place-items-center rounded-full bg-brand font-mono text-[10px] text-white ring-4 ring-mist md:static">1</span>
            <h3 class="text-xl font-semibold md:mt-6">Briefing</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">Escopo, materiais e prazo alinhados.</p>
          </li>
          <li class="relative pl-12 md:pl-0">
            <span class="absolute left-0 grid h-6 w-6 place-items-center rounded-full bg-brand font-mono text-[10px] text-white ring-4 ring-mist md:static">2</span>
            <h3 class="text-xl font-semibold md:mt-6">Desenvolvimento</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">Ambiente de testes com atualizações claras.</p>
          </li>
          <li class="relative pl-12 md:pl-0">
            <span class="absolute left-0 grid h-6 w-6 place-items-center rounded-full bg-brand font-mono text-[10px] text-white ring-4 ring-mist md:static">3</span>
            <h3 class="text-xl font-semibold md:mt-6">Ajustes</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">Você valida e eu refino até aprovar.</p>
          </li>
          <li class="relative pl-12 md:pl-0">
            <span class="absolute left-0 grid h-6 w-6 place-items-center rounded-full bg-brand font-mono text-[10px] text-white ring-4 ring-mist md:static">4</span>
            <h3 class="text-xl font-semibold md:mt-6">Entrega</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">Site no ar com a marca da sua agência.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ VALORES (WhatsApp no lugar do formulário) ============ -->
  <section id="valores" class="mx-auto max-w-site px-5 py-20 md:px-8 md:py-36">
    <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <div>
        <p class="eyebrow text-muted">Valores para agências</p>
        <h2 class="r-wipe mt-5 text-[2rem] font-bold leading-[1.1] tracking-tight md:text-5xl">
          Quer saber <span class="text-hl">quanto custa</span> desenvolver um site em parceria?
        </h2>
        <p class="mt-5 max-w-md text-base leading-relaxed text-muted">Receba a tabela exclusiva para agências. Sem compromisso.</p>
