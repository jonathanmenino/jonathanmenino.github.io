                <Nota valor={d.notas.seo} rotulo="SEO" />
              </div>
            </div>
            <div>
              <p class="font-mono text-[11px] uppercase tracking-[.12em] text-muted">Métricas · {d.nome}</p>
              <dl class="mt-4 grid gap-x-8 sm:grid-cols-2">
                {d.metricas.map((m) => (
                  <div class="flex items-center justify-between gap-4 border-b border-line/[.08] py-4 last:border-b-0">
                    <dt class="flex items-center gap-3 text-sm">
                      <span class="h-2 w-2 shrink-0 rounded-full bg-hl" aria-hidden="true"></span>
