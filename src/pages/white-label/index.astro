              <button type="button" role="tab" id={`aba-${d.id}`} aria-controls={`painel-${d.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="aba-desempenho flex items-center gap-2 rounded-full px-4 py-2 text-muted transition aria-selected:bg-brand aria-selected:text-white">
                {d.id === 'celular'
                  ? <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/></svg>
                  : <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M2 20h20"/></svg>}
                {d.nome}
              </button>
            ))}
          </div>
          <a href={DESEMPENHO.testar} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm font-medium text-hl hover:underline">Teste você mesmo no PageSpeed <Seta /></a>
