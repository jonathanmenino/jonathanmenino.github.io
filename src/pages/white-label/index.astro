            </div>
          </div>
          <div class="border-t border-black/5 px-5 py-2.5 text-[10.5px] text-[#6B6870]">Desenvolvido por <strong class="text-ink">Sua Agência</strong></div>
        </div>

        <div class="art-chip absolute bottom-0 left-2 flex items-center gap-2 rounded-full bg-[#EEE9FF] px-4 py-2.5 text-xs font-semibold text-brand-dark shadow-[0_12px_30px_-10px_rgba(0,0,0,.6)] sm:left-6">
