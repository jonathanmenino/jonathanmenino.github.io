<script>
  // Menu mobile
  const menu = document.getElementById('menu-mobile');
  const abrir = document.getElementById('menu-open');
  const setMenu = (aberto) => {
    menu.hidden = !aberto;
    abrir.setAttribute('aria-expanded', String(aberto));
    document.body.style.overflow = aberto ? 'hidden' : '';
  };
  abrir.addEventListener('click', () => setMenu(true));
  document.getElementById('menu-close').addEventListener('click', () => setMenu(false));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) setMenu(false); });

  // Abas Celular / Computador da seção de desempenho
  const abas = [...document.querySelectorAll('.aba-desempenho')];
  const escolher = (aba) => abas.forEach((a) => {
    const ativa = a === aba;
    a.setAttribute('aria-selected', String(ativa));
    a.tabIndex = ativa ? 0 : -1;
    document.getElementById(a.getAttribute('aria-controls')).hidden = !ativa;
  });
  abas.forEach((a, i) => {
    a.addEventListener('click', () => escolher(a));
    a.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const prox = abas[(i + (e.key === 'ArrowRight' ? 1 : -1) + abas.length) % abas.length];
      escolher(prox); prox.focus();
    });
  });
</script>
