  <!-- ============ PARCERIA (WHITE LABEL) ============ -->
  <section id="parceria" class="mx-auto grid max-w-site items-center gap-12 px-5 py-20 md:px-8 md:py-36 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
