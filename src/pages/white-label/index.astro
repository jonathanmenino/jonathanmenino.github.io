        <li class="flex shrink-0 items-center gap-2"><svg class="h-4 w-4 text-brand-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>Alto desempenho</li>
        <li class="flex shrink-0 items-center gap-2"><svg class="h-4 w-4 text-brand-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>Sem custo fixo</li>
        <li class="flex shrink-0 items-center gap-2"><svg class="h-4 w-4 text-brand-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>Desenvolvedor parceiro</li>
      </ul>
          <ul class="flex shrink-0 gap-8 py-5 pl-5 pr-3 md:hidden" aria-hidden="true">
        <li class="flex shrink-0 items-center gap-2"><svg class="h-4 w-4 text-brand-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>100% White Label</li>
        <li class="flex shrink-0 items-center gap-2"><svg class="h-4 w-4 text-brand-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>Entrega no prazo</li>
        <li class="flex shrink-0 items-center gap-2"><svg class="h-4 w-4 text-brand-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>Alto desempenho</li>
