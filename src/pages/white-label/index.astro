          <span class="mt-7 font-mono text-[11px] uppercase tracking-[.12em] text-hl">Opção 02</span>
          <h3 class="mt-2 text-2xl font-semibold tracking-tight">Você quer terceirizar tudo</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-muted">Eu cuido de tudo, da estrutura à publicação.</p>
          <ul class="mt-8 flex flex-wrap gap-2 border-t border-line/[.08] pt-6 text-xs font-medium">
            <li class="rounded-full bg-paper px-3 py-1.5">Estrutura</li>
            <li class="rounded-full bg-paper px-3 py-1.5">Wireframe</li>
            <li class="rounded-full bg-paper px-3 py-1.5">UI Design</li>
            <li class="rounded-full bg-paper px-3 py-1.5">Desenvolvimento</li>
            <li class="rounded-full bg-paper px-3 py-1.5">Publicação</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ PILARES ============ -->
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-site px-5 py-20 md:px-8 md:py-36">
      <div>
        <div>
          <p class="eyebrow text-white/60">Pilares da entrega</p>
          <h2 class="r-wipe mt-5 text-[2rem] font-bold leading-[1.1] tracking-tight md:text-5xl">
            <span class="text-brand-light">Qualidade</span> percebida no visual. E sentida no uso.
          </h2>
        </div>
      </div>

      <div class="r-stagger mt-12 md:mt-16 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {PILARES.map((p) => (
          <article class="group rounded-2xl border border-white/[.08] bg-graphite p-6 transition duration-300 hover:border-brand/60 hover:bg-[#1b1820]">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand/15 text-brand-light transition duration-300 group-hover:bg-brand group-hover:text-white">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={p.icone} />
            </span>
            <h3 class="mt-6 text-lg font-semibold">{p.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/65">{p.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ DESEMPENHO (a própria página como prova; números em src/data/desempenho.ts) ============ -->
  <section id="desempenho" class="bg-mist">
    <div class="mx-auto max-w-site px-5 py-20 md:px-8 md:py-36">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow text-muted">Desempenho excepcional</p>
          <h2 class="r-wipe mt-5 text-[2rem] font-bold leading-[1.1] tracking-tight md:text-5xl">
            A prova é a <span class="text-hl">página</span><br class="hidden sm:block"> que você está lendo.
          </h2>
        </div>
        <p class="max-w-xs text-sm leading-relaxed text-muted">Notas desta página no PageSpeed, do Google. O mesmo padrão vai para os seus projetos.</p>
      </div>

