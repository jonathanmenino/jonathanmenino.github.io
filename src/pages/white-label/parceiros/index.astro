---
/* VALORES PARA AGÊNCIAS PARCEIRAS: página enviada por link, com noindex (fora do Google)
   e fora do sitemap. Nenhuma outra página aponta para ela.
   Valores, itens inclusos e observações ficam em src/data/valores.ts. */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Fox from '../../../components/Fox.astro';
import Redes from '../../../components/Redes.astro';
import TemaToggle from '../../../components/TemaToggle.astro';
import Anima from '../../../components/Anima.astro';
import { MENSAGENS, linkWhatsApp, url } from '../../../data/site';
import { VALORES, INCLUSO, OBSERVACOES, reais, sugerido } from '../../../data/valores';

const cases = (await getCollection('cases')).sort((a, b) => a.data.ordem - b.data.ordem);
---
<Base
  title="Valores para agências parceiras · Jonathan Menino"
  description="Tabela de valores do desenvolvimento White Label de sites e landing pages para agências parceiras."
  image="og/white-label.jpg"
  themeColor="#F7F6F3"
>
  <meta slot="head" name="robots" content="noindex, nofollow">
  <main class="min-h-[100dvh] bg-ink text-white">
    <!-- Parte clara: tabela, inclusos e observações -->
    <div class="bg-paper text-fg">
    <div class="mx-auto max-w-4xl px-5 pb-16 pt-10 md:pb-20 md:pt-14">
      <div class="flex items-center justify-between gap-4">
      <a href={url('white-label/')} class="flex items-center gap-3" aria-label="White Label para agências">
        <Fox cor="#6E44FF" class="h-10 w-auto" />
        <span>
          <span class="block text-[17px] font-semibold leading-tight">Jonathan Menino</span>
          <span class="block font-mono text-[10px] uppercase tracking-[.14em] text-muted">White Label para agências</span>
        </span>
      </a>
      <TemaToggle />
      </div>

      <p class="mt-14 font-mono text-xs uppercase tracking-[.14em] text-hl">Agências parceiras</p>
      <h1 class="mt-3 text-[clamp(2rem,6vw,2.75rem)] font-bold leading-[1.1] tracking-tight">Tabela de valores</h1>
      <p class="mt-4 max-w-xl leading-relaxed text-muted">Valores de parceiro para a sua agência revender com a própria marca. O valor final de cada projeto é confirmado depois do briefing.</p>

      <section aria-labelledby="t-valores" class="mt-10">
        <h2 id="t-valores" class="sr-only">Valores por tipo de projeto</h2>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted">
          <span class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-brand" aria-hidden="true"></span>Valor parceiro (o que você me paga)</span>
          <span class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-fg/[.14]" aria-hidden="true"></span>Venda sugerida (+80%)</span>
        </div>
        <ul class="mt-5 grid gap-5 sm:gap-4">
          {VALORES.map((v, i) => (
            <li data-anima style={`--l:${i * 0.12}s`} class="grid gap-2 sm:grid-cols-[15rem_1fr] sm:items-center sm:gap-6">
              <span class="font-medium">{v.projeto}</span>
              {v.de === null || v.ate === null ? (
                <span class="flex min-h-12 items-center rounded-xl border border-dashed border-brand/50 px-4 font-mono text-sm font-medium text-hl">Sob consulta</span>
              ) : (
                <span class="grid min-h-12 grid-cols-[minmax(0,3fr)_minmax(0,2fr)] overflow-hidden rounded-xl font-mono text-[12px] leading-snug sm:text-sm">
                  <span class="carrega brilho relative flex items-center overflow-hidden bg-brand px-3 py-2 font-medium text-white sm:px-4" style="--d:var(--l); --dur:.8s">
                    <span><span class="sr-only">Valor parceiro: </span><span class="whitespace-nowrap">{reais(v.de)} a</span> <span class="whitespace-nowrap">{reais(v.ate)}</span></span>
                  </span>
                  <span class="carrega flex items-center justify-end bg-fg/[.09] px-3 py-2 text-right [text-wrap:balance] text-fg/75 sm:px-4" style="--d:calc(var(--l) + .7s); --dur:.6s">
                    <span><span class="sr-only">Venda sugerida: </span><span class="whitespace-nowrap">{reais(sugerido(v.de))} a</span> <span class="whitespace-nowrap">{reais(sugerido(v.ate))}</span></span>
                  </span>
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="t-incluso" class="mt-12">
        <h2 id="t-incluso" class="text-xl font-semibold">Incluso em todos os projetos</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {INCLUSO.map((item) => (
            <li class="flex items-start gap-3 text-fg/80">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-hl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="t-obs" class="mt-12">
        <h2 id="t-obs" class="text-xl font-semibold">Observações</h2>
        <ul class="mt-5 grid gap-3 text-[15px] leading-relaxed text-muted">
          {OBSERVACOES.map((o) => (
            <li class="flex gap-3"><span class="mt-[.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span><span>{o}</span></li>
          ))}
        </ul>
      </section>
    </div>
    </div>

    <!-- Parte escura: projetos, contato e rodapé -->
    <div class="mx-auto max-w-4xl px-5 pb-12 pt-16 md:pt-20">
      <section aria-labelledby="t-cases">
        <h2 id="t-cases" class="text-xl font-semibold">Projetos entregues</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-3">
          {cases.map((c) => (
            <li>
              <a href={url(`white-label/projetos/${c.id}/`)} class="block h-full rounded-2xl border border-white/10 bg-graphite p-4 transition hover:-translate-y-0.5 hover:border-brand-light">
                <span class="block font-semibold">{c.data.card.titulo ?? c.data.titulo}</span>
                <span class="mt-1 block text-sm text-white/60">{c.data.tipo}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <div class="mt-14 rounded-2xl border border-brand/40 bg-brand/10 p-6 md:p-8">
        <p class="text-xl font-semibold">Tem um projeto para orçar?</p>
        <p class="mt-2 text-white/70">Me chame no WhatsApp com o briefing e eu retorno com prazo e valor.</p>
        <a href={linkWhatsApp(MENSAGENS.orcamento)} target="_blank" rel="noopener" class="mt-6 inline-flex rounded-full bg-brand px-6 py-3.5 text-sm font-semibold transition hover:bg-brand-dark">Pedir orçamento no WhatsApp</a>
      </div>

      <footer class="mt-14 flex flex-wrap items-center justify-between gap-4 text-xs text-white/60">
        <Redes whatsapp class="flex flex-wrap gap-2 [&_a]:grid [&_a]:h-10 [&_a]:w-10 [&_a]:place-items-center [&_a]:rounded-full [&_a]:border [&_a]:border-white/15 [&_svg]:h-[18px] [&_svg]:w-[18px]" />
        <p>© {new Date().getFullYear()} Jonathan Menino</p>
      </footer>
    </div>
  </main>
  <Anima />
</Base>
