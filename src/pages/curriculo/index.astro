---
/* CURRÍCULO: página do site e fonte do PDF.
   O PDF (public/curriculo/jonathan-menino-curriculo.pdf) é gerado a partir desta página impressa em A4.
   Texto de verdade, uma coluna e títulos comuns: leitura fácil para recrutadores, sistemas de vagas (ATS) e IA.
   Para atualizar: edite os dados abaixo e gere o PDF de novo (veja o README). */
import Base from '../../layouts/Base.astro';
import Topo from '../../components/site/Topo.astro';
import Rodape from '../../components/site/Rodape.astro';
import { SITE, url } from '../../data/site';
import { idioma, tradutor, pagina } from '../../i18n';

// Versão em inglês em /en/curriculo/ (mesma página, textos da segunda coluna de cada T()).
// O PDF em inglês é public/curriculo/jonathan-menino-resume.pdf, gerado do mesmo jeito.
const L = idioma(Astro.url);
const T = tradutor(L);

const CONTATO = {
  cidade: T('Limeira, SP', 'Limeira, SP, Brazil'),
  telefone: '+55 (19) 99436-6334',
  email: 'jmeninodesign@gmail.com',
  portfolio: new URL(pagina(L, 'portfolio/'), 'https://jonathanmenino.github.io').href,
  linkedin: SITE.redes.linkedin,
  behance: SITE.redes.behance,
  github: SITE.redes.github,
};
const curto = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const CARGOS = T(['Designer Gráfico', 'UI Designer', 'Editor de Vídeo', 'Criação de Sites'], ['Graphic Designer', 'UI Designer', 'Video Editor', 'Web Design']);

const RESUMO = T(
  'Designer gráfico com mais de 13 anos de experiência em agências e empresas B2B e B2C. Crio identidades visuais e campanhas para redes sociais, mídia paga, impressos e PDV, edito vídeos e motion para Reels e anúncios, e desenho e desenvolvo sites e interfaces, do Figma ao código. Uso fluxos de IA generativa no dia a dia para produzir imagens e vídeos com mais agilidade, sem perder o cuidado com a marca. Hoje sou designer gráfico sênior na Agência Zava.',
  'Graphic designer with over 13 years of experience at agencies and B2B and B2C companies. I create visual identities and campaigns for social media, paid media, print and point of sale, edit videos and motion for Reels and ads, and design and build websites and interfaces, from Figma to code. I use generative AI workflows every day to produce images and videos faster without losing care for the brand. I currently work as a senior graphic designer at Agência Zava.',
);

const EXPERIENCIA_PT = [
  {
    empresa: 'Agência Zava',
    cargo: 'Designer Gráfico Sênior',
    periodo: 'jun 2025 – atual',
    sobre: 'agência de marketing digital',
    itens: [
      'Identidade visual e direção de arte de campanhas para marcas de alimentação e varejo.',
      'Peças para redes sociais, anúncios, impressos e pontos de venda.',
      'Edição de vídeo e motion design para Reels, anúncios e telão de LED.',
      'Fluxos de IA generativa para criar cenários, objetos e assets dos vídeos.',
    ],
  },
  {
    empresa: 'Acade',
    cargo: 'Designer Gráfico Pleno',
    periodo: 'mar 2023 – fev 2025',
    sobre: 'educação para o mercado fitness',
    itens: [
      'Criativos para campanhas de marketing digital e redes sociais.',
      'Materiais offline: anúncios impressos e peças para PDV.',
      'Identidade visual e apresentações para eventos e treinamentos.',
    ],
  },
  {
    empresa: 'DISEMP',
    cargo: 'Designer Gráfico Pleno',
    periodo: 'nov 2021 – jan 2023',
    sobre: 'marketing automotivo, Grupo DISEMP',
    itens: [
      'Peças digitais e impressas para concessionárias e campanhas automotivas.',
      'Motion design e edição de vídeos para campanhas digitais.',
    ],
  },
  {
    empresa: 'BluePex',
    cargo: 'Analista de Marketing',
    periodo: 'set 2019 – mai 2021',
    sobre: 'segurança cibernética B2B',
    itens: [
      'Peças para campanhas digitais e impressas.',
      'Criação de landing pages e automação do funil de vendas.',
      'Gestão das plataformas de marketing e do CRM, e vídeos para treinamentos internos.',
    ],
  },
];

const EXPERIENCIA_EN: typeof EXPERIENCIA_PT = [
  {
    empresa: 'Agência Zava',
    cargo: 'Senior Graphic Designer',
    periodo: 'Jun 2025 – present',
    sobre: 'digital marketing agency',
    itens: [
      'Visual identity and art direction for campaigns for food and retail brands.',
      'Pieces for social media, ads, print and points of sale.',
      'Video editing and motion design for Reels, ads and LED screens.',
      'Generative AI workflows to create sets, props and assets for videos.',
    ],
  },
  {
    empresa: 'Acade',
    cargo: 'Mid-level Graphic Designer',
    periodo: 'Mar 2023 – Feb 2025',
    sobre: 'education for the fitness market',
    itens: [
      'Creatives for digital marketing and social media campaigns.',
      'Offline materials: print ads and point-of-sale pieces.',
      'Visual identity and presentations for events and training sessions.',
    ],
  },
  {
    empresa: 'DISEMP',
    cargo: 'Mid-level Graphic Designer',
    periodo: 'Nov 2021 – Jan 2023',
    sobre: 'automotive marketing, DISEMP Group',
    itens: [
      'Digital and print pieces for car dealerships and automotive campaigns.',
      'Motion design and video editing for digital campaigns.',
    ],
  },
  {
    empresa: 'BluePex',
    cargo: 'Marketing Analyst',
    periodo: 'Sep 2019 – May 2021',
    sobre: 'B2B cybersecurity',
    itens: [
      'Pieces for digital and print campaigns.',
      'Landing pages and sales funnel automation.',
      'Management of marketing platforms and CRM, and videos for internal training.',
    ],
  },
];
const EXPERIENCIA = T(EXPERIENCIA_PT, EXPERIENCIA_EN);

// Experiências mais antigas: uma linha cada, sem tópicos.
const ANTERIORES = T([
  { cargo: 'Designer Gráfico (estágio)', empresa: 'Apice do Brasil', periodo: 'dez 2017 – ago 2018', texto: 'Agência de publicidade: layouts de sites, e-mail marketing, embalagens e edição de vídeo.' },
  { cargo: 'Arte-finalista', empresa: 'MSix Gráfica Rápida', periodo: 'ago 2016 – dez 2017', texto: 'Layouts para impressão digital e offset.' },
  { cargo: 'Arte-finalista', empresa: 'Gráfica Mais Cores', periodo: 'ago 2013 – dez 2015', texto: 'Embalagens para semijoias e fechamento de arquivos para offset.' },
], [
  { cargo: 'Graphic Design Intern', empresa: 'Apice do Brasil', periodo: 'Dec 2017 – Aug 2018', texto: 'Advertising agency: website layouts, email marketing, packaging and video editing.' },
  { cargo: 'Prepress Artist', empresa: 'MSix Gráfica Rápida', periodo: 'Aug 2016 – Dec 2017', texto: 'Layouts for digital and offset printing.' },
  { cargo: 'Prepress Artist', empresa: 'Gráfica Mais Cores', periodo: 'Aug 2013 – Dec 2015', texto: 'Packaging for fashion jewelry and print-ready files for offset.' },
]);

const PROJETOS = T([
  { nome: 'Escalados Macarrone', contexto: 'Agência Zava', texto: 'Campanha da Copa 2026: identidade, posts, stories, vídeos, landing page e PDV.', link: 'portfolio/escalados-macarrone/' },
  { nome: 'Costelinha BBQ · Macarrone in Box', contexto: 'Agência Zava', texto: 'Vídeos com chroma key, telão de LED e peças.', link: 'portfolio/macarrone-costelinha-bbq/' },
  { nome: 'Os Doces da Fer · Páscoa 2026', contexto: 'Agência Zava', texto: 'Edição dos vídeos com cenários e objetos gerados por IA, e peças.', link: 'portfolio/doces-da-fer-pascoa/' },
  { nome: 'É o BR no Kombina · Kombina Burgers House', contexto: 'Agência Zava', texto: 'Campanha de lançamento de três burgers: identidade, peças e edição dos vídeos.', link: 'portfolio/br-no-kombina/' },
  { nome: 'Método Dias Food · Patrik Dias', contexto: 'Agência Zava', texto: 'Landing page de vendas de curso: design e desenvolvimento.', link: 'portfolio/metodo-dias-food/' },
  { nome: 'menin0 lo-fi', contexto: 'Projeto pessoal', texto: 'Identidade, UI no Figma e site desenvolvido em HTML e CSS.', link: 'portfolio/menin0-lofi/' },
  { nome: 'Sites White Label para agências', contexto: 'Freelance', texto: 'Sites e landing pages: Agência Zava, Jardim Sul Residencial e Sentinela.', link: 'white-label/' },
], [
  { nome: 'Escalados Macarrone', contexto: 'Agência Zava', texto: '2026 World Cup campaign: identity, posts, stories, videos, landing page and POS.', link: 'portfolio/escalados-macarrone/' },
  { nome: 'Costelinha BBQ · Macarrone in Box', contexto: 'Agência Zava', texto: 'Videos with chroma key, LED screen and pieces.', link: 'portfolio/macarrone-costelinha-bbq/' },
  { nome: 'Os Doces da Fer · Easter 2026', contexto: 'Agência Zava', texto: 'Video editing with AI-generated sets and props, plus pieces.', link: 'portfolio/doces-da-fer-pascoa/' },
  { nome: 'É o BR no Kombina · Kombina Burgers House', contexto: 'Agência Zava', texto: 'Launch campaign for three burgers: identity, pieces and video editing.', link: 'portfolio/br-no-kombina/' },
  { nome: 'Método Dias Food · Patrik Dias', contexto: 'Agência Zava', texto: 'Sales landing page for a course: design and development.', link: 'portfolio/metodo-dias-food/' },
  { nome: 'menin0 lo-fi', contexto: 'Personal project', texto: 'Identity, UI in Figma and website built in HTML and CSS.', link: 'portfolio/menin0-lofi/' },
  { nome: 'White Label websites for agencies', contexto: 'Freelance', texto: 'Websites and landing pages: Agência Zava, Jardim Sul Residencial and Sentinela.', link: 'white-label/' },
]);

const COMPETENCIAS = T([
  { area: 'Design gráfico', itens: 'Identidade visual, direção de arte, social media, anúncios, impressos, PDV, apresentações' },
  { area: 'Vídeo e motion', itens: 'Edição de vídeo, motion design, Reels, anúncios em vídeo, chroma key, telão de LED' },
  { area: 'UI e sites', itens: 'UI design, landing pages, sites institucionais, design responsivo, HTML, CSS, JavaScript' },
  { area: 'IA generativa', itens: 'Fluxos de IA para imagem e vídeo, geração de cenários e objetos, IA na criação e no código' },
  { area: 'Ferramentas', itens: 'Photoshop, Illustrator, InDesign, Premiere Pro, Figma' },
], [
  { area: 'Graphic design', itens: 'Visual identity, art direction, social media, ads, print, point of sale, presentations' },
  { area: 'Video and motion', itens: 'Video editing, motion design, Reels, video ads, chroma key, LED screens' },
  { area: 'UI and web', itens: 'UI design, landing pages, corporate websites, responsive design, HTML, CSS, JavaScript' },
  { area: 'Generative AI', itens: 'AI workflows for image and video, generating sets and props, AI in design and code' },
  { area: 'Tools', itens: 'Photoshop, Illustrator, InDesign, Premiere Pro, Figma' },
]);

const CURSOS = T([
  { nome: 'UI Design Avançado', escola: 'Origamid' },
  { nome: 'JavaScript', escola: 'Origamid' },
  { nome: 'HTML e CSS', escola: 'Coderhouse' },
], [
  { nome: 'Advanced UI Design', escola: 'Origamid' },
  { nome: 'JavaScript', escola: 'Origamid' },
  { nome: 'HTML and CSS', escola: 'Coderhouse' },
]);

const PDF = url(T('curriculo/jonathan-menino-curriculo.pdf', 'curriculo/jonathan-menino-resume.pdf'));

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.nome,
  jobTitle: T('Designer Gráfico', 'Graphic Designer'),
  email: `mailto:${CONTATO.email}`,
  telephone: '+5519994366334',
  address: { '@type': 'PostalAddress', addressLocality: 'Limeira', addressRegion: 'SP', addressCountry: 'BR' },
  worksFor: { '@type': 'Organization', name: 'Agência Zava' },
  knowsLanguage: ['pt-BR', 'en'],
  url: new URL(pagina(L, 'curriculo/'), Astro.site).href,
  sameAs: Object.values(SITE.redes).filter(Boolean),
};
---
<Base
  title={T('Currículo · Jonathan Menino, Designer Gráfico', 'Résumé · Jonathan Menino, Graphic Designer')}
  description={T('Currículo de Jonathan Menino: designer gráfico, UI designer e editor de vídeo em Limeira/SP, com mais de 13 anos de experiência em identidade visual, campanhas, motion, sites e fluxos de IA.', 'Résumé of Jonathan Menino: graphic designer, UI designer and video editor based in Limeira, Brazil, with over 13 years of experience in visual identity, campaigns, motion, websites and AI workflows.')}
  jsonld={jsonld}
>
<Topo tom="escuro" cta={{ texto: T('Baixar PDF', 'Download PDF'), curto: 'PDF', href: PDF, download: true }} />

<main class="folha">
  <header class="topo">
    <h1>Jonathan Menino</h1>
    <p class="cargos">{CARGOS.join(' · ')}</p>
    <ul class="contato">
      <li>{CONTATO.cidade}</li>
      <li><a href={`https://wa.me/${SITE.whatsapp}`}>{CONTATO.telefone}</a></li>
      <li><a href={`mailto:${CONTATO.email}`}>{CONTATO.email}</a></li>
      <li><strong>{T('Portfólio:', 'Portfolio:')}</strong> <a href={CONTATO.portfolio}>{curto(CONTATO.portfolio)}</a></li>
      <li><a href={CONTATO.linkedin}>{curto(CONTATO.linkedin)}</a></li>
      <li><a href={CONTATO.behance}>{curto(CONTATO.behance)}</a></li>
      <li><a href={CONTATO.github}>{curto(CONTATO.github)}</a></li>
    </ul>
  </header>

  <section>
    <h2>{T('Resumo', 'Summary')}</h2>
    <p class="resumo">{RESUMO}</p>
  </section>

  <section>
    <h2>{T('Experiência profissional', 'Work experience')}</h2>
    {EXPERIENCIA.map((e) => (
      <article class="exp">
        <div class="exp-topo">
          <h3>{e.cargo} <span class="em">· {e.empresa}</span> <span class="sobre">({e.sobre})</span></h3>
          <p class="periodo">{e.periodo}</p>
        </div>
        <ul class="itens">{e.itens.map((i) => <li>{i}</li>)}</ul>
      </article>
    ))}
    <h3 class="ant-titulo">{T('Experiências anteriores', 'Earlier experience')}</h3>
    <ul class="anteriores">
      {ANTERIORES.map((a) => (
        <li><strong>{a.cargo}</strong> · {a.empresa} <span class="periodo">({a.periodo})</span>. {a.texto}</li>
      ))}
    </ul>
  </section>

  <section>
    <h2>{T('Projetos em destaque', 'Featured projects')}</h2>
    <ul class="projetos">
      {PROJETOS.map((p) => (
        <li>
          <a href={new URL(pagina(L, p.link), Astro.site).href}><strong>{p.nome}</strong></a>
          <span class="contexto"> · {p.contexto}.</span> {p.texto}
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>{T('Competências', 'Skills')}</h2>
    <dl class="comp">
      {COMPETENCIAS.map((c) => (<div><dt>{c.area}</dt><dd>{c.itens}</dd></div>))}
    </dl>
  </section>

  <div class="duas">
    <section>
      <h2>{T('Formação', 'Education')}</h2>
      <p><strong>{T('Bacharelado em Design Gráfico', 'Bachelor’s in Graphic Design')}</strong></p>
      <p>FAAL · 2017 – 2021 <span class="periodo">{T('(incompleto)', '(not completed)')}</span></p>
    </section>
    <section>
      <h2>{T('Cursos', 'Courses')}</h2>
      <ul class="lista">{CURSOS.map((c) => <li><strong>{c.nome}</strong> · {c.escola}</li>)}</ul>
    </section>
    <section>
      <h2>{T('Idiomas', 'Languages')}</h2>
      <ul class="lista">
        <li><strong>{T('Português', 'Portuguese')}</strong> · {T('nativo', 'native')}</li>
        <li><strong>{T('Inglês', 'English')}</strong> · {T('intermediário', 'intermediate')} (<a href="https://cert.efset.org/qKgw2L">{T('certificado EF SET', 'EF SET certificate')}</a>)</li>
      </ul>

    </section>
  </div>
</main>
<Rodape />
</Base>

<style is:global>
/* Folha branca sobre o fundo carvão do site. Na impressão (e no PDF), só a folha em A4. */
:root { --roxo: #6E44FF; --roxo-esc: #5A30EE; --carvao: #0B0A0D; --tinta: #16141A; --cinza: #5E5A66; --linha: #E4E1EA; }
* { box-sizing: border-box; margin: 0; }
html { -webkit-text-size-adjust: 100%; }
::selection { background: var(--roxo); color: #fff; }
body { background: var(--carvao); color: var(--tinta); font-family: "Inter Variable", Inter, ui-sans-serif, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
a { color: inherit; }
:focus-visible { outline: 2px solid #9B7BFF; outline-offset: 3px; border-radius: 4px; }


.folha { max-width: 860px; margin: 32px auto 56px; background: #fff; padding: 56px 64px; border-radius: 6px; font-size: 14px; line-height: 1.55; }
@media (max-width: 640px) { .folha { padding: 32px 20px; border-radius: 0; margin: 0; } }

.topo { border-bottom: 3px solid var(--roxo); padding-bottom: 18px; }
h1 { font-size: 34px; font-weight: 750; letter-spacing: -.02em; line-height: 1.1; }
.cargos { margin-top: 6px; font-size: 15px; font-weight: 600; color: var(--roxo-esc); }
.contato { list-style: none; padding: 0; margin-top: 12px; display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 13px; color: var(--cinza); }
.contato a { text-decoration: none; color: var(--tinta); }
.contato a:hover, .projetos a:hover, .lista a:hover { color: var(--roxo-esc); text-decoration: underline; }
.contato strong { color: var(--tinta); font-weight: 600; }

section { margin-top: 22px; }
h2 { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 12px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--roxo-esc); padding-bottom: 6px; border-bottom: 1px solid var(--linha); margin-bottom: 10px; }
.resumo { color: var(--tinta); }

.exp { margin-top: 14px; break-inside: avoid; }
.exp:first-of-type { margin-top: 0; }
.exp-topo { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 16px; align-items: baseline; }
h3 { font-size: 15px; font-weight: 650; }
h3 .em { font-weight: 500; color: var(--cinza); }
.periodo { font-size: 12.5px; color: var(--cinza); font-variant-numeric: tabular-nums; }
.sobre { font-size: 13px; font-weight: 400; color: var(--cinza); }
.itens { margin-top: 4px; padding-left: 18px; list-style: disc; }
.itens li { margin-top: 2px; }
.itens li::marker { color: var(--roxo); }

.ant-titulo { margin-top: 14px; font-size: 13px; font-weight: 650; color: var(--cinza); text-transform: uppercase; letter-spacing: .06em; }
.anteriores { list-style: none; padding: 0; margin-top: 4px; display: grid; gap: 3px; }
.projetos { list-style: none; padding: 0; display: grid; gap: 6px; }
.projetos a { text-decoration: none; color: var(--tinta); }
.contexto { color: var(--cinza); }

.comp { display: grid; gap: 5px; }
.comp div { display: grid; grid-template-columns: 130px 1fr; gap: 12px; }
.comp dt { font-weight: 650; }
@media (max-width: 640px) { .comp div { grid-template-columns: 1fr; gap: 0; } }

.duas { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0 28px; }
@media (max-width: 640px) { .duas { grid-template-columns: 1fr; } }
.lista { list-style: none; padding: 0; display: grid; gap: 3px; }
.lista a { color: var(--roxo-esc); }

.cursor-circulo, .cursor-anel { display: none !important; }

/* Impressão e PDF: A4, sem barra, folha ocupando a página. */
@page { size: A4; margin: 10mm 13mm; }
@media print {
  body { background: #fff; }
  .no-print { display: none !important; }
  .folha { max-width: none; margin: 0; padding: 0; border-radius: 0; font-size: 9.1pt; line-height: 1.38; }
  h1 { font-size: 22pt; }
  .cargos { font-size: 10.5pt; }
  .contato { font-size: 8.8pt; margin-top: 8px; }
  .topo { padding-bottom: 12px; }
  section { margin-top: 11px; }
  h2 { font-size: 8.5pt; margin-bottom: 7px; padding-bottom: 4px; }
  h3 { font-size: 10.2pt; }
  .periodo, .sobre { font-size: 8.8pt; }
  .exp { margin-top: 7px; }
  .ant-titulo { font-size: 8.4pt; margin-top: 9px; }
  .anteriores { gap: 1px; }
  .projetos { gap: 3px; }
  .comp { gap: 3px; }
  .itens li { margin-top: 0; }
  .itens { margin-top: 2px; }
  .comp div { grid-template-columns: 105px 1fr; }
  .duas { grid-template-columns: 1fr 1.1fr 1fr; }
  a { text-decoration: none !important; }
}
</style>
