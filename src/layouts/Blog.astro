---
/* Moldura das páginas do blog: topo e rodapé do site (src/components/site/) e estilos de leitura (src/styles/blog.css).
   Visual claro, igual à página White Label. Blog só em português. */
import Base from './Base.astro';
import Topo from '../components/site/Topo.astro';
import Rodape from '../components/site/Rodape.astro';
import { url, linkWhatsApp } from '../data/site';
import '../styles/blog.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  tipo?: 'website' | 'article';
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
}
const props = Astro.props;
const whats = linkWhatsApp('Olá, Jonathan! Li um artigo do seu blog e quero conversar.');
---
<Base {...props} themeColor="#F7F6F3" soPortugues>
  <link slot="head" rel="alternate" type="application/rss+xml" title="Blog · Jonathan Menino" href={url('blog/rss.xml')} />

  <a class="pular" href="#conteudo">Pular para o conteúdo</a>
  <Topo tom="claro" cta={{ texto: 'Falar no WhatsApp', curto: 'WhatsApp', href: whats }} />

  <main id="conteudo">
    <slot />
  </main>

  <Rodape />
</Base>
