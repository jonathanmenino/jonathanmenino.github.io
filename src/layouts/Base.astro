---
/* Estrutura comum de todas as páginas: <head> com SEO e compartilhamento.
   title/description: o que aparece no Google.
   image: imagem de compartilhamento (1200x630), caminho dentro de /public, sem barra inicial.
   jsonld: dados estruturados opcionais (objeto). */
import CursorCirculo from '../components/CursorCirculo.astro';
import { SITE, url } from '../data/site';
// Fontes servidas pelo próprio site (sem depender do Google Fonts): carregam mais rápido.
import '@fontsource-variable/inter/index.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/tema.css';
import interWoff from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoWoff400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import monoWoff500 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-500-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  tipo?: 'website' | 'article';
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  themeColor?: string;
}
const {
  title,
  description,
  image = 'og/home.jpg',
  tipo = 'website',
  jsonld,
  themeColor = '#0B0A0D',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagem = new URL(url(image), Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeColor} />
    <!-- Tema: aplica a escolha salva antes de desenhar a página (evita piscar) e expõe window.alternarTema. -->
    <script is:inline>
      (function () {
        var raiz = document.documentElement,
          mq = matchMedia('(prefers-color-scheme: dark)');
        // "js" libera as animações que esperam o elemento aparecer na tela (src/components/Anima.astro).
        raiz.classList.add('js');
        var claro = document.querySelector('meta[name="theme-color"]').content;
        function salvo() {
          try {
            return localStorage.getItem('tema');
          } catch (e) {
            return null;
          }
        }
        function escuro() {
          var t = raiz.getAttribute('data-theme');
          return t ? t === 'dark' : mq.matches;
        }
        function corBarra() {
          if (claro === '#F7F6F3')
            document.querySelector('meta[name="theme-color"]').content =
              escuro() ? '#141217' : claro;
        }
        var t = salvo();
        if (t === 'light' || t === 'dark') raiz.setAttribute('data-theme', t);
        corBarra();
        mq.addEventListener('change', corBarra);
        window.alternarTema = function () {
          var novo = escuro() ? 'light' : 'dark';
          // Se a escolha bate com o sistema, volta a seguir o sistema.
          var sistema = mq.matches ? 'dark' : 'light';
          try {
            novo === sistema
              ? localStorage.removeItem('tema')
              : localStorage.setItem('tema', novo);
          } catch (e) {}
          raiz.setAttribute('data-theme', novo);
          corBarra();
        };
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="preload"
      href={interWoff}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href={monoWoff400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoWoff500} as="font" type="font/woff2" crossorigin />
    {
      jsonld && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
      )
    }
    <slot name="head" />
    <!-- Microsoft Clarity atrasado: carrega na primeira interação (rolagem, clique, tecla, mouse)
         ou 5s depois do load. Assim ele não pesa na abertura da página nem no PageSpeed. -->
    <script is:inline>
      (function (w, d) {
        w.clarity =
          w.clarity ||
          function () {
            (w.clarity.q = w.clarity.q || []).push(arguments);
          };
        var feito = false;
        var eventos = ['scroll', 'pointerdown', 'keydown', 'touchstart', 'mousemove'];
        function carregar() {
          if (feito) return;
          feito = true;
          eventos.forEach(function (e) {
            w.removeEventListener(e, carregar);
          });
          var t = d.createElement('script');
          t.async = true;
          t.src = 'https://www.clarity.ms/tag/r84srt439a';
          d.head.appendChild(t);
        }
        eventos.forEach(function (e) {
          w.addEventListener(e, carregar, { passive: true });
        });
        w.addEventListener('load', function () {
          setTimeout(carregar, 5000);
        });
      })(window, document);
    </script>
  </head>
  <body>
    <slot />
    <CursorCirculo />
  </body>
</html>
