---
/* Estrutura comum de todas as páginas: <head> com SEO e compartilhamento.
   title/description: o que aparece no Google.
   image: imagem de compartilhamento (1200x630), caminho dentro de /public, sem barra inicial.
   jsonld: dados estruturados opcionais (objeto).
   soPortugues: página sem versão em inglês (ex.: blog). Não manda o visitante para /en/ nem anuncia hreflang. */
import CursorCirculo from '../components/CursorCirculo.astro';
import { SITE, url } from '../data/site';
import { idioma, versoes } from '../i18n';
// Fontes servidas pelo próprio site (sem depender do Google Fonts): carregam mais rápido.
import '@fontsource-variable/inter/index.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/tema.css';
import interWoff from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoWoff400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import monoWoff500 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-500-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  tipo?: 'website' | 'article';
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  themeColor?: string;
  soPortugues?: boolean;
}
const {
  title,
  description,
  image = 'og/home.jpg',
  tipo = 'website',
  jsonld,
  themeColor = '#0B0A0D',
  soPortugues = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Idioma pelo endereço (/en/ = inglês) e a mesma página no outro idioma, para o Google.
const L = idioma(Astro.url);
const alt = versoes(Astro.url.pathname);
const is404 = Astro.url.pathname.includes('404');
const semAlternativas = is404 || soPortugues;
const imagem = new URL(url(image), Astro.site);
---

<!doctype html>
<html lang={L === 'en' ? 'en' : 'pt-BR'}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!semAlternativas && <link rel="alternate" hreflang="pt-BR" href={new URL(alt.pt, Astro.site)} />}
    {!semAlternativas && <link rel="alternate" hreflang="en" href={new URL(alt.en, Astro.site)} />}
    {!semAlternativas && <link rel="alternate" hreflang="x-default" href={new URL(alt.pt, Astro.site)} />}
    <meta name="theme-color" content={themeColor} />
    <!-- Idioma: na primeira visita segue a língua do navegador (português fica na raiz, o resto vai para /en/).
         Depois que a pessoa toca na bandeirinha, vale a escolha dela (guardada no aparelho).
         Robôs de busca e o PageSpeed não são redirecionados: cada versão tem o seu endereço. -->
    <script is:inline define:vars={{ base: import.meta.env.BASE_URL.replace(/\/$/, ''), soPortugues }}>
      (function () {
        if (soPortugues) return;
        var p = location.pathname.slice(base.length) || '/';
        var naEn = p === '/en' || p.indexOf('/en/') === 0;
        var salvo = null;
        try { salvo = localStorage.getItem('idioma'); } catch (e) {}
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('[data-idioma]');
          if (a) try { localStorage.setItem('idioma', a.getAttribute('data-idioma')); } catch (e) {}
        });
        var quer = salvo;
        if (quer !== 'pt' && quer !== 'en') {
          if (/bot|crawl|spider|slurp|lighthouse|pagespeed|headless|preview|facebookexternalhit|whatsapp|telegram/i.test(navigator.userAgent)) return;
          var l = (navigator.languages && navigator.languages[0]) || navigator.language || 'pt';
          // Sem escolha salva, só sai do português; um link /en/ aberto de propósito fica em inglês.
          if (naEn || /^pt/i.test(l)) return;
          quer = 'en';
        }
        var alvo = null;
        if (quer === 'en' && !naEn) alvo = '/en' + p;
        if (quer === 'pt' && naEn) alvo = p.slice(3) || '/';
        if (alvo && !/404/.test(p)) location.replace(base + alvo + location.search + location.hash);
      })();
    </script>
    <!-- Tema: aplica a escolha salva antes de desenhar a página (evita piscar) e expõe window.alternarTema. -->
    <script is:inline>
      (function () {
        var raiz = document.documentElement,
          mq = matchMedia('(prefers-color-scheme: dark)');
        // "js" libera as animações que esperam o elemento aparecer na tela (src/components/Anima.astro).
        raiz.classList.add('js');
        var claro = document.querySelector('meta[name="theme-color"]').content;
        function salvo() {
          try {
            return localStorage.getItem('tema');
          } catch (e) {
            return null;
          }
        }
        function escuro() {
          var t = raiz.getAttribute('data-theme');
          return t ? t === 'dark' : mq.matches;
        }
        function corBarra() {
          if (claro === '#F7F6F3')
            document.querySelector('meta[name="theme-color"]').content =
              escuro() ? '#141217' : claro;
        }
        var t = salvo();
        if (t === 'light' || t === 'dark') raiz.setAttribute('data-theme', t);
        corBarra();
        mq.addEventListener('change', corBarra);
        window.alternarTema = function () {
          var novo = escuro() ? 'light' : 'dark';
          // Se a escolha bate com o sistema, volta a seguir o sistema.
          var sistema = mq.matches ? 'dark' : 'light';
          try {
            novo === sistema
              ? localStorage.removeItem('tema')
              : localStorage.setItem('tema', novo);
          } catch (e) {}
          raiz.setAttribute('data-theme', novo);
          corBarra();
        };
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content={L === 'en' ? 'en_US' : 'pt_BR'} />
    <meta property="og:locale:alternate" content={L === 'en' ? 'pt_BR' : 'en_US'} />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="preload"
      href={interWoff}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href={monoWoff400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoWoff500} as="font" type="font/woff2" crossorigin />
    {
      jsonld && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
      )
    }
    <slot name="head" />
    <!-- Microsoft Clarity atrasado: carrega na primeira interação (rolagem, clique, tecla, mouse)
         ou 5s depois do load. Assim ele não pesa na abertura da página nem no PageSpeed. -->
    <script is:inline>
      (function (w, d) {
        w.clarity =
          w.clarity ||
          function () {
            (w.clarity.q = w.clarity.q || []).push(arguments);
          };
        var feito = false;
        var eventos = ['scroll', 'pointerdown', 'keydown', 'touchstart', 'mousemove'];
        function carregar() {
          if (feito) return;
          feito = true;
          eventos.forEach(function (e) {
            w.removeEventListener(e, carregar);
          });
          var t = d.createElement('script');
          t.async = true;
          t.src = 'https://www.clarity.ms/tag/r84srt439a';
          d.head.appendChild(t);
        }
        eventos.forEach(function (e) {
          w.addEventListener(e, carregar, { passive: true });
        });
        w.addEventListener('load', function () {
          setTimeout(carregar, 5000);
        });
      })(window, document);
    </script>
  </head>
  <body>
    <slot />
    <CursorCirculo />
  </body>
</html>
